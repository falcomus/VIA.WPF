<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls;assembly=VIA.WPF.Controls"
    xmlns:ico="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.MaterialDesign"
    xmlns:localization="clr-namespace:VIA.WPF.Localization;assembly=VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:windowing="clr-namespace:VIA.WPF.Windowing">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Themes;component/Themes/XDefaultBrushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <QuadraticEase x:Key="XWindowEaseOut" EasingMode="EaseOut" />
    <BooleanToVisibilityConverter x:Key="XWindowBooleanToVisibilityConverter" />

    <Style x:Key="XWindowCaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=TitleBarForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CaptionButtonHoverBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CaptionButtonPressedBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XWindowCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=TitleBarForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CloseButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CloseButtonForegroundBrush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CloseButtonPressedBrush}" />
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type windowing:XWindow}}, Path=CloseButtonForegroundBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="XWindowThemeModeButtonStyle"
        BasedOn="{StaticResource XWindowCaptionButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style x:Key="XWindowResizeGripStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}">
                        <Border
                            Width="3"
                            Height="3"
                            Margin="0,0,1,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.BorderText}}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="3"
                            Margin="0,0,6,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.BorderText}}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="3"
                            Margin="0,0,11,11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.BorderText}}"
                            CornerRadius="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XWindowResizeThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type windowing:XWindow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=WindowForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource Self}, Path=WindowBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="TitleBarHeight" Value="38" />
        <Setter Property="TitleFontSize" Value="13" />
        <Setter Property="TitleBarPadding" Value="12,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="WindowBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Canvas}}" />
        <Setter Property="WindowForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="WindowBorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
        <Setter Property="TitleBarBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="TitleBarForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="CaptionButtonHoverBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
        <Setter Property="CaptionButtonPressedBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatePressed}}" />
        <Setter Property="CloseButtonHoverBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
        <Setter Property="CloseButtonPressedBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DangerDark}}" />
        <Setter Property="CloseButtonForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DangerText}}" />
        <Setter Property="BusyOverlayBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Scrim}}" />
        <Setter Property="ModalOverlayBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Scrim}}" />
        <Setter Property="CloseFlyoutsOnOverlayClick" Value="True" />
        <Setter Property="UseAnimations" Value="True" />
        <Setter Property="FlyoutAnimationDuration" Value="0:0:0.25" />
        <Setter Property="FlyoutAnimationOffset" Value="200" />
        <Setter Property="FlyoutUseFade" Value="True" />
        <Setter Property="ToastAnimationDuration" Value="0:0:0.18" />
        <Setter Property="ToastAnimationOffset" Value="18" />
        <Setter Property="ToastUseFade" Value="True" />
        <Setter Property="ToastPlacement" Value="TopRight" />
        <Setter Property="StartupAnimation" Value="Fade" />
        <Setter Property="StartupAnimationDuration" Value="0:0:0.18" />
        <Setter Property="StartupAnimationInitialScale" Value="0.97" />
        <Setter Property="CloseAnimation" Value="Fade" />
        <Setter Property="CloseAnimationDuration" Value="0:0:0.14" />
        <Setter Property="CloseAnimationTargetScale" Value="0.985" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type windowing:XWindow}">
                    <Border Background="Transparent" SnapsToDevicePixels="True">
                        <Grid>
                                <!--BorderBrush="{TemplateBinding BorderBrush}"-->
                                <!--BorderThickness="{TemplateBinding BorderThickness}"-->
                            <Border
                                x:Name="PART_WindowFrame"
                                BorderThickness="0"
                                Background="{TemplateBinding WindowBackgroundBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PART_WindowFrameScaleTransform" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>

                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition x:Name="StatusBarRow" Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <controls:XBorder
                                        BorderThickness="0 0.5 0 0"
                                        x:Name="PART_TitleBar"
                                        Grid.Row="0"
                                        Padding="{TemplateBinding TitleBarPadding}"
                                        Background="{TemplateBinding TitleBarBackgroundBrush}"
                                        CornerRadius="{TemplateBinding TopCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Orientation="Vertical">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{TemplateBinding TitleFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{TemplateBinding TitleBarForegroundBrush}"
                                                    Text="{TemplateBinding Title}" />
                                                <TextBlock
                                                    x:Name="PART_SubtitleText"
                                                    Margin="0,-1,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{TemplateBinding TitleBarForegroundBrush}"
                                                    Opacity="0.70"
                                                    Text="{TemplateBinding Subtitle}" />
                                            </StackPanel>

                                            <ContentPresenter
                                                Grid.Column="1"
                                                Margin="16,0,12,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding TitleBarContent}"
                                                ContentTemplate="{TemplateBinding TitleBarContentTemplate}"
                                                RecognizesAccessKey="True"
                                                TextElement.Foreground="{TemplateBinding TitleBarForegroundBrush}" />

                                            <StackPanel
                                                Margin="0,2,0,0"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <localization:XLanguageSelector
                                                    x:Name="PART_LanguageSelector"
                                                    Width="128"
                                                    Height="24"
                                                    MinWidth="110"
                                                    MinHeight="22"
                                                    Margin="0,0,8,0"
                                                    Padding="6,0,6,1.5"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Language"
                                                    ApplyFormattingCulture="{Binding ApplyLanguageFormattingCulture, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Focusable="False"
                                                    IsTabStop="False"
                                                    ItemsSource="{Binding AvailableLanguages, RelativeSource={RelativeSource TemplatedParent}}"
                                                    SelectedItem="{Binding SelectedLanguage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                    Visibility="Collapsed" />

                                                <themes:XThemeSelector
                                                    x:Name="PART_ThemeSelector"
                                                    Width="110"
                                                    Height="24"
                                                    MinWidth="100"
                                                    MinHeight="22"
                                                    Margin="0,0,8,0"
                                                    Padding="6,0,6,1.5"
                                                    VerticalAlignment="Center"
                                                    Focusable="False"
                                                    IsTabStop="False"
                                                    Visibility="Collapsed" />
                                            </StackPanel>

                                            <Button
                                                x:Name="PART_ThemeModeButton"
                                                Grid.Column="3"
                                                Command="{x:Static windowing:XWindowCommands.ToggleThemeMode}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource XWindowThemeModeButtonStyle}"
                                                ToolTip="Switch Light and Dark mode">
                                                <ico:PackIconMaterialDesign
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.ThemeModeForeground}}"
                                                    Kind="Lightbulb" />
                                            </Button>

                                            <Button
                                                x:Name="PART_MinimizeButton"
                                                Grid.Column="4"
                                                Command="{x:Static windowing:XWindowCommands.Minimize}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource XWindowCaptionButtonStyle}">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="M 1 7.5 L 11 7.5"
                                                    SnapsToDevicePixels="True"
                                                    Stretch="None"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.25" />
                                            </Button>

                                            <Button
                                                x:Name="PART_MaximizeRestoreButton"
                                                Grid.Column="5"
                                                Command="{x:Static windowing:XWindowCommands.MaximizeRestore}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource XWindowCaptionButtonStyle}">
                                                <Grid>
                                                    <Path
                                                        x:Name="PART_MaximizeIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Data="M 1.5 1.5 H 10.5 V 10.5 H 1.5 Z"
                                                        SnapsToDevicePixels="True"
                                                        Stretch="None"
                                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                        StrokeLineJoin="Round"
                                                        StrokeThickness="1.25" />
                                                    <Path
                                                        x:Name="PART_RestoreIcon"
                                                        Width="12"
                                                        Height="12"
                                                        Data="M 3.5 1.5 H 10.5 V 8.5 H 3.5 Z M 1.5 3.5 H 8.5 V 10.5 H 1.5 Z"
                                                        SnapsToDevicePixels="True"
                                                        Stretch="None"
                                                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                        StrokeLineJoin="Round"
                                                        StrokeThickness="1.25"
                                                        Visibility="Collapsed" />
                                                </Grid>
                                            </Button>

                                            <Button
                                                x:Name="PART_CloseButton"
                                                Grid.Column="6"
                                                Margin="0"
                                                Command="{x:Static windowing:XWindowCommands.Close}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource XWindowCloseButtonStyle}">
                                                <Path
                                                    Width="12"
                                                    Height="12"
                                                    Data="M 2 2 L 10 10 M 10 2 L 2 10"
                                                    SnapsToDevicePixels="True"
                                                    Stretch="None"
                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeLineJoin="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.25" />
                                            </Button>
                                        </Grid>
                                    </controls:XBorder>

                                    <controls:XBorder
                                        Grid.Row="1"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        Padding="0"
                                        Height="1"/>

                                    <Grid Grid.Row="2" Background="Transparent">

                                        <ContentPresenter
                                            Margin="{TemplateBinding Padding}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                                        <Grid
                                            x:Name="PART_FlyoutLayer"
                                            Panel.ZIndex="10"
                                            Background="Transparent"
                                            IsHitTestVisible="False">

                                            <Border
                                                x:Name="PART_FlyoutOverlay"
                                                Background="{themes:AppThemeBinding Light='#40101215',
                                                                                    Dark='#80010205'}"
                                                Opacity="0"
                                                Visibility="Collapsed" />

                                            <Border
                                                x:Name="PART_LeftFlyout"
                                                Width="{TemplateBinding LeftFlyoutWidth}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
                                                BorderThickness="0,0,1,0"
                                                Opacity="0"
                                                Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Direction="0"
                                                        Opacity="0.2"
                                                        ShadowDepth="3" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="PART_LeftFlyoutTransform" X="0" />
                                                </Border.RenderTransform>
                                                <ContentPresenter Content="{TemplateBinding LeftFlyoutContent}" />
                                            </Border>

                                            <Border
                                                x:Name="PART_RightFlyout"
                                                Width="{TemplateBinding RightFlyoutWidth}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
                                                BorderThickness="1,0,0,0"
                                                Opacity="0"
                                                Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Direction="180"
                                                        Opacity="0.2"
                                                        ShadowDepth="3" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="PART_RightFlyoutTransform" X="0" />
                                                </Border.RenderTransform>
                                                <ContentPresenter Content="{TemplateBinding RightFlyoutContent}" />
                                            </Border>

                                            <Border
                                                x:Name="PART_TopFlyout"
                                                Height="{TemplateBinding TopFlyoutHeight}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
                                                BorderThickness="0,0,0,1"
                                                Opacity="0"
                                                Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Direction="270"
                                                        Opacity="0.2"
                                                        ShadowDepth="3" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="PART_TopFlyoutTransform" Y="0" />
                                                </Border.RenderTransform>
                                                <ContentPresenter Content="{TemplateBinding TopFlyoutContent}" />
                                            </Border>

                                            <Border
                                                x:Name="PART_BottomFlyout"
                                                Height="{TemplateBinding BottomFlyoutHeight}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
                                                BorderThickness="0,1,0,0"
                                                Opacity="0"
                                                Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="15"
                                                        Direction="90"
                                                        Opacity="0.2"
                                                        ShadowDepth="3" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="PART_BottomFlyoutTransform" Y="0" />
                                                </Border.RenderTransform>
                                                <ContentPresenter Content="{TemplateBinding BottomFlyoutContent}" />
                                            </Border>
                                        </Grid>

                                        <Border
                                            x:Name="PART_BusyOverlay"
                                            Panel.ZIndex="20"
                                            Background="{TemplateBinding BusyOverlayBrush}"
                                            Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="30"
                                                    Direction="270"
                                                    Opacity="0.5"
                                                    ShadowDepth="3" />
                                            </Border.Effect>
                                            <Grid>
                                                <Border
                                                    Width="280"
                                                    Margin="180,0,0,0"
                                                    Padding="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                                    BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDark}}"
                                                    BorderThickness="2"
                                                    CornerRadius="8">
                                                    <StackPanel>
                                                        <ProgressBar
                                                            Height="4"
                                                            Margin="0,0,0,14"
                                                            IsIndeterminate="True" />
                                                        <ContentPresenter
                                                            HorizontalAlignment="Center"
                                                            Content="{TemplateBinding BusyContent}"
                                                            ContentTemplate="{TemplateBinding BusyContentTemplate}"
                                                            TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>


                                        <Grid
                                            x:Name="PART_EditorOverlayLayer"
                                            Panel.ZIndex="28"
                                            Background="Transparent"
                                            Validation.ErrorTemplate="{x:Null}"
                                            Visibility="{Binding IsEditorOverlayOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}">
                                            <Border
                                                x:Name="PART_EditorOverlayOverlay"
                                                Background="{Binding EditorOverlayMessage.OverlayBackground, RelativeSource={RelativeSource TemplatedParent}}"
                                                CornerRadius="{Binding EditorOverlayMessage.OverlayCornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                                Opacity="{Binding EditorOverlayMessage.OverlayOpacity, RelativeSource={RelativeSource TemplatedParent}}" />

                                            <Border
                                                x:Name="PART_EditorOverlayDialog"
                                                Width="{Binding EditorOverlayMessage.DetailWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                MinWidth="{Binding EditorOverlayMessage.DetailMinWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                MinHeight="{Binding EditorOverlayMessage.DetailMinHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                MaxWidth="{Binding EditorOverlayMessage.DetailMaxWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                MaxHeight="{Binding EditorOverlayMessage.DetailMaxHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                                Margin="{Binding EditorOverlayMessage.DetailMargin, RelativeSource={RelativeSource TemplatedParent}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding EditorOverlayMessage.DetailBackground, RelativeSource={RelativeSource TemplatedParent}}"
                                                BorderBrush="{Binding EditorOverlayMessage.DetailBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                BorderThickness="{Binding EditorOverlayMessage.DetailBorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                                                CornerRadius="{Binding EditorOverlayMessage.DetailCornerRadius, RelativeSource={RelativeSource TemplatedParent}}"
                                                SnapsToDevicePixels="True"
                                                Validation.ErrorTemplate="{x:Null}">
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="22"
                                                        Direction="270"
                                                        Opacity="0.20"
                                                        ShadowDepth="5" />
                                                </Border.Effect>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        x:Name="PART_EditorOverlayHeaderRoot"
                                                        Grid.Row="0"
                                                        MinHeight="46"
                                                        BorderBrush="{Binding EditorOverlayMessage.DetailBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                        BorderThickness="0,0,0,1"
                                                        Visibility="{Binding EditorOverlayMessage.HasHeaderChrome, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <ContentPresenter
                                                                Grid.Column="0"
                                                                Margin="{Binding EditorOverlayMessage.DetailHeaderPadding, RelativeSource={RelativeSource TemplatedParent}}"
                                                                VerticalAlignment="Center"
                                                                Content="{Binding EditorOverlayMessage.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ContentTemplate="{Binding EditorOverlayMessage.HeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                                RecognizesAccessKey="True"
                                                                TextElement.FontSize="15"
                                                                TextElement.FontWeight="SemiBold"
                                                                TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />

                                                            <controls:XValidationHintPopup
                                                                Grid.Column="1"
                                                                Margin="0,8,8,8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Header="Validation"
                                                                Source="{Binding EditorOverlayMessage.ValidationSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                                Validation.ErrorTemplate="{x:Null}"
                                                                Visibility="{Binding EditorOverlayMessage.ShowValidationHint, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}" />

                                                            <controls:XButton
                                                                Grid.Column="2"
                                                                Width="30"
                                                                Height="30"
                                                                MinWidth="30"
                                                                Margin="0,8,8,8"
                                                                Padding="0"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                Appearance="Ghost"
                                                                Command="{Binding EditorOverlayMessage.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                CommandParameter="{Binding EditorOverlayMessage.CloseCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                                CornerRadius="5"
                                                                FontSize="20"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                                                Icon="{ico:MaterialDesign Kind=Close}"
                                                                IconSize="10"
                                                                ToolTip="Close"
                                                                Variant="Default"
                                                                Visibility="{Binding EditorOverlayMessage.ShowCloseButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Border>

                                                    <ScrollViewer
                                                        Grid.Row="1"
                                                        HorizontalScrollBarVisibility="Disabled"
                                                        VerticalScrollBarVisibility="Auto">
                                                        <ContentPresenter
                                                            Margin="{Binding EditorOverlayMessage.DetailPadding, RelativeSource={RelativeSource TemplatedParent}}"
                                                            Content="{Binding EditorOverlayMessage.Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ContentTemplate="{Binding EditorOverlayMessage.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                            RecognizesAccessKey="True"
                                                            SnapsToDevicePixels="True"
                                                            TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}"
                                                            Validation.ErrorTemplate="{x:Null}" />
                                                    </ScrollViewer>

                                                    <Grid Grid.Row="2">
                                                        <Border
                                                            Padding="{Binding EditorOverlayMessage.DetailFooterPadding, RelativeSource={RelativeSource TemplatedParent}}"
                                                            BorderBrush="{Binding EditorOverlayMessage.DetailBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                            BorderThickness="0,1,0,0"
                                                            Visibility="{Binding EditorOverlayMessage.HasFooter, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}">
                                                            <ContentPresenter
                                                                Content="{Binding EditorOverlayMessage.Footer, RelativeSource={RelativeSource TemplatedParent}}"
                                                                ContentTemplate="{Binding EditorOverlayMessage.FooterTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                                                RecognizesAccessKey="True"
                                                                TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                                                        </Border>

                                                        <Border
                                                            Padding="{Binding EditorOverlayMessage.DetailFooterPadding, RelativeSource={RelativeSource TemplatedParent}}"
                                                            BorderBrush="{Binding EditorOverlayMessage.DetailBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                            BorderThickness="0,1,0,0"
                                                            Visibility="{Binding EditorOverlayMessage.ShowDefaultFooter, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}">
                                                            <controls:XStackPanel
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                                <controls:XButton
                                                                    MinWidth="96"
                                                                    Command="{Binding EditorOverlayMessage.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    CommandParameter="{Binding EditorOverlayMessage.CloseCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Content="{Binding EditorOverlayMessage.CancelText, RelativeSource={RelativeSource TemplatedParent}}" />
                                                                <controls:XButton
                                                                    MinWidth="96"
                                                                    Command="{Binding EditorOverlayMessage.PrimaryCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    CommandParameter="{Binding EditorOverlayMessage.PrimaryCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Content="{Binding EditorOverlayMessage.PrimaryText, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Variant="Primary"
                                                                    Visibility="{Binding EditorOverlayMessage.HasPrimaryCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource XWindowBooleanToVisibilityConverter}}" />
                                                            </controls:XStackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Border
                                            x:Name="PART_ToastHost"
                                            Margin="16"
                                            Padding="14,10"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Panel.ZIndex="30"
                                            Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Opacity="0"
                                            Visibility="Collapsed">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="PART_ToastTransform" Y="0" />
                                            </Border.RenderTransform>
                                            <ContentPresenter
                                                Content="{TemplateBinding ToastContent}"
                                                ContentTemplate="{TemplateBinding ToastContentTemplate}"
                                                TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                                        </Border>

                                        <Thumb
                                            x:Name="PART_ResizeGrip"
                                            Panel.ZIndex="40"
                                            Style="{StaticResource XWindowResizeGripStyle}"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <Border
                                        x:Name="PART_StatusBar"
                                        Grid.Row="3"
                                        Padding="12,6"
                                        Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                        BorderBrush="{TemplateBinding WindowBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                        <ContentPresenter
                                            Content="{TemplateBinding StatusBarContent}"
                                            ContentTemplate="{TemplateBinding StatusBarContentTemplate}"
                                            TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="PART_ModalOverlay"
                                Panel.ZIndex="100"
                                Background="{TemplateBinding ModalOverlayBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="True"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />

                            <Thumb
                                x:Name="PART_LeftResizeThumb"
                                Width="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Cursor="SizeWE"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_TopResizeThumb"
                                Height="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Cursor="SizeNS"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_RightResizeThumb"
                                Width="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Cursor="SizeWE"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_BottomResizeThumb"
                                Height="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Cursor="SizeNS"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_TopLeftResizeThumb"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Cursor="SizeNWSE"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_TopRightResizeThumb"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="SizeNESW"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_BottomRightResizeThumb"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Cursor="SizeNWSE"
                                Style="{StaticResource XWindowResizeThumbStyle}" />

                            <Thumb
                                x:Name="PART_BottomLeftResizeThumb"
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Cursor="SizeNESW"
                                Style="{StaticResource XWindowResizeThumbStyle}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="PART_SubtitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowThemeSelector" Value="True">
                            <Setter TargetName="PART_ThemeSelector" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowLanguageSelector" Value="True">
                            <Setter TargetName="PART_LanguageSelector" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowThemeModeButton" Value="False">
                            <Setter TargetName="PART_ThemeModeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaximizeRestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="StatusBarContent" Value="{x:Null}">
                            <Setter TargetName="PART_StatusBar" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StatusBarRow" Property="Height" Value="0" />
                        </Trigger>

                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="PART_BusyOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsModalOverlayOpen" Value="True">
                            <Setter TargetName="PART_ModalOverlay" Property="Visibility" Value="Visible" />
                        </Trigger>


                        <Trigger Property="ToastPlacement" Value="TopRight">
                            <Setter TargetName="PART_ToastHost" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_ToastHost" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <Trigger Property="ToastPlacement" Value="BottomRight">
                            <Setter TargetName="PART_ToastHost" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_ToastHost" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>

                        <Trigger Property="ToastPlacement" Value="Center">
                            <Setter TargetName="PART_ToastHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_ToastHost" Property="VerticalAlignment" Value="Center" />
                        </Trigger>

                        <Trigger Property="IsToastOpen" Value="True">
                            <Setter TargetName="PART_ToastHost" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ToastShowStoryboard">
                                    <Storyboard FillBehavior="HoldEnd">
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource XWindowEaseOut}"
                                            Storyboard.TargetName="PART_ToastTransform"
                                            Storyboard.TargetProperty="Y"
                                            From="18"
                                            To="0"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_ToastHost"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <Trigger Property="IsToastOpen" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ToastHideStoryboard">
                                    <Storyboard FillBehavior="HoldEnd">
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource XWindowEaseOut}"
                                            Storyboard.TargetName="PART_ToastTransform"
                                            Storyboard.TargetProperty="Y"
                                            To="18"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_ToastHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter TargetName="PART_ToastHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ToastContent" Value="{x:Null}">
                            <Setter TargetName="PART_ToastHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="LeftFlyoutContent" Value="{x:Null}">
                            <Setter TargetName="PART_LeftFlyout" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="RightFlyoutContent" Value="{x:Null}">
                            <Setter TargetName="PART_RightFlyout" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="TopFlyoutContent" Value="{x:Null}">
                            <Setter TargetName="PART_TopFlyout" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="BottomFlyoutContent" Value="{x:Null}">
                            <Setter TargetName="PART_BottomFlyout" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowResizeGrip" Value="True" />
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_LeftResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopLeftResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopRightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomRightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomLeftResizeThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="UseAnimations" Value="False">
                            <Setter TargetName="PART_LeftFlyout" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_RightFlyout" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_TopFlyout" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_BottomFlyout" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_ToastHost" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RestoreIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_TitleBar" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_WindowFrame" Property="CornerRadius" Value="0" />
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_LeftResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopLeftResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TopRightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomRightResizeThumb" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_BottomLeftResizeThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
