<UserControl
    x:Class="VIA.WPF.Demo.Views.XWelcomeDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XWelcomeDashboardViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="LandingHeaderBarStyle"
            BasedOn="{StaticResource {x:Type via:XHeaderBar}}"
            TargetType="{x:Type via:XHeaderBar}">
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style
            x:Key="LandingHeaderGroupStyle"
            BasedOn="{StaticResource {x:Type via:XHeaderGroup}}"
            TargetType="{x:Type via:XHeaderGroup}">
            <Setter Property="Height" Value="54" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,2" />
        </Style>

        <Style x:Key="LandingFeatureCardStyle" TargetType="{x:Type Border}">
            <Setter Property="MinHeight" Value="178" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="LandingFeatureIconStyle" TargetType="{x:Type via:XMaterialIcon}">
            <Setter Property="Size" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.Accent}}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="WorkbenchPreviewTemplate">
            <Grid
                Background="{DynamicResource {x:Static via:XBrushKeys.Canvas}}"
                TextElement.Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.ColumnSpan="2"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                    BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <via:XTextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="ProjectPlanner"
                            TextRole="SectionTitle" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                        BorderThickness="0,0,1,0">
                        <via:XStackPanel Margin="10" Spacing="7">
                            <via:XTextBlock
                                Margin="3,1,0,4"
                                FontWeight="SemiBold"
                                Text="Workspace"
                                TextRole="Caption" />
                            <via:XButton Content="Dashboard" Size="Small" Variant="Primary" />
                            <via:XButton Content="Tasks" Size="Small" />
                            <via:XButton Content="Resources" Size="Small" />
                            <via:XButton Content="Calendar" Size="Small" />
                            <via:XSeparator Margin="0,5" />
                            <via:XMetric Label="Active" SupportingText="projects" Value="12" />
                            <via:XMetric Label="Due" SupportingText="this week" Value="7" Variant="Warning" />
                        </via:XStackPanel>
                    </Border>

                    <via:XStackPanel Grid.Column="1" Margin="10" Spacing="9">
                        <via:XHeaderBar Style="{StaticResource LandingHeaderBarStyle}" TitleWidth="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <via:XHeaderGroup Header="View" Style="{StaticResource LandingHeaderGroupStyle}">
                                    <via:XButtonGroup SelectedValue="Grid" Size="Small">
                                        <via:XButtonGroupItem Content="Grid" Value="Grid" />
                                        <via:XButtonGroupItem Content="Board" Value="Board" />
                                    </via:XButtonGroup>
                                </via:XHeaderGroup>
                                <via:XHeaderGroup
                                    Grid.Column="1"
                                    Header="Filter"
                                    IsSeparatorVisible="False"
                                    Style="{StaticResource LandingHeaderGroupStyle}">
                                    <via:XComboBox Width="106" SelectedIndex="0" Size="Small">
                                        <via:XComboBoxItem Content="All work" />
                                        <via:XComboBoxItem Content="Open" />
                                    </via:XComboBox>
                                </via:XHeaderGroup>
                            </Grid>
                        </via:XHeaderBar>

                        <via:XAdaptiveGrid ColumnSpacing="7" MaxColumns="3" MinItemWidth="85" RowSpacing="7">
                            <via:XMetric Label="Open" SupportingText="items" Value="42" />
                            <via:XMetric Label="Ready" SupportingText="review" Value="18" Variant="Success" />
                            <via:XMetric Label="Risk" SupportingText="focus" Value="3" Variant="Warning" />
                        </via:XAdaptiveGrid>

                        <via:XGroup
                            ContentPadding="0"
                            HeaderPadding="10,7"
                            Title="Current work">
                            <via:XDataGrid
                                Height="260"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding WorkItems}"
                                RowHeaderWidth="0">
                                <via:XDataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Id}" Header="ID" Width="86" />
                                    <DataGridTextColumn Binding="{Binding Title}" Header="Title" Width="*" />
                                    <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="92" />
                                </via:XDataGrid.Columns>
                            </via:XDataGrid>
                        </via:XGroup>
                    </via:XStackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        Background="{DynamicResource {x:Static via:XBrushKeys.Canvas}}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalContentAlignment="Center"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1900"
                Margin="24,24,24,28"
                HorizontalAlignment="Stretch">
                <via:XAdaptiveGrid
                    ColumnSpacing="24"
                    MaxColumns="2"
                    MinItemWidth="500"
                    RowSpacing="24">
                    <Grid MinHeight="440">
                                            <StackPanel
                                                MaxWidth="520"
                                                Margin="10,18"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Padding="10,5"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource {x:Static via:XBrushKeys.AccentSubtle}}"
                                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.AccentSubtleHover}}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                                        Text="PROFESSIONAL WPF UI &amp; APPLICATION LIBRARY" />
                                                </Border>

                                                <TextBlock
                                                    Margin="0,22,0,0"
                                                    FontFamily="{DynamicResource {x:Static via:XTypographyKeys.FontFamilyBody}}"
                                                    FontSize="46"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                                    LineHeight="54"
                                                    TextWrapping="Wrap">
                                                    <Run Text="Build modern WPF&#x0a;desktop applications&#x0a;" />
                                                    <Run
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                                        Text="faster." />
                                                </TextBlock>

                                                <TextBlock
                                                    Margin="0,18,0,0"
                                                    FontFamily="{DynamicResource {x:Static via:XTypographyKeys.FontFamilyBody}}"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                                    LineHeight="25"
                                                    Text="VIA.WPF combines polished controls, consistent themes, professional layouts and proven application patterns for production-ready desktop software."
                                                    TextWrapping="Wrap" />

                                                <via:XStackPanel
                                                    Margin="0,24,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                                    <via:XButton
                                                        Content="Explore controls"
                                                        Icon="{via:MaterialIcon Kind=ViewGridOutline}"
                                                        Size="Large"
                                                        Variant="Primary" />
                                                    <via:XButton
                                                        Appearance="Outline"
                                                        Content="Design system"
                                                        Icon="{via:MaterialIcon Kind=PaletteOutline}"
                                                        Size="Large" />
                                                </via:XStackPanel>

                                                <via:XStackPanel
                                                    Margin="2,18,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="7">
                                                    <via:XMaterialIcon
                                                        Kind="CheckCircleOutline"
                                                        Size="16"
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.StatusSuccess}}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextTertiary}}"
                                                        Text="Built for real-world MVVM applications" />
                                                </via:XStackPanel>
                                            </StackPanel>
                                        </Grid>

                    <via:XBorder
                        MinHeight="440"
                        Padding="10"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Elevation="Low">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <via:XStackPanel Margin="10,6,10,10" Spacing="3">
                                <via:XTextBlock FontWeight="SemiBold" Text="Built with VIA.WPF" TextRole="SectionTitle" />
                                <via:XTextBlock
                                    Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                    Text="A production workbench created with the same control, theme and layout foundation." />
                            </via:XStackPanel>
                            <Image
                                Grid.Row="1"
                                Margin="10,2,10,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="pack://application:,,,/VIA.WPF.Demo;component/Resources/images/via-userflow-monitor.png"
                                Stretch="Uniform" />
                        </Grid>
                    </via:XBorder>

                    <Border
                        MinHeight="540"
                        Padding="8"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Opacity="0.12"
                                ShadowDepth="3" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="10,6,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                        Text="Light layout" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                        Text="Bright, precise and clearly layered." />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.AccentSubtle}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.AccentSubtleHover}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                        Text="LIGHT" />
                                </Border>
                            </Grid>
                            <Viewbox
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Stretch="Uniform">
                                <Border Width="1071" Height="586">
                                    <Border ClipToBounds="True">
                                                                            <Border.Resources>
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Primary}" Color="#FF0F6CBD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimaryForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimarySubtle}" Color="#FFEAF3FB" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimarySubtleHover}" Color="#FFD6E9FA" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimaryStrong}" Color="#FF0C5A9E" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Surface}" Color="#FFFBFCFD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SurfaceOverlay}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Accent}" Color="#FF0F6CBD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentSubtle}" Color="#FFEAF3FB" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentSubtleHover}" Color="#FFD6E9FA" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentStrong}" Color="#FF0C5A9E" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccess}" Color="#FF15803D" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessSubtle}" Color="#FFE6F4EA" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessSubtleHover}" Color="#FFC8E7D2" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessStrong}" Color="#FF116B34" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarning}" Color="#FFD97706" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningSubtle}" Color="#FFF9EEDD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningSubtleHover}" Color="#FFF1D7AE" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningStrong}" Color="#FFB85F05" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusDanger}" Color="#FFC42B1C" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusDangerForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusDangerSubtle}" Color="#FFF9EAE8" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusDangerSubtleHover}" Color="#FFF2D0CD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusDangerStrong}" Color="#FF99261F" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusInfo}" Color="#FF007C83" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusInfoForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusInfoSubtle}" Color="#FFE6F2F3" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusInfoSubtleHover}" Color="#FFC7E2E4" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusInfoStrong}" Color="#FF04646E" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Canvas}" Color="#FFEFF1F3" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SurfaceRaised}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SurfaceSunken}" Color="#FFE2E5E8" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.TextPrimary}" Color="#FF202124" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.TextSecondary}" Color="#FF5F6770" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.TextTertiary}" Color="#FF69727D" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.TextDisabled}" Color="#FF7A838E" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.BorderSubtle}" Color="#FFD5D9DE" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.BorderDefault}" Color="#FFB8BEC6" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.BorderStrong}" Color="#FF858D97" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Divider}" Color="#FFD5D9DE" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.FocusRing}" Color="#FF0F6CBD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.FocusRingInner}" Color="#FFFBFCFD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StateHover}" Color="#FFECF0F4" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatePressed}" Color="#FFDFE5EB" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StateSelected}" Color="#FFDCEBFA" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StateSelectedStrong}" Color="#FF0F6CBD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.CommandBarBackground}" Color="#00FFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.CommandBarForeground}" Color="#FF202124" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.CommandBarHoverBackground}" Color="#FFECF0F4" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.CommandBarPressedBackground}" Color="#FFDFE5EB" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.CommandBarGroupHeaderBackground}" Color="#FF526578" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SelectionBorder}" Color="#FF0F6CBD" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SelectionForeground}" Color="#FF202124" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.DisabledBackground}" Color="#FFEAEDF1" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.DisabledBorder}" Color="#FFCBD1D9" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.GridLine}" Color="#FFD7DBE0" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.GridHeaderBackground}" Color="#FFF2F4F6" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.GridHeaderForeground}" Color="#FF202124" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.InputBackground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.InputBorder}" Color="#FFB8BEC6" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.InputPlaceholder}" Color="#FF69727D" />
                                                                            </Border.Resources>
                                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkbenchPreviewTemplate}" Tag="LIGHT" />
                                                                        </Border>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Border
                        MinHeight="540"
                        Padding="8"
                        Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Opacity="0.12"
                                ShadowDepth="3" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="10,6,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                        Text="Dark layout" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}"
                                        Text="Reduced glare with the same visual hierarchy." />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.AccentSubtle}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.AccentSubtleHover}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                        Text="DARK" />
                                </Border>
                            </Grid>
                            <Viewbox
                                Grid.Row="1"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Stretch="Uniform">
                                <Border Width="1071" Height="586">
                                    <Border ClipToBounds="True">
                                                                            <Border.Resources>
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Primary}" Color="#FF4CA6FF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimaryForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimarySubtle}" Color="#FF263D52" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimarySubtleHover}" Color="#FF315F88" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.PrimaryStrong}" Color="#FF4CA6FF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Surface}" Color="#FF272829" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.SurfaceOverlay}" Color="#FF303235" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.Accent}" Color="#FF4CA6FF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentSubtle}" Color="#FF263D52" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentSubtleHover}" Color="#FF315F88" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.AccentStrong}" Color="#FF4CA6FF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccess}" Color="#FF49B36D" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessForeground}" Color="#FFFFFFFF" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessSubtle}" Color="#FF203D2A" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessSubtleHover}" Color="#FF2B5A3A" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusSuccessStrong}" Color="#FF329052" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarning}" Color="#FFF0A23A" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningForeground}" Color="#FF171819" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningSubtle}" Color="#FF44351E" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningSubtleHover}" Color="#FF654B23" />
                                                                                <SolidColorBrush x:Key="{x:Static via:XBrushKeys.StatusWarningStrong}" Color="#FFD38625" />
