<UserControl
    x:Class="VIA.WPF.Demo.Views.XRadioGroupDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XRadioGroupDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="4,0,4,20"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="22">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XRadioGroup" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="880"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="A titled single-selection group for richer option rows, descriptions, semantic variants and MVVM-backed selected item or selected value."
                            TextRole="Description" />
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Grid.Column="0"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Descriptive single selection" TextRole="SectionTitle" />
                                <via:XRadioGroup
                                    Title="Default view"
                                    HorizontalAlignment="Left"
                                    ItemSpacing="8"
                                    ItemsPadding="12">
                                    <via:XRadioGroupItem
                                        Content="Grid"
                                        Description="Best for dense data and column filtering."
                                        IsChecked="True"
                                        Variant="Primary" />
                                    <via:XRadioGroupItem
                                        Content="Tree"
                                        Description="Best for hierarchical structures."
                                        Variant="Info" />
                                    <via:XRadioGroupItem
                                        Content="Cards"
                                        Description="Best for visual overview pages."
                                        Variant="Accent" />
                                </via:XRadioGroup>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Bound selected item" TextRole="SectionTitle" />
                                <via:XRadioGroup
                                    Title="Bound layout mode"
                                    HorizontalAlignment="Left"
                                    ItemSpacing="8"
                                    ItemsPadding="12"
                                    ItemsSource="{Binding LayoutOptions}"
                                    SelectedItem="{Binding SelectedLayoutOption, Mode=TwoWay}">
                                    <via:XRadioGroup.ItemTemplate>
                                        <DataTemplate>
                                            <via:XStackPanel Spacing="2">
                                                <via:XTextBlock Text="{Binding Name}" TextRole="Body" />
                                                <via:XTextBlock
                                                    IsMultiline="True"
                                                    Text="{Binding Description}"
                                                    TextRole="Description" />
                                            </via:XStackPanel>
                                        </DataTemplate>
                                    </via:XRadioGroup.ItemTemplate>
                                </via:XRadioGroup>
                                <via:XBorder
                                    Padding="12"
                                    CornerRadius="6"
                                    Elevation="None"
                                    Variant="Info">
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.InfoText}}"
                                        Text="{Binding LayoutSummary, FallbackValue='Description'}"
                                        TextRole="Description" />
                                </via:XBorder>
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Grid.Column="0"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Compact horizontal selection" TextRole="SectionTitle" />
                                <via:XRadioGroup
                                    HorizontalAlignment="Left"
                                    ItemSpacing="24"
                                    ItemsPadding="12,5"
                                    Orientation="Horizontal"
                                    ShowTitle="False">
                                    <via:XRadioGroupItem Content="Small" />
                                    <via:XRadioGroupItem Content="Medium" IsChecked="True" />
                                    <via:XRadioGroupItem Content="Large" />
                                </via:XRadioGroup>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Sizes and disabled state" TextRole="SectionTitle" />
                                <via:XStackPanel Spacing="10">
                                    <via:XRadioGroup
                                        HorizontalAlignment="Left"
                                        ItemSpacing="12"
                                        ItemsPadding="10,5"
                                        Orientation="Horizontal"
                                        ShowTitle="False"
                                        Size="Small">
                                        <via:XRadioGroupItem Content="A" />
                                        <via:XRadioGroupItem Content="B" IsChecked="True" />
                                        <via:XRadioGroupItem Content="C" />
                                    </via:XRadioGroup>
                                    <via:XRadioGroup
                                        HorizontalAlignment="Left"
                                        IsEnabled="False"
                                        ItemSpacing="12"
                                        ItemsPadding="10,5"
                                        Orientation="Horizontal"
                                        ShowTitle="False">
                                        <via:XRadioGroupItem Content="Locked" IsChecked="True" />
                                        <via:XRadioGroupItem Content="Disabled" />
                                    </via:XRadioGroup>
                                </via:XStackPanel>
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
