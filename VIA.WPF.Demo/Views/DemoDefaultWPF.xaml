<Window
    x:Class="VIA.WPF.Demo.Views.DemoDefaultWPF"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Default WPF Demo"
    SizeToContent="Height"
    Width="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Border
            Padding="12"
            Background="#F0F0F0"
            BorderBrush="#D0D0D0"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Text="Default WPF Controls" />
                <TextBlock Margin="0,4,0,0" Text="Bewusst ohne Styles, Themes oder Tuning – nur die Standardoptik von WPF." />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="12"
                    Header="Basic Inputs">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="TextBox" />
                        <TextBox Margin="0,0,0,10" Text="Lorem ipsum dolor sit amet" />

                        <TextBlock Margin="0,0,0,4" Text="PasswordBox" />
                        <PasswordBox Margin="0,0,0,10" Password="secret123" />

                        <TextBlock Margin="0,0,0,4" Text="ComboBox" />
                        <ComboBox Margin="0,0,0,10" SelectedIndex="1">
                            <ComboBoxItem Content="Option 1" />
                            <ComboBoxItem Content="Option 2" />
                            <ComboBoxItem Content="Option 3" />
                        </ComboBox>

                        <TextBlock Margin="0,0,0,4" Text="DatePicker" />
                        <DatePicker Margin="0,0,0,10" SelectedDate="2026-04-13" />

                        <TextBlock Margin="0,0,0,4" Text="Buttons" />
                        <WrapPanel>
                            <Button
                                Margin="0,0,8,0"
                                Padding="12,4"
                                Content="OK" />
                            <Button
                                Margin="0,0,8,0"
                                Padding="12,4"
                                Content="Cancel" />
                            <Button
                                Padding="12,4"
                                Content="Disabled"
                                IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox
                    Grid.Row="0"
                    Grid.Column="2"
                    Padding="12"
                    Header="Choices">
                    <StackPanel>
                        <CheckBox
                            Margin="0,0,0,8"
                            Content="Enable notifications"
                            IsChecked="True" />
                        <CheckBox Margin="0,0,0,8" Content="Auto-save changes" />
                        <CheckBox
                            Margin="0,0,0,12"
                            Content="Experimental option"
                            IsChecked="{x:Null}"
                            IsThreeState="True" />

                        <RadioButton
                            Margin="0,0,0,8"
                            Content="Light"
                            GroupName="Theme"
                            IsChecked="True" />
                        <RadioButton
                            Margin="0,0,0,8"
                            Content="Dark"
                            GroupName="Theme" />
                        <RadioButton
                            Margin="0,0,0,12"
                            Content="System"
                            GroupName="Theme" />

                        <TextBlock Margin="0,0,0,4" Text="ListBox" />
                        <ListBox Height="130">
                            <ListBoxItem Content="Project Alpha" />
                            <ListBoxItem Content="Project Beta" IsSelected="True" />
                            <ListBoxItem Content="Project Gamma" />
                            <ListBoxItem Content="Project Delta" />
                        </ListBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Padding="12"
                    Header="Sliders and Progress">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Text="Slider" />
                        <Slider
                            Margin="0,0,0,12"
                            IsSnapToTickEnabled="False"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="10"
                            Value="35" />

                        <TextBlock Margin="0,0,0,4" Text="ProgressBar" />
                        <ProgressBar
                            Height="18"
                            Margin="0,0,0,12"
                            Maximum="100"
                            Minimum="0"
                            Value="62" />

                        <TextBlock Margin="0,0,0,4" Text="ScrollBar" />
                        <ScrollBar
                            Maximum="100"
                            Minimum="0"
                            Orientation="Horizontal"
                            ViewportSize="10"
                            Value="20" />
                    </StackPanel>
                </GroupBox>

                <GroupBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Padding="12"
                    Header="Tree and Tabs">
                    <DockPanel>
                        <TabControl Margin="0,0,0,12" DockPanel.Dock="Top">
                            <TabItem Header="General">
                                <TextBlock
                                    Margin="10"
                                    Text="Default TabControl look, plain content, default spacing."
                                    TextWrapping="Wrap" />
                            </TabItem>
                            <TabItem Header="Advanced">
                                <TextBlock Margin="10" Text="Second tab page" />
                            </TabItem>
                        </TabControl>

                        <TreeView Height="100">
                            <TreeViewItem Header="Workspace">
                                <TreeViewItem Header="Screen 1" />
                                <TreeViewItem Header="Screen 2" />
                                <TreeViewItem Header="Assets">
                                    <TreeViewItem Header="Icons" />
                                    <TreeViewItem Header="Images" />
                                </TreeViewItem>
                            </TreeViewItem>
                        </TreeView>
                    </DockPanel>
                </GroupBox>

                <GroupBox
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Padding="12"
                    Header="DataGrid and Status">
                    <DockPanel>
                        <StatusBar Margin="0,12,0,0" DockPanel.Dock="Bottom">
                            <StatusBarItem Content="Ready" />
                            <Separator />
                            <StatusBarItem Content="3 items selected" />
                            <Separator />
                            <StatusBarItem Content="Default theme" />
                        </StatusBar>

                        <DataGrid
                            x:Name="DemoGrid"
                            Height="120"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Id}"
                                    Header="Id" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridCheckBoxColumn
                                    Width="90"
                                    Binding="{Binding IsActive}"
                                    Header="Active" />
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding Role}"
                                    Header="Role" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </DockPanel>

</Window>
