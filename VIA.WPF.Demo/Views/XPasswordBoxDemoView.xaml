<UserControl
    x:Class="VIA.WPF.Demo.Views.XPasswordBoxDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XPasswordBoxDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="18">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XPasswordBox" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="920"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="Themed password input with reveal behavior, icon slots, size variants, descriptions and binding support."
                            TextRole="Description"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XBorder
                        Padding="20"
                        Appearance="Solid"
                        BorderThickness="1"
                        CornerRadius="8"
                        Elevation="Low">
                        <via:XGrid Columns="*,*" ColumnSpacing="22" RowSpacing="18">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Common input states" TextRole="SectionTitle" />
                                <via:XPasswordBox
                                    Width="340"
                                    HorizontalAlignment="Left"
                                    Description="Default field with reveal button and placeholder."
                                    Header="Password"
                                    LeadingIcon="{via:BootstrapIcon Kind=LockFill}"
                                    Password="VIA.WPF-Pro-2026!"
                                    Placeholder="Enter password"
                                    TrailingIcon="{via:BootstrapIcon Kind=ShieldLockFill}" />

                                <via:XPasswordBox
                                    Width="340"
                                    HorizontalAlignment="Left"
                                    Description="The reveal button can be disabled for sensitive flows."
                                    HasRevealButton="False"
                                    Header="Reveal disabled"
                                    LeadingIcon="{via:BootstrapIcon Kind=KeyFill}"
                                    Password="hidden"
                                    Placeholder="No reveal button" />
                            </via:XStackPanel>

                            <via:XStackPanel Grid.Column="1" Spacing="14">
                                <via:XTextBlock Text="Sizes and variants" TextRole="SectionTitle" />
                                <via:XPasswordBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Header="Small"
                                    LeadingIcon="{via:BootstrapIcon Kind=LockFill}"
                                    Placeholder="Compact password"
                                    Size="Small" />

                                <via:XPasswordBox
                                    Width="360"
                                    HorizontalAlignment="Left"
                                    Description="Large fields fit account setup or onboarding pages."
                                    Header="Large account password"
                                    LeadingIcon="{via:BootstrapIcon Kind=PersonFill}"
                                    Password="visible-demo"
                                    Placeholder="Large password"
                                    Size="Large" />
                            </via:XStackPanel>
                        </via:XGrid>
                    </via:XBorder>

                    <via:XGrid Columns="*,*" ColumnSpacing="18" RowSpacing="18">
                        <via:XBorder
                            Padding="20"
                            Appearance="Solid"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Two-way binding" TextRole="SectionTitle" />
                                <via:XPasswordBox
                                    Width="360"
                                    HorizontalAlignment="Left"
                                    Description="This sample binds the password to the demo view model."
                                    Header="Bound password"
                                    LeadingIcon="{via:BootstrapIcon Kind=KeyFill}"
                                    Password="{Binding DemoPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="Bound password" />
                                <via:XBorder
                                    Padding="12"
                                    Appearance="Subtle"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Variant="Info">
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Use the secure variant when the value should not be exposed through a bindable string property."
                                        TextRole="Description"
                                        TextWrapping="Wrap" />
                                </via:XBorder>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            Appearance="Solid"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Field states" TextRole="SectionTitle" />
                                <via:XPasswordBox
                                    Width="340"
                                    HorizontalAlignment="Left"
                                    Description="Disabled fields keep layout and typography consistent."
                                    Header="Disabled"
                                    IsEnabled="False"
                                    LeadingIcon="{via:BootstrapIcon Kind=LockFill}"
                                    Password="disabled"
                                    Placeholder="Disabled" />
                                <via:XPasswordBox
                                    Width="340"
                                    HorizontalAlignment="Left"
                                    CornerRadius="12"
                                    Description="CornerRadius can be customized for local design systems."
                                    Header="Custom radius"
                                    LeadingIcon="{via:BootstrapIcon Kind=Stars}"
                                    Placeholder="Rounded field" />
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
