<via:XWindow
    x:Class="VIA.WPF.Demo.Views.XDialogSampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:via="http://schemas.via.dev/wpf"
    Title="Edit profile"
    Width="660"
    MinWidth="560"
    d:DataContext="{d:DesignInstance Type=viewmodels:XDialogProfile}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowLanguageSelector="False"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    ShowResizeGrip="False"
    ShowThemeModeButton="False"
    ShowThemeSelector="False"
    SizeToContent="Height"
    Subtitle="Service-managed modal editor"
    TitleBarHeight="46"
    TitleBarPadding="20,0,10,0"
    TitleFontSize="15"
    WindowBackgroundBrush="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
    WindowBorderBrush="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">

    <via:XGrid Rows="*,Auto">
        <ScrollViewer
            MaxHeight="650"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <via:XStackPanel Margin="24,22,24,20" Spacing="18">
                <via:XGrid Columns="Auto,*" ColumnSpacing="14">
                    <via:XBorder
                        Width="46"
                        Height="46"
                        Appearance="Subtle"
                        BorderThickness="1"
                        CornerRadius="8"
                        Variant="Primary">
                        <via:XMaterialIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="AccountCircleOutline"
                            Size="24" />
                    </via:XBorder>

                    <via:XStackPanel Grid.Column="1" Spacing="3">
                        <via:XTextBlock Text="Profile details" TextRole="SectionTitle" />
                        <via:XTextBlock
                            IsMultiline="True"
                            Text="Edit the sample record. Save returns Accepted; Cancel returns NotAccepted."
                            TextRole="Description" />
                    </via:XStackPanel>
                </via:XGrid>

                <via:XBorder
                    Padding="14"
                    Appearance="VerySubtle"
                    BorderThickness="1"
                    CornerRadius="6">
                    <via:XGrid Columns="*,*" ColumnSpacing="14" Rows="Auto,Auto" RowSpacing="14">
                        <via:XTextBox
                            x:Name="DisplayNameInput"
                            Header="Display name"
                            Placeholder="Enter a display name"
                            Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <via:XTextBox
                            Grid.Column="1"
                            Header="Email"
                            Placeholder="name@example.com"
                            Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <via:XTextBox
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Header="Role"
                            Placeholder="Role or responsibility"
                            Text="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </via:XGrid>
                </via:XBorder>

                <via:XTextBox
                    Height="110"
                    AcceptsReturn="True"
                    Header="Notes"
                    Placeholder="Add notes for the team"
                    Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top" />

                <via:XBorder
                    Padding="12"
                    Appearance="Subtle"
                    BorderThickness="1"
                    CornerRadius="6"
                    Variant="Info">
                    <via:XGrid Columns="Auto,*" ColumnSpacing="10">
                        <via:XMaterialIcon Kind="InformationOutline" Size="18" />
                        <via:XTextBlock
                            Grid.Column="1"
                            IsMultiline="True"
                            Text="The owner dimming and focus restoration are controlled by XDialogService, not by this window."
                            TextRole="Caption" />
                    </via:XGrid>
                </via:XBorder>
            </via:XStackPanel>
        </ScrollViewer>

        <via:XBorder
            Grid.Row="1"
            Padding="20,14"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
            BorderThickness="0,1,0,0">
            <via:XStackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <via:XButton
                    MinWidth="92"
                    Click="Cancel_Click"
                    Content="Cancel"
                    IsCancel="True" />
                <via:XButton
                    MinWidth="110"
                    Click="Save_Click"
                    Content="Save profile"
                    Icon="{via:MaterialIcon Kind=ContentSaveOutline}"
                    IsDefault="True"
                    Variant="Primary" />
            </via:XStackPanel>
        </via:XBorder>
    </via:XGrid>
</via:XWindow>