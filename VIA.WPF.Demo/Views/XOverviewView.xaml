<UserControl
    x:Class="VIA.WPF.Demo.Views.XOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:via="http://schemas.via.dev/wpf"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="OverviewTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OverviewIntroStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OverviewLetterStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        </Style>

        <Style x:Key="OverviewCardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}" />
        </Style>

        <Style x:Key="OverviewCardTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static via:XBrushKeys.TextSecondary}}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="OverviewCardStyle" TargetType="{x:Type via:XBorder}">
            <Setter Property="Width" Value="430" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Surface}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Elevation" Value="Low" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <via:XStackPanel
                Margin="34,28,34,52"
                IsHitTestVisible="False"
                Spacing="28">

            <!--#region ### Page Header ###-->
            <via:XBorder
                Padding="26"
                Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                BorderThickness="1"
                CornerRadius="8"
                Elevation="Low">
                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="VIA.WPF Control Gallery" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="950"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="A visual, non-interactive reference of every VIA.WPF control. Use the individual detail pages for bindings, settings and complete code examples." />
                    </via:XStackPanel>

                
            </via:XBorder>
            <!--#endregion-->

            <!--#region ### B ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="B" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XBadge" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Compact status labels for metadata, state and counters." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XBadge Content="Default" />
                                <via:XBadge
                                    Appearance="Subtle"
                                    Content="Primary"
                                    Variant="Primary" />
                                <via:XBadge
                                    Appearance="Outline"
                                    Content="Warning"
                                    Variant="Warning" />
                                <via:XBadge
                                    Appearance="Solid"
                                    Content="Done"
                                    Variant="Success" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XCalendar" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Standalone themed calendar for month, year and decade selection." />
                            </via:XStackPanel>
                            <via:XCalendar
                                HorizontalAlignment="Left"
                                DisplayDate="2026-05-01"
                                SelectedDate="2026-05-04" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XBorder" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Themed surface, card and notice container with variants and elevation." />
                            </via:XStackPanel>
                            <via:XGrid ColumnSpacing="10" Columns="*,*">
                                <via:XBorder
                                    Padding="12"
                                    Appearance="Subtle"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Elevation="None"
                                    Variant="Primary">
                                    <TextBlock Text="Primary notice" />
                                </via:XBorder>
                                <via:XBorder
                                    Grid.Column="1"
                                    Padding="12"
                                    Appearance="VerySubtle"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Elevation="None"
                                    Variant="Success">
                                    <TextBlock Text="Success card" />
                                </via:XBorder>
                            </via:XGrid>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XButton" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Primary command surface with icons, variants and loading state." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XButton Content="Default" />
                                <via:XButton
                                    Content="Save"
                                    Icon="{via:MaterialIcon Kind=ContentSaveOutline}"
                                    Variant="Primary" />
                                <via:XButton Appearance="Outline" Content="Cancel" />
                                <via:XButton
                                    Content="Loading"
                                    IsLoading="True"
                                    Variant="Primary" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XButtonGroup" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Segmented selection for compact view or mode switching." />
                            </via:XStackPanel>
                            <via:XButtonGroup
                                ItemMinWidth="92"
                                SelectedIndex="1"
                                Variant="Primary">
                                <via:XButtonGroupItem Content="List" Icon="{via:MaterialIcon Kind=FormatListBulleted}" />
                                <via:XButtonGroupItem Content="Cards" Icon="{via:MaterialIcon Kind=ViewGridOutline}" />
                                <via:XButtonGroupItem Content="Details" Icon="{via:MaterialIcon Kind=ViewHeadline}" />
                            </via:XButtonGroup>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### C ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="C" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XCheckBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Boolean and tri-state choice with shared size and variant language." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="14" VerticalSpacing="8">
                                <via:XCheckBox Content="Unchecked" />
                                <via:XCheckBox Content="Checked" IsChecked="True" />
                                <via:XCheckBox
                                    Content="Indeterminate"
                                    IsChecked="{x:Null}"
                                    IsThreeState="True" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XCheckerBoard" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Checkerboard surface for transparency and color-preview scenarios." />
                            </via:XStackPanel>
                            <via:XCheckerBoard
                                Height="58"
                                Padding="12"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CheckerSize="8"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Transparent preview" />
                            </via:XCheckerBoard>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XCheckGroup" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Grouped multi-choice options with consistent item spacing." />
                            </via:XStackPanel>
                            <via:XCheckGroup Header="Notifications" Size="Small">
                                <via:XCheckGroupItem Content="Email" IsChecked="True" />
                                <via:XCheckGroupItem Content="Desktop" />
                                <via:XCheckGroupItem Content="SMS" />
                            </via:XCheckGroup>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XComboBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Themed selection input with header, description and editable mode." />
                            </via:XStackPanel>
                            <via:XComboBox Header="Status" SelectedIndex="1">
                                <via:XComboBoxItem Content="Open" />
                                <via:XComboBoxItem Content="In progress" />
                                <via:XComboBoxItem Content="Done" />
                            </via:XComboBox>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### D ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="D" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XDataGrid" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Data table foundation with sorting, filtering, actions and view-state support on the full page." />
                            </via:XStackPanel>
                            <via:XDataGrid
                                Height="96"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding}"
                                        Header="Name" />
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding}"
                                        Header="Status" />
                                </DataGrid.Columns>
                            </via:XDataGrid>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XDatePicker" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Date input with themed header, placeholder and calendar button." />
                            </via:XStackPanel>
                            <via:XDatePicker Header="Due date" Placeholder="Pick a date" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### E ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="E" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XExpander" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Collapsible content section with icon and directional expansion support." />
                            </via:XStackPanel>
                            <via:XExpander
                                Header="Advanced options"
                                HeaderIcon="{via:MaterialIcon Kind=Tune}"
                                IsExpanded="True"
                                Size="Small">
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource OverviewCardTextStyle}"
                                    Text="More settings are shown here." />
                            </via:XExpander>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### G ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="G" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XGrid" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Grid helper with simple column, row and spacing declarations." />
                            </via:XStackPanel>
                            <via:XGrid
                                ColumnSpacing="8"
                                Columns="*,*,*"
                                RowSpacing="8"
                                Rows="Auto,Auto">
                                <via:XBorder
                                    Padding="8"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="0,0" />
                                </via:XBorder>
                                <via:XBorder
                                    Grid.Column="1"
                                    Padding="8"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="1,0" />
                                </via:XBorder>
                                <via:XBorder
                                    Grid.Column="2"
                                    Padding="8"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="2,0" />
                                </via:XBorder>
                                <via:XBorder
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Padding="8"
                                    Appearance="VerySubtle"
                                    CornerRadius="6"
                                    Elevation="None"
                                    Variant="Primary">
                                    <TextBlock Text="Grid.ColumnSpan" />
                                </via:XBorder>
                            </via:XGrid>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### H ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="H" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XHighlightTextBlock" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Inline or badge-style highlighting for search results and filtered lists." />
                            </via:XStackPanel>
                            <via:XHighlightTextBlock DisplayText="Search result highlighting marks matching terms inline." HighlightText="highlight" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### I ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="I" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XIcon" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Shared icon host and themed icon-pack controls." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="16" VerticalSpacing="10">
                                <via:XStackPanel Orientation="Horizontal" Spacing="6">
                                    <via:XIcon Kind="Home" Size="20" />
                                    <TextBlock VerticalAlignment="Center" Text="XIcon" />
                                </via:XStackPanel>
                                <via:XStackPanel Orientation="Horizontal" Spacing="6">
                                    <via:XMaterialIcon Kind="AccountCircleOutline" Size="20" />
                                    <TextBlock VerticalAlignment="Center" Text="Material" />
                                </via:XStackPanel>
                                <via:XStackPanel Orientation="Horizontal" Spacing="6">
                                    <via:XBootstrapIcon Kind="House" Size="20" />
                                    <TextBlock VerticalAlignment="Center" Text="Bootstrap" />
                                </via:XStackPanel>
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XIconButton" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Compact icon-only command button for toolbars and dense UIs." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XIconButton Icon="{via:MaterialIcon Kind=PencilOutline}" ToolTip="Edit" />
                                <via:XIconButton
                                    Appearance="Outline"
                                    Icon="{via:MaterialIcon Kind=Refresh}"
                                    ToolTip="Refresh"
                                    Variant="Primary" />
                                <via:XIconButton
                                    Appearance="Subtle"
                                    Icon="{via:MaterialIcon Kind=DeleteOutline}"
                                    ToolTip="Delete"
                                    Variant="Danger" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### L ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="L" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XListBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="List and navigation selection with themed item states." />
                            </via:XStackPanel>
                            <via:XListBox Mode="Navigation" SelectedIndex="0">
                                <via:XListBoxItem>
                                    <TextBlock Text="Dashboard" />
                                </via:XListBoxItem>
                                <via:XListBoxItem>
                                    <TextBlock Text="Reports" />
                                </via:XListBoxItem>
                                <via:XListBoxItem>
                                    <TextBlock Text="Settings" />
                                </via:XListBoxItem>
                            </via:XListBox>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XLookupComboBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Search-oriented lookup input for larger object lists." />
                            </via:XStackPanel>

                            <via:XLookupComboBox
                                Width="360"
                                DisplayMemberPath="Name"
                                Header="Customer"
                                Icon="{via:MaterialIcon Kind=Magnify}"
                                IconSize="16"
                                IsSearchEnabled="True"
                                ItemsSource="{Binding OverviewCustomers}"
                                Placeholder="Search customer"
                                SelectedValue="{Binding SelectedOverviewCustomerId, Mode=TwoWay}"
                                SelectedValuePath="Id" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XLookupTreeComboBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Hierarchical lookup input for categories, locations and nested objects." />
                            </via:XStackPanel>

                            <via:XLookupTreeComboBox
                                Width="360"
                                ChildrenMemberPath="Children"
                                DisplayMemberPath="Name"
                                ExpandedMemberPath="IsExpanded"
                                Header="Category"
                                Icon="{via:MaterialIcon Kind=FileTreeOutline}"
                                IconSize="16"
                                ItemsSource="{Binding OverviewCategories}"
                                Placeholder="Select category"
                                SelectedValue="{Binding SelectedOverviewCategoryId, Mode=TwoWay}"
                                SelectedValuePath="Id" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### N ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="N" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XNavigationList" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Navigation menu with item icons, titles and selection state." />
                            </via:XStackPanel>
                            <via:XNavigationList
                                Header="Navigation"
                                ItemCornerRadius="6"
                                ItemMargin="0,0,0,4"
                                ItemPadding="10,8"
                                SelectedIndex="0">
                                <via:XNavigationListItem Title="Dashboard" Icon="{via:MaterialIcon Kind=ViewDashboardOutline}" />
                                <via:XNavigationListItem Title="Reports" Icon="{via:MaterialIcon Kind=ChartLine}" />
                                <via:XNavigationListItem Title="Settings" Icon="{via:MaterialIcon Kind=Cog}" />
                            </via:XNavigationList>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XNavigationTabControl" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Navigation-oriented tab header with icon support." />
                            </via:XStackPanel>
                            <via:XNavigationTabControl
                                HeaderPadding="12,8"
                                HeaderSpacing="8"
                                SelectedIndex="0">
                                <via:XNavigationTabItem Header="Home" Icon="{via:MaterialIcon Kind=HomeOutline}" />
                                <via:XNavigationTabItem Header="Reports" Icon="{via:MaterialIcon Kind=ChartLine}" />
                                <via:XNavigationTabItem Header="Settings" Icon="{via:MaterialIcon Kind=Cog}" />
                            </via:XNavigationTabControl>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XNumberBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Numeric input with min/max, steps and formatting." />
                            </via:XStackPanel>
                            <via:XNumberBox
                                Header="Quantity"
                                Maximum="999"
                                Minimum="0"
                                Step="5"
                                Value="25" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### P ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="P" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XGroup" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Standard content group with arbitrary actions and footer." />
                            </via:XStackPanel>
                            <via:XGroup Title="Group" Footer="Footer">
                                <TextBlock Text="Group content" />
                            </via:XGroup>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XPasswordBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Password input with reveal handling and themed chrome." />
                            </via:XStackPanel>
                            <via:XPasswordBox Header="Password" Placeholder="Enter password" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XProgressBar" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Progress visualization for determinate and indeterminate work." />
                            </via:XStackPanel>
                            <via:XProgressBar
                                Width="360"
                                Header="Upload"
                                ShowValue="True"
                                Value="72" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### R ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="R" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XRadioButton" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Single-choice option for small local groups." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="14" VerticalSpacing="8">
                                <via:XRadioButton
                                    Content="List"
                                    GroupName="OverviewRadio"
                                    IsChecked="True" />
                                <via:XRadioButton Content="Grid" GroupName="OverviewRadio" />
                                <via:XRadioButton Content="Cards" GroupName="OverviewRadio" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XRadioGroup" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Coordinated single-choice group with header and item layout." />
                            </via:XStackPanel>
                            <via:XRadioGroup
                                Header="Digest"
                                SelectedValue="Weekly"
                                Size="Small">
                                <via:XRadioGroupItem Content="Daily" Value="Daily" />
                                <via:XRadioGroupItem Content="Weekly" Value="Weekly" />
                                <via:XRadioGroupItem Content="Monthly" Value="Monthly" />
                            </via:XRadioGroup>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XRecentItemTree" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Recent-item and tree navigation surface for workspaces and documents." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None">
                                <via:XStackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="Recent" />
                                    <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Project Alpha" />
                                    <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Project Beta" />
                                </via:XStackPanel>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### S ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="S" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XSearchBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Search input with clear affordance and icon support." />
                            </via:XStackPanel>
                            <via:XSearchBox
                                Width="360"
                                HorizontalAlignment="Left"
                                Header="Search"
                                Placeholder="Search projects" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XSecurePasswordBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Secure password input using SecureString-oriented binding scenarios." />
                            </via:XStackPanel>
                            <via:XSecurePasswordBox Header="Secure password" Placeholder="Enter password" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XSeparator" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Horizontal and vertical separation for sections, cards and toolbars." />
                            </via:XStackPanel>
                            <via:XStackPanel
                                Height="34"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock VerticalAlignment="Center" Text="Edit" />
                                <via:XSeparator Orientation="Vertical" />
                                <TextBlock VerticalAlignment="Center" Text="View" />
                                <via:XSeparator Orientation="Vertical" />
                                <TextBlock VerticalAlignment="Center" Text="Help" />
                            </via:XStackPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XSlider" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Value selection with ticks, headers and live value display." />
                            </via:XStackPanel>
                            <via:XSlider
                                Width="360"
                                Header="Volume"
                                InactiveTrackBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                Maximum="100"
                                Minimum="0"
                                ShowValue="True"
                                ValueFormatString="F0"
                                Value="64" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XSplitView" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Pane-and-content layout for navigation shells and master/detail views." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None">
                                <via:XGrid ColumnSpacing="12" Columns="120,*">
                                    <via:XStackPanel Spacing="6">
                                        <via:XButton
                                            Appearance="Ghost"
                                            Content="Inbox"
                                            StretchContent="True" />
                                        <via:XButton
                                            Appearance="Ghost"
                                            Content="Archive"
                                            StretchContent="True" />
                                    </via:XStackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource OverviewCardTextStyle}"
                                        Text="Content pane" />
                                </via:XGrid>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XStackPanel" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="StackPanel with built-in spacing to avoid margin noise." />
                            </via:XStackPanel>
                            <via:XStackPanel Spacing="8">
                                <via:XBadge Appearance="Outline" Content="First" />
                                <via:XBadge Appearance="Outline" Content="Second" />
                                <via:XBadge Appearance="Outline" Content="Third" />
                            </via:XStackPanel>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### T ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="T" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XTabControl" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Tabbed content host with several header appearances." />
                            </via:XStackPanel>
                            <via:XTabControl SelectedIndex="0">
                                <via:XTabItem Header="General">
                                    <TextBlock Margin="12" Text="General settings" />
                                </via:XTabItem>
                                <via:XTabItem Header="Details">
                                    <TextBlock Margin="12" Text="Details" />
                                </via:XTabItem>
                            </via:XTabControl>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XTextBlock" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Typographic roles and semantic text variants." />
                            </via:XStackPanel>
                            <via:XStackPanel Spacing="6">
                                <via:XTextBlock Text="Title role" TextRole="SectionTitle" />
                                <via:XTextBlock Text="Description role for secondary text" TextRole="Description" />
                                <via:XTextBlock Text="Success message" TextRole="Success" />
                            </via:XStackPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XTextBox" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Text input with headers, descriptions, icons and validation chrome." />
                            </via:XStackPanel>
                            <via:XTextBox
                                Header="Name"
                                LeadingIcon="{via:MaterialIcon Kind=Magnify}"
                                Placeholder="Enter name" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XTimePicker" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Time input paired with the same form chrome as date controls." />
                            </via:XStackPanel>
                            <via:XTimePicker Header="Start time" Placeholder="Pick time" />
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XToggleButton" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Button-shaped boolean state with checked and unchecked icons." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XToggleButton
                                    CheckedIcon="{via:MaterialIcon Kind=Heart}"
                                    Content="Favorite"
                                    IsChecked="True"
                                    UncheckedIcon="{via:MaterialIcon Kind=HeartOutline}" />
                                <via:XToggleButton CheckedVariant="Primary" Content="Filter" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XToggleDropDown" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Toggle button with a small custom popup surface." />
                            </via:XStackPanel>
                            <via:XToggleDropDown
                                Content="Export"
                                DropDownPlacement="Bottom"
                                UncheckedIcon="{via:MaterialIcon Kind=ExportVariant}"
                                Variant="Primary">
                                <via:XToggleDropDown.DropDownContent>
                                    <via:XStackPanel
                                        MinWidth="170"
                                        Margin="10"
                                        Spacing="6">
                                        <via:XButton
                                            Appearance="Ghost"
                                            Content="Export as PDF"
                                            StretchContent="True" />
                                        <via:XButton
                                            Appearance="Ghost"
                                            Content="Export as Excel"
                                            StretchContent="True" />
                                    </via:XStackPanel>
                                </via:XToggleDropDown.DropDownContent>
                            </via:XToggleDropDown>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XToggleSwitch" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Boolean switch for settings and feature flags." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="8">
                                <via:XToggleSwitch Content="Notifications" />
                                <via:XToggleSwitch Content="Auto-save" IsChecked="True" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XToolbarPresenter" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Toolbar presenter for search and CRUD command contexts." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="10"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None">
                                <via:XGrid ColumnSpacing="10" Columns="220,Auto,Auto,Auto,Auto">
                                    <via:XSearchBox
                                        Width="220"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Placeholder="Search"
                                        Size="Small" />
                                    <via:XSeparator
                                        Grid.Column="1"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical" />
                                    <via:XIconButton
                                        Grid.Column="2"
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Icon="{via:MaterialIcon Kind=Plus}"
                                        ToolTip="New"
                                        Variant="Primary" />
                                    <via:XIconButton
                                        Grid.Column="3"
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Icon="{via:MaterialIcon Kind=PencilOutline}"
                                        ToolTip="Edit" />
                                    <via:XIconButton
                                        Grid.Column="4"
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Center"
                                        Icon="{via:MaterialIcon Kind=DeleteOutline}"
                                        ToolTip="Delete"
                                        Variant="Danger" />
                                </via:XGrid>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XTreeView" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Tree control with selection and optional drag/drop support." />
                            </via:XStackPanel>
                            <via:XTreeView Height="120">
                                <via:XTreeViewItem Header="Projects" IsExpanded="True">
                                    <via:XTreeViewItem Header="Dashboard" />
                                    <via:XTreeViewItem Header="Settings" />
                                </via:XTreeViewItem>
                            </via:XTreeView>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### U ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="U" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XUniformGrid" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Uniform item layout with spacing and explicit rows or columns." />
                            </via:XStackPanel>
                            <via:XUniformGrid
                                ColumnSpacing="8"
                                Columns="3"
                                RowSpacing="8">
                                <via:XBorder
                                    Padding="10"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="1" />
                                </via:XBorder>
                                <via:XBorder
                                    Padding="10"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="2" />
                                </via:XBorder>
                                <via:XBorder
                                    Padding="10"
                                    Appearance="Subtle"
                                    CornerRadius="6"
                                    Elevation="None">
                                    <TextBlock Text="3" />
                                </via:XBorder>
                            </via:XUniformGrid>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### V ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="V" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XValidationHintPopup" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Compact popup access to current validation messages." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Appearance="Subtle"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None"
                                Variant="Info">
                                <via:XStackPanel Orientation="Horizontal" Spacing="8">
                                    <via:XMaterialIcon Kind="InformationOutline" Size="18" />
                                    <TextBlock Text="Validation hint popup" />
                                </via:XStackPanel>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XValidationSummary" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Summary surface for validation errors, warnings and information." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Appearance="Subtle"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None"
                                Variant="Danger">
                                <via:XStackPanel Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="Validation summary" />
                                    <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="2 messages available" />
                                </via:XStackPanel>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XViewContainer" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="List/detail host for CRUD-style pages and overlay details." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None">
                                <via:XGrid ColumnSpacing="12" Columns="150,*">
                                    <via:XStackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="List" />
                                        <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Items" />
                                    </via:XStackPanel>
                                    <via:XStackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="Detail" />
                                        <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Editor area" />
                                    </via:XStackPanel>
                                </via:XGrid>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

            <!--#region ### W ###-->
            <via:XStackPanel Spacing="14">
                <TextBlock Style="{StaticResource OverviewLetterStyle}" Text="W" />
                <via:XSeparator Orientation="Horizontal" />

                <via:XWrapPanel HorizontalSpacing="18" VerticalSpacing="18">
                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XWindow" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Custom window chrome and host window for VIA applications." />
                            </via:XStackPanel>
                            <via:XBorder
                                Padding="12"
                                Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="None">
                                <via:XStackPanel Spacing="8">
                                    <via:XGrid ColumnSpacing="10" Columns="*,Auto">
                                        <TextBlock FontWeight="SemiBold" Text="Window title" />
                                        <via:XStackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <via:XBadge Appearance="Outline" Content="—" />
                                            <via:XBadge Appearance="Outline" Content="□" />
                                            <via:XBadge Appearance="Outline" Content="×" />
                                        </via:XStackPanel>
                                    </via:XGrid>
                                    <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="The full demo opens the real window surface." />
                                </via:XStackPanel>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XBorder Style="{StaticResource OverviewCardStyle}">
                        <via:XStackPanel Spacing="12">
                            <via:XStackPanel Spacing="3">
                                <TextBlock Style="{StaticResource OverviewCardTitleStyle}" Text="XWrapPanel" />
                                <TextBlock Style="{StaticResource OverviewCardTextStyle}" Text="Wrapping layout with horizontal and vertical spacing." />
                            </via:XStackPanel>
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XBadge Appearance="Outline" Content="Alpha" />
                                <via:XBadge Appearance="Outline" Content="Beta" />
                                <via:XBadge Appearance="Outline" Content="Gamma" />
                                <via:XBadge Appearance="Outline" Content="Delta" />
                                <via:XBadge Appearance="Outline" Content="Epsilon" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XWrapPanel>
            </via:XStackPanel>
            <!--#endregion-->

        </via:XStackPanel>
    </ScrollViewer>
</UserControl>
