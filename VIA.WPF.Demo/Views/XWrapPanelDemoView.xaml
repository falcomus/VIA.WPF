<UserControl
    x:Class="VIA.WPF.Demo.Views.XWrapPanelDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XWrapPanelDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="4,0,4,20"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="22">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XWrapPanel" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="880"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="A wrapping panel with horizontal and vertical spacing, optional fixed item size and horizontal or vertical wrapping direction."
                            TextRole="Description" />
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XStackPanel Spacing="12">
                        <via:XTextBlock Text="Responsive chip layout" TextRole="SectionTitle" />
                        <via:XTextBlock
                            IsMultiline="True"
                            Text="Resize the window and the items wrap while preserving consistent gaps. This is useful for filters, tags and command groups."
                            TextRole="Description" />

                        <via:XBorder
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XButton HorizontalAlignment="Left" Appearance="Subtle" Content="All" Icon="{via:BootstrapIcon Kind=CheckCircleFill}" Variant="Primary" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Available" Variant="Success" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Reserved" Variant="Warning" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Missing" Variant="Danger" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Warehouse A" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Warehouse B" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Needs check" Icon="{via:BootstrapIcon Kind=ExclamationTriangleFill}" Variant="Warning" />
                                <via:XButton HorizontalAlignment="Left" Appearance="Outline" Content="Recently changed" Icon="{via:BootstrapIcon Kind=ArrowClockwise}" Variant="Info" />
                            </via:XWrapPanel>
                        </via:XBorder>
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Fixed item size" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="ItemWidth and ItemHeight create dashboard-like tile rows with predictable dimensions."
                                        TextRole="Description" />
                                </via:XStackPanel>

                                <via:XWrapPanel
                                    HorizontalAlignment="Left"
                                    ItemHeight="92"
                                    ItemWidth="150"
                                    HorizontalSpacing="12"
                                    VerticalSpacing="12">
                                    <via:XBorder Padding="14" Appearance="Subtle" CornerRadius="6" Variant="Primary">
                                        <via:XStackPanel Spacing="4">
                                            <via:XTextBlock Text="128" TextRole="Heading" />
                                            <via:XTextBlock Text="Materials" TextRole="Caption" />
                                        </via:XStackPanel>
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="Subtle" CornerRadius="6" Variant="Success">
                                        <via:XStackPanel Spacing="4">
                                            <via:XTextBlock Text="94" TextRole="Heading" />
                                            <via:XTextBlock Text="Available" TextRole="Caption" />
                                        </via:XStackPanel>
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="Subtle" CornerRadius="6" Variant="Warning">
                                        <via:XStackPanel Spacing="4">
                                            <via:XTextBlock Text="17" TextRole="Heading" />
                                            <via:XTextBlock Text="Due checks" TextRole="Caption" />
                                        </via:XStackPanel>
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="Subtle" CornerRadius="6" Variant="Info">
                                        <via:XStackPanel Spacing="4">
                                            <via:XTextBlock Text="11" TextRole="Heading" />
                                            <via:XTextBlock Text="Bookings" TextRole="Caption" />
                                        </via:XStackPanel>
                                    </via:XBorder>
                                </via:XWrapPanel>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Vertical wrapping" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Vertical orientation fills top-to-bottom first and then starts a new column."
                                        TextRole="Description" />
                                </via:XStackPanel>

                                <via:XWrapPanel
                                    Height="230"
                                    HorizontalAlignment="Left"
                                    ItemHeight="42"
                                    ItemWidth="160"
                                    Orientation="Vertical"
                                    HorizontalSpacing="12"
                                    VerticalSpacing="10">
                                    <via:XButton HorizontalAlignment="Left" Content="Planning" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Goods in" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Goods out" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Transfer" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Inventory" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Checks" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="History" Appearance="Outline" />
                                    <via:XButton HorizontalAlignment="Left" Content="Reports" Appearance="Outline" />
                                </via:XWrapPanel>
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
