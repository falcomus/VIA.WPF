<UserControl
    x:Class="VIA.WPF.Demo.Views.XExperimentalDesignDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XExperimentalDesignDemoViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="WorkbenchSurfaceStyle" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.Surface}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource {x:Static via:XLayoutKeys.CornerRadiusLarge}}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

    </UserControl.Resources>

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="4,0,4,20"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="16">

                    <!-- Page header and integrated command bar -->
                    <via:XHeaderBar
                        Subtitle="Studio Dense composition with graphite surfaces, clear hierarchy and quiet Fluent command actions."
                        Title="Modern Workbench">
                        <via:XHeaderBar.Breadcrumb>
                            <via:XBreadcrumb>
                                <via:XBreadcrumbItem Content="Design system" />
                                <via:XBreadcrumbItem Content="Visual contract" />
                            </via:XBreadcrumb>
                        </via:XHeaderBar.Breadcrumb>
                        <via:XHeaderBar.Actions>
                            <via:XWrapPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                HorizontalSpacing="2"
                                VerticalSpacing="4">
                                <via:XButton
                                    Appearance="Ghost"
                                    Command="{Binding NewCommand}"
                                    Content="New"
                                    Icon="{via:BootstrapIcon Kind=Plus}"
                                    Size="Small" />
                                <via:XButton
                                    Appearance="Ghost"
                                    Command="{Binding RefreshCommand}"
                                    Content="Refresh"
                                    Icon="{via:BootstrapIcon Kind=ArrowClockwise}"
                                    Size="Small" />
                                <via:XMoreButton>
                                    <via:XMoreButton.Menu>
                                        <ContextMenu>
                                            <MenuItem Header="Export specimen" />
                                            <MenuItem Header="Reset options" />
                                        </ContextMenu>
                                    </via:XMoreButton.Menu>
                                </via:XMoreButton>
                            </via:XWrapPanel>
                        </via:XHeaderBar.Actions>
                    </via:XHeaderBar>

                    <!-- Semantic layer specimen -->
                    <via:XStackPanel Spacing="8">
                        <via:XGrid ColumnSpacing="12" Columns="*,Auto">
                            <via:XStackPanel Spacing="2">
                                <via:XTextBlock Text="Layer contract" TextRole="SectionTitle" />
                                <via:XTextBlock Text="Four purposeful layers replace decorative card stacks." TextRole="Description" />
                            </via:XStackPanel>
                            <via:XTextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="Canvas · Surface · Raised · Sunken"
                                TextRole="Caption" />
                        </via:XGrid>

                        <Border
                            Background="{DynamicResource {x:Static via:XBrushKeys.Canvas}}"
                            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource {x:Static via:XLayoutKeys.CornerRadiusLarge}}"
                            Padding="10">
                            <via:XUniformGrid Columns="4" ColumnSpacing="8">
                                <Border
                                    Padding="12"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.Canvas}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <via:XStackPanel Spacing="3">
                                        <via:XTextBlock Text="Canvas" TextRole="Label" />
                                        <via:XTextBlock Text="Page background" TextRole="Caption" />
                                    </via:XStackPanel>
                                </Border>
                                <Border
                                    Padding="12"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderSubtle}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <via:XStackPanel Spacing="3">
                                        <via:XTextBlock Text="Surface" TextRole="Label" />
                                        <via:XTextBlock Text="Standard content" TextRole="Caption" />
                                    </via:XStackPanel>
                                </Border>
                                <Border
                                    Padding="12"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceRaised}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <via:XStackPanel Spacing="3">
                                        <via:XTextBlock Text="Raised" TextRole="Label" />
                                        <via:XTextBlock Text="Popup or dialog" TextRole="Caption" />
                                    </via:XStackPanel>
                                </Border>
                                <Border
                                    Padding="12"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <via:XStackPanel Spacing="3">
                                        <via:XTextBlock Text="Sunken" TextRole="Label" />
                                        <via:XTextBlock Text="Recessed work area" TextRole="Caption" />
                                    </via:XStackPanel>
                                </Border>
                            </via:XUniformGrid>
                        </Border>
                    </via:XStackPanel>

                    <!-- Neutral metrics instead of colorful KPI cards -->
                    <Border Style="{StaticResource WorkbenchSurfaceStyle}" Padding="0">
                        <via:XAdaptiveGrid
                            ColumnSpacing="0"
                            MaxColumns="4"
                            MinItemWidth="150">
                            <via:XMetric Label="Active items" Value="128" />
                            <via:XMetric Label="Completed" SupportingText="On schedule" Value="94%" Variant="Success" />
                            <via:XMetric Label="Need review" Value="7" Variant="Warning" />
                            <via:XMetric BorderThickness="0" Label="Grid density" Value="28 px" />
                        </via:XAdaptiveGrid>
                    </Border>

                    <via:XGrid ColumnSpacing="14" Columns="2*,*">
                        <!-- Data group: commands belong to the group header -->
                        <via:XGroup
                            ContentPadding="0"
                            Subtitle="Actions stay attached to the data they affect."
                            Title="Categories">
                            <via:XGroup.Actions>
                                <via:XWrapPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    HorizontalSpacing="2">
                                    <via:XSearchBox
                                        Width="180"
                                        Placeholder="Search categories"
                                        SearchIcon="{via:BootstrapIcon Kind=Search}"
                                        Size="Small" />
                                    <via:XButton
                                        Appearance="Ghost"
                                        Command="{Binding NewCommand}"
                                        Content="New"
                                        Icon="{via:BootstrapIcon Kind=Plus}"
                                        Size="Small" />
                                    <via:XButton
                                        Appearance="Ghost"
                                        Command="{Binding RefreshCommand}"
                                        Icon="{via:BootstrapIcon Kind=ArrowClockwise}"
                                        Size="Small"
                                        ToolTip="Refresh" />
                                    <via:XMoreButton>
                                        <via:XMoreButton.Menu>
                                            <ContextMenu>
                                                <MenuItem Header="Duplicate category" />
                                                <MenuItem Header="Archive category" />
                                            </ContextMenu>
                                        </via:XMoreButton.Menu>
                                    </via:XMoreButton>
                                </via:XWrapPanel>
                            </via:XGroup.Actions>

                            <via:XDataGrid
                                Height="252"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding CategoryRows}"
                                SelectedItem="{Binding SelectedCategoryRow, Mode=TwoWay}">
                                <via:XDataGrid.Columns>
                                    <via:XDataGridTextColumn Width="90" Binding="{Binding Code}" Header="Code" />
                                    <via:XDataGridTextColumn Width="*" Binding="{Binding Category}" Header="Category" />
                                    <via:XDataGridTextColumn Width="120" Binding="{Binding Parent}" Header="Parent" />
                                    <via:XDataGridTextColumn Width="70" Binding="{Binding IsActive}" Header="Active" />
                                    <via:XDataGridTextColumn Width="90" Binding="{Binding Updated}" Header="Updated" />
                                </via:XDataGrid.Columns>
                            </via:XDataGrid>
                        </via:XGroup>

                        <via:XStackPanel Grid.Column="1" Spacing="14">
                            <!-- Dense field specimen -->
                            <via:XGroup Subtitle="30 px fields, 4 px radius, clear borders." Title="Dense form">
                                <via:XStackPanel Spacing="4">
                                    <via:XPropertyRow
                                        Description="Visible name in lists and menus"
                                        Label="Category name"
                                        LabelWidth="120">
                                        <via:XTextBox
                                            Placeholder="Enter a name"
                                            Text="{Binding SelectedCategoryRow.Category, Mode=TwoWay, TargetNullValue=''}" />
                                    </via:XPropertyRow>
                                    <via:XPropertyRow Label="Status" LabelWidth="120">
                                        <via:XComboBox
                                            CanClearSelection="True"
                                            ItemsSource="{Binding StatusOptions}"
                                            MaxVisibleItems="10"
                                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                                    </via:XPropertyRow>
                                    <via:XGrid ColumnSpacing="8" Columns="*,*">
                                        <via:XButton
                                            Appearance="Outline"
                                            Command="{Binding DeleteCommand}"
                                            Content="Delete"
                                            Variant="Danger" />
                                        <via:XButton
                                            Grid.Column="1"
                                            Command="{Binding SaveCommand}"
                                            Content="Save changes"
                                            Variant="Primary" />
                                    </via:XGrid>
                                </via:XStackPanel>
                            </via:XGroup>

                            <!-- Empty state without a decorative placeholder card -->
                            <via:XGroup ContentPadding="0" Title="Archived">
                                <via:XContentStatePresenter
                                    EmptyContent="Archived entries will appear here."
                                    State="Empty" />
                            </via:XGroup>
                        </via:XStackPanel>
                    </via:XGrid>

                    <!-- State matrix -->
                    <via:XGroup
                        Subtitle="Rest, hover, focus, selected and disabled must remain distinguishable in both themes."
                        Title="State differentiation">
                        <via:XStackPanel Spacing="10">
                            <via:XInfoBar
                                IsClosable="True"
                                Message="Semantic colors communicate meaning; commands remain visually quiet."
                                Title="Workbench guidance"
                                Variant="Info" />
                            <via:XWrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <via:XButton Content="Default" />
                                <via:XButton Appearance="Outline" Content="Outline" />
                                <via:XButton Appearance="Ghost" Content="Quiet command" />
                                <via:XButton Content="Primary" Variant="Primary" />
                                <via:XButton Appearance="Outline" Content="Delete" Variant="Danger" />
                                <via:XButton Content="Disabled" IsEnabled="False" />
                            </via:XWrapPanel>
                        </via:XStackPanel>
                    </via:XGroup>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
