<UserControl
    x:Class="VIA.WPF.Demo.Views.XSecurePasswordBoxDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XSecurePasswordBoxDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="18">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XSecurePasswordBox" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="920"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="Secure password input for forms that should avoid exposing the value through a bindable string property."
                            TextRole="Description"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XGrid Columns="*,*" ColumnSpacing="18" RowSpacing="18">
                        <via:XBorder
                            Padding="20"
                            Appearance="Solid"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Secure entry" TextRole="SectionTitle" />
                                <via:XSecurePasswordBox
                                    Width="360"
                                    HorizontalAlignment="Left"
                                    Description="The value remains inside the PasswordBox while the control exposes state such as PasswordLength and HasPassword."
                                    HasRevealButton="True"
                                    Header="Account password"
                                    LeadingIcon="{via:BootstrapIcon Kind=ShieldLockFill}"
                                    Placeholder="Enter password" />

                                <via:XBorder
                                    Padding="12"
                                    Appearance="Subtle"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Variant="Info">
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Use PasswordChanged when the hosting view needs to react without storing the password in the view model."
                                        TextRole="Description"
                                        TextWrapping="Wrap" />
                                </via:XBorder>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            Appearance="Solid"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Sizes and states" TextRole="SectionTitle" />
                                <via:XSecurePasswordBox
                                    Width="320"
                                    HorizontalAlignment="Left"
                                    Header="Small"
                                    LeadingIcon="{via:BootstrapIcon Kind=KeyFill}"
                                    Placeholder="Compact secure input"
                                    Size="Small" />
                                <via:XSecurePasswordBox
                                    Width="380"
                                    HorizontalAlignment="Left"
                                    Description="Large fields work well in login or setup screens."
                                    Header="Large secure password"
                                    LeadingIcon="{via:BootstrapIcon Kind=LockFill}"
                                    Placeholder="Large password"
                                    Size="Large" />
                                <via:XSecurePasswordBox
                                    Width="340"
                                    HorizontalAlignment="Left"
                                    Header="Disabled"
                                    IsEnabled="False"
                                    LeadingIcon="{via:BootstrapIcon Kind=ShieldLockFill}"
                                    Placeholder="Disabled" />
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
