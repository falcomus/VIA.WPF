<UserControl
    x:Class="VIA.WPF.Demo.Views.XConvertersDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XConvertersDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="4,0,4,20"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="22">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="Converters" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="880"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="Markup-friendly converters cover the small but common WPF glue work: boolean states, visibility, grid lengths, equality checks, null checks and collection state."
                            TextRole="Description"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XGrid ColumnSpacing="18" Columns="320,*">
                        <via:XBorder
                            Padding="18"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="12">
                                <via:XTextBlock Text="Interactive inputs" TextRole="SectionTitle" />
                                <via:XTextBlock
                                    IsMultiline="True"
                                    Text="Toggle and change values here. The cards on the right react through converter markup."
                                    TextRole="Description"
                                    TextWrapping="Wrap" />

                                <via:XCheckBox Content="Show details" IsChecked="{Binding ShowDetails, Mode=TwoWay}" />

                                <via:XComboBox
                                    Width="240"
                                    HorizontalAlignment="Left"
                                    Header="Mode"
                                    ItemsSource="{Binding Modes}"
                                    SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />

                                <via:XButton
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddMessageCommand}"
                                    Content="Add message"
                                    Icon="{via:BootstrapIcon Kind=PlusCircleFill}"
                                    Variant="Primary" />

                                <via:XButton
                                    HorizontalAlignment="Left"
                                    Appearance="Outline"
                                    Command="{Binding ClearMessagesCommand}"
                                    Content="Clear messages"
                                    Variant="Danger" />
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XStackPanel Grid.Column="1" Spacing="18">
                            <via:XGrid ColumnSpacing="18" Columns="*,*">
                                <via:XBorder
                                    Padding="18"
                                    Appearance="VerySubtle"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Elevation="Low">
                                    <via:XStackPanel Spacing="10">
                                        <via:XTextBlock Text="BooleanToVisibility" TextRole="SectionTitle" />
                                        <via:XTextBlock
                                            IsMultiline="True"
                                            Text="This hint is shown only when the checkbox is active."
                                            TextRole="Description"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ShowDetails, Converter={via:BooleanToVisibility}}" />
                                        <via:XTextBlock
                                            IsMultiline="True"
                                            Text="Visibility=&quot;{Binding ShowDetails, Converter={via:BooleanToVisibility}}&quot;"
                                            TextRole="Code"
                                            TextWrapping="Wrap" />
                                    </via:XStackPanel>
                                </via:XBorder>

                                <via:XBorder
                                    Grid.Column="1"
                                    Padding="18"
                                    Appearance="VerySubtle"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Elevation="Low">
                                    <via:XStackPanel Spacing="10">
                                        <via:XTextBlock Text="EqualityToVisibility" TextRole="SectionTitle" />
                                        <via:XTextBlock
                                            Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}"
                                            Text="Edit-only hint"
                                            TextRole="Label"
                                            Visibility="{Binding SelectedMode, Converter={via:EqualityToVisibility}, ConverterParameter=Edit}" />
                                        <via:XTextBlock
                                            IsMultiline="True"
                                            Text="Useful for view modes, editor modes and compact state-specific hints."
                                            TextRole="Description"
                                            TextWrapping="Wrap" />
                                    </via:XStackPanel>
                                </via:XBorder>
                            </via:XGrid>

                            <via:XBorder
                                Padding="18"
                                Appearance="VerySubtle"
                                BorderThickness="1"
                                CornerRadius="8"
                                Elevation="Low">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{Binding ShowDetails, Converter={via:BooleanToGridLength}, ConverterParameter='260|0'}" />
                                    </Grid.ColumnDefinitions>

                                    <via:XStackPanel Spacing="8">
                                        <via:XTextBlock Text="BooleanToGridLength" TextRole="SectionTitle" />
                                        <via:XTextBlock
                                            IsMultiline="True"
                                            Text="The detail column collapses to zero width when Show details is unchecked."
                                            TextRole="Description"
                                            TextWrapping="Wrap" />
                                    </via:XStackPanel>

                                    <via:XBorder
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        Padding="14"
                                        Appearance="Subtle"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Variant="Info">
                                        <via:XStackPanel Spacing="6">
                                            <via:XTextBlock Text="Details" TextRole="SectionTitle" />
                                            <via:XTextBlock Text="This panel is layout-driven." TextRole="Caption" />
                                        </via:XStackPanel>
                                    </via:XBorder>
                                </Grid>
                            </via:XBorder>

                            <via:XBorder
                                Padding="18"
                                Appearance="VerySubtle"
                                BorderThickness="1"
                                CornerRadius="8"
                                Elevation="Low">
                                <via:XStackPanel Spacing="10">
                                    <via:XTextBlock Text="Collection state" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Messages are shown when the collection contains items. Empty-state text appears when it does not."
                                        TextRole="Description"
                                        TextWrapping="Wrap" />
                                    <via:XTextBlock
                                        Text="No messages yet."
                                        TextRole="Caption"
                                        Visibility="{Binding Messages, Converter={via:CollectionEmptyToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Messages}" Visibility="{Binding Messages, Converter={via:CollectionNotEmptyToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <via:XTextBlock Margin="0,2" Text="{Binding}" TextRole="Label" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </via:XStackPanel>
                            </via:XBorder>
                        </via:XStackPanel>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
