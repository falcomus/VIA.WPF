<UserControl
    x:Class="VIA.WPF.Demo.Views.XBorderDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XBorderDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="18">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="Themed surfaces" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="900"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="XBorder is the base card and notice surface. Use it for panels, callouts, metric tiles and compact content blocks that should follow the current VIA theme."
                            TextRole="Description"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XBorder
                        Padding="20"
                        Appearance="VerySubtle"
                        BorderThickness="1"
                        CornerRadius="8"
                        Elevation="Low">
                        <via:XStackPanel Spacing="14">
                            <via:XTextBlock Text="Semantic variants" TextRole="SectionTitle" />
                            <via:XTextBlock
                                IsMultiline="True"
                                Text="Variant and appearance map the same layout to different theme palettes without changing the card content."
                                TextRole="Description"
                                TextWrapping="Wrap" />

                            <via:XUniformGrid ColumnSpacing="10" Columns="3" RowSpacing="10">
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Default">
                                    <via:XTextBlock Text="Default" />
                                </via:XBorder>
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Primary">
                                    <via:XTextBlock Text="Primary" />
                                </via:XBorder>
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Accent">
                                    <via:XTextBlock Text="Accent" />
                                </via:XBorder>
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Success">
                                    <via:XTextBlock Text="Success" />
                                </via:XBorder>
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Warning">
                                    <via:XTextBlock Text="Warning" />
                                </via:XBorder>
                                <via:XBorder Appearance="VerySubtle" BorderThickness="1" CornerRadius="8" Padding="14" Variant="Danger">
                                    <via:XTextBlock Text="Danger" />
                                </via:XBorder>
                            </via:XUniformGrid>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XGrid Columns="*,*" ColumnSpacing="16">
                        <via:XBorder
                            Padding="20"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="12">
                                <via:XTextBlock Text="Elevation" TextRole="SectionTitle" />
                                <via:XBorder Padding="14" Appearance="Solid" BorderThickness="1" CornerRadius="6" Elevation="None">
                                    <via:XTextBlock Text="No shadow" />
                                </via:XBorder>
                                <via:XBorder Padding="14" Appearance="Solid" BorderThickness="1" CornerRadius="6" Elevation="Low">
                                    <via:XTextBlock Text="Low elevation" />
                                </via:XBorder>
                                <via:XBorder Padding="14" Appearance="Solid" BorderThickness="1" CornerRadius="6" Elevation="Medium">
                                    <via:XTextBlock Text="Medium elevation" />
                                </via:XBorder>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="12">
                                <via:XTextBlock Text="Callout card" TextRole="SectionTitle" />
                                <via:XTextBlock
                                    IsMultiline="True"
                                    Text="Use compact cards for contextual information. Inner surfaces usually use CornerRadius 6 and no elevation."
                                    TextRole="Description"
                                    TextWrapping="Wrap" />
                                <via:XBorder Padding="14" Appearance="Subtle" BorderThickness="1" CornerRadius="6" Variant="Info">
                                    <via:XGrid Columns="Auto,*" ColumnSpacing="10">
                                        <ContentControl Content="{via:BootstrapIcon Kind=InfoCircleFill}" VerticalAlignment="Top" />
                                        <via:XTextBlock
                                            Grid.Column="1"
                                            IsMultiline="True"
                                            Text="This card follows the active theme and keeps icon, text and border colors consistent."
                                            TextWrapping="Wrap" />
                                    </via:XGrid>
                                </via:XBorder>
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
