<UserControl x:Class="VIA.WPF.Demo.Views.XZoomSliderDemoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:via="http://schemas.via.dev/wpf" xmlns:views="clr-namespace:VIA.WPF.Demo.Views">
  <views:DemoPageViewBase><views:DemoPageViewBase.PreviewContent><via:XStackPanel Spacing="16"><via:XTextBlock Text="XZoomSlider" TextRole="Title" /><via:XTextBlock Text="A compact zoom control for canvases and workbenches. The reset button returns to 100%, clamped to the configured range." TextRole="Description" /><via:XBorder Padding="20" BorderThickness="1" Elevation="Low"><via:XStackPanel Spacing="12"><via:XTextBlock Text="Continuous (1% steps)" TextRole="Label" /><via:XZoomSlider MaxZoomPercent="200" MinZoomPercent="50" ShowValueHint="True" TickFrequency="10" ZoomPercent="{Binding ZoomPercent, Mode=TwoWay}" /><via:XTextBlock Text="{Binding ZoomPercent, StringFormat=Current zoom: {0}%}" TextRole="Description" /><via:XTextBlock Text="Discrete (25% steps)" TextRole="Label" /><via:XZoomSlider IsSnapToTickEnabled="True" MaxZoomPercent="150" MinZoomPercent="25" ResetValue="100" ShowResetButton="False" TickFrequency="25" ZoomPercent="75" /></via:XStackPanel></via:XBorder></via:XStackPanel></views:DemoPageViewBase.PreviewContent></views:DemoPageViewBase>
</UserControl>
