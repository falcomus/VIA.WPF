<UserControl
    x:Class="VIA.WPF.Demo.Views.XHeaderBarDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XHeaderBarDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,10,0" Spacing="16">
                    <via:XInfoBar
                        Message="XHeaderBar is a dense workbench command strip. XHeaderGroup provides optional labels and optional separators."
                        Title="Workbench commandbar"
                        Variant="Info" />

                    <via:XGroup
                        ContentPadding="0"
                        HeaderPadding="14,10"
                        Title="Full-width commandbar">
                        <via:XHeaderBar TitleWidth="0">
                            <via:XHeaderBar.MoreMenu>
                                <ContextMenu>
                                    <MenuItem Header="Runtime diagnostics" />
                                    <MenuItem Header="Reset workspace" />
                                </ContextMenu>
                            </via:XHeaderBar.MoreMenu>

                            <via:XHeaderBar.Actions>
                                <via:XStackPanel Orientation="Horizontal" Spacing="5">
                                    <via:XButton Content="CPU 6.8 ms" Size="Small" />
                                    <via:XButton Content="148 FPS" Size="Small" />
                                </via:XStackPanel>
                            </via:XHeaderBar.Actions>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <via:XHeaderGroup Header="View">
                                    <via:XStackPanel Orientation="Horizontal" Spacing="5">
                                        <via:XButtonGroup SelectedValue="Navigator" Size="Small">
                                            <via:XButtonGroupItem Content="Navigator" Value="Navigator" />
                                            <via:XButtonGroupItem Content="Inspector" Value="Inspector" />
                                        </via:XButtonGroup>
                                        <via:XButton Content="Fit" Size="Small" />
                                        <via:XButton Content="Center" Size="Small" />
                                        <via:XButton Content="Follow" Size="Small" Variant="Primary" />
                                    </via:XStackPanel>
                                </via:XHeaderGroup>

                                <via:XHeaderGroup Grid.Column="1" Header="Layout">
                                    <via:XStackPanel Orientation="Horizontal" Spacing="5">
                                        <via:XButton Content="Direction" Size="Small" />
                                        <via:XComboBox Width="112" SelectedIndex="0" Size="Small">
                                            <via:XComboBoxItem Content="High" />
                                            <via:XComboBoxItem Content="Medium" />
                                            <via:XComboBoxItem Content="Low" />
                                        </via:XComboBox>
                                    </via:XStackPanel>
                                </via:XHeaderGroup>

                                <via:XHeaderGroup Grid.Column="2" Header="Edges">
                                    <via:XComboBox Width="118" SelectedIndex="0" Size="Small">
                                        <via:XComboBoxItem Content="Spline" />
                                        <via:XComboBoxItem Content="Straight" />
                                        <via:XComboBoxItem Content="Bezier" />
                                    </via:XComboBox>
                                </via:XHeaderGroup>

                                <via:XHeaderGroup
                                    Grid.Column="3"
                                    Header="Runtime"
                                    HorizontalContentAlignment="Right"
                                    IsSeparatorVisible="False">
                                    <via:XButton Content="Light" Size="Small" />
                                </via:XHeaderGroup>
                            </Grid>
                        </via:XHeaderBar>
                    </via:XGroup>

                    <via:XAdaptiveGrid ColumnSpacing="14" MaxColumns="2" MinItemWidth="360" RowSpacing="14">
                        <via:XGroup
                            ContentPadding="0"
                            HeaderPadding="14,10"
                            Subtitle="Compact search and view switching without unused command space."
                            Title="Minimal strip">
                            <via:XHeaderBar TitleWidth="0">
                                <via:XStackPanel Orientation="Horizontal">
                                    <via:XHeaderGroup Header="Search">
                                        <via:XSearchBox
                                            Width="230"
                                            Placeholder="Search"
                                            Size="Small"
                                            Text="{Binding SearchContext.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </via:XHeaderGroup>
                                    <via:XHeaderGroup Header="View" IsSeparatorVisible="False">
                                        <via:XButtonGroup ItemMinWidth="38" SelectedValue="Grid" Size="Small">
                                            <via:XButtonGroupItem Content="Grid" Value="Grid" />
                                            <via:XButtonGroupItem Content="List" Value="List" />
                                        </via:XButtonGroup>
                                    </via:XHeaderGroup>
                                </via:XStackPanel>
                            </via:XHeaderBar>
                        </via:XGroup>

                        <via:XGroup
                            ContentPadding="0"
                            HeaderPadding="14,10"
                            Subtitle="Header labels are optional. This group only contributes its controls and separator."
                            Title="Group without label">
                            <via:XHeaderBar TitleWidth="0">
                                <via:XStackPanel Orientation="Horizontal">
                                    <via:XHeaderGroup Header="Commands">
                                        <via:XStackPanel Orientation="Horizontal" Spacing="5">
                                            <via:XButton Content="New" Size="Small" />
                                            <via:XButton Content="Refresh" Size="Small" />
                                        </via:XStackPanel>
                                    </via:XHeaderGroup>
                                    <via:XHeaderGroup Header="" IsSeparatorVisible="False">
                                        <via:XMoreButton>
                                            <via:XMoreButton.Menu>
                                                <ContextMenu>
                                                    <MenuItem Header="Export" />
                                                    <MenuItem Header="Reset" />
                                                </ContextMenu>
                                            </via:XMoreButton.Menu>
                                        </via:XMoreButton>
                                    </via:XHeaderGroup>
                                </via:XStackPanel>
                            </via:XHeaderBar>
                        </via:XGroup>
                    </via:XAdaptiveGrid>

                    <via:XGroup
                        HeaderPadding="14,10"
                        Subtitle="XHeaderGroup owns the group label and separator; XHeaderBar owns title, content, actions and optional MoreMenu."
                        Title="Composition contract">
                        <via:XAdaptiveGrid ColumnSpacing="0" MaxColumns="4" MinItemWidth="170">
                            <via:XMetric Label="Title" SupportingText="Optional, no empty space" Value="Bar" />
                            <via:XMetric Label="Group label" SupportingText="Optional header slot" Value="Group" />
                            <via:XMetric Label="Separator" SupportingText="IsSeparatorVisible" Value="Group" />
                            <via:XMetric Label="VDots" SupportingText="MoreMenu slot" Value="Bar" />
                        </via:XAdaptiveGrid>
                    </via:XGroup>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
