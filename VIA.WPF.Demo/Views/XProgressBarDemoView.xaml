<UserControl
    x:Class="VIA.WPF.Demo.Views.XProgressBarDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XProgressBarDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="8,0,12,22"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Spacing="18">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XProgressBar" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="880"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="Progress feedback for determinate values, indeterminate background work and semantic status reporting. Use variants first; custom brushes are still available for special cases."
                            TextRole="Description"
                            TextWrapping="Wrap" />
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Grid.Column="0"
                            Padding="18"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low"
                            Variant="Primary">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Bound determinate progress" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="The value is bound to the view model and can be changed through commands."
                                        TextRole="Description"
                                        TextWrapping="Wrap" />
                                </via:XStackPanel>

                                <via:XProgressBar
                                    Header="Export progress"
                                    Description="Shown with value display and primary color."
                                    Maximum="100"
                                    Minimum="0"
                                    ShowValue="True"
                                    Value="{Binding ExportProgress, Mode=TwoWay}"
                                    ValueFormatString="F0"
                                    Variant="Primary" />

                                <via:XTextBlock
                                    Text="{Binding ExportProgressSummary}"
                                    TextRole="Description"
                                    TextWrapping="Wrap" />

                                <via:XWrapPanel HorizontalAlignment="Left" HorizontalSpacing="10" VerticalSpacing="10">
                                    <via:XButton
                                        Appearance="Outline"
                                        Command="{Binding DecreaseProgressCommand}"
                                        Content="-10"
                                        Icon="{via:BootstrapIcon Kind=DashCircle}"
                                        Size="Small" />
                                    <via:XButton
                                        Command="{Binding IncreaseProgressCommand}"
                                        Content="+10"
                                        Icon="{via:BootstrapIcon Kind=PlusCircleFill}"
                                        Size="Small"
                                        Variant="Primary" />
                                    <via:XButton
                                        Appearance="Subtle"
                                        Command="{Binding ResetProgressCommand}"
                                        Content="Reset"
                                        Icon="{via:BootstrapIcon Kind=ArrowCounterclockwise}"
                                        Size="Small"
                                        Variant="Accent" />
                                </via:XWrapPanel>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="18"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low"
                            Variant="Info">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Indeterminate work" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Use IsIndeterminate when the operation is active but the remaining duration is unknown."
                                        TextRole="Description"
                                        TextWrapping="Wrap" />
                                </via:XStackPanel>

                                <via:XProgressBar
                                    Header="Background sync"
                                    Description="Refreshing metadata and rebuilding cache."
                                    IsIndeterminate="True"
                                    ShowValue="False"
                                    Variant="Info" />
                                <via:XProgressBar
                                    Header="Neutral queue"
                                    Description="Waiting for worker availability."
                                    IsIndeterminate="True"
                                    ShowValue="False"
                                    Variant="Default" />
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>

                    <via:XBorder
                        Padding="18"
                        Appearance="VerySubtle"
                        BorderThickness="1"
                        CornerRadius="8"
                        Elevation="Low">
                        <via:XStackPanel Spacing="14">
                            <via:XStackPanel Spacing="4">
                                <via:XTextBlock Text="Sizes and track thickness" TextRole="SectionTitle" />
                                <via:XTextBlock
                                    IsMultiline="True"
                                    Text="Size presets are useful for forms and settings. TrackThickness can be used for dashboards or more prominent progress feedback."
                                    TextRole="Description"
                                    TextWrapping="Wrap" />
                            </via:XStackPanel>

                            <via:XGrid ColumnSpacing="18" Columns="*,*,*">
                                <via:XStackPanel Grid.Column="0" Spacing="10">
                                    <via:XProgressBar Header="Small" Maximum="100" Minimum="0" ShowValue="True" Size="Small" Value="35" Variant="Info" />
                                    <via:XProgressBar Header="Thin" Maximum="100" Minimum="0" ShowValue="True" TrackThickness="4" Value="45" Variant="Info" />
                                </via:XStackPanel>

                                <via:XStackPanel Grid.Column="1" Spacing="10">
                                    <via:XProgressBar Header="Medium" Maximum="100" Minimum="0" ShowValue="True" Size="Medium" Value="55" Variant="Primary" />
                                    <via:XProgressBar Header="Default" Maximum="100" Minimum="0" ShowValue="True" Value="58" Variant="Primary" />
                                </via:XStackPanel>

                                <via:XStackPanel Grid.Column="2" Spacing="10">
                                    <via:XProgressBar Header="Large" Maximum="100" Minimum="0" ShowValue="True" Size="Large" Value="75" Variant="Accent" />
                                    <via:XProgressBar Header="Thick" Maximum="100" Minimum="0" ShowValue="True" TrackThickness="14" Value="65" Variant="Accent" />
                                </via:XStackPanel>
                            </via:XGrid>
                        </via:XStackPanel>
                    </via:XBorder>

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Grid.Column="0"
                            Padding="18"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Semantic variants" TextRole="SectionTitle" />
                                <via:XProgressBar Header="Default" Maximum="100" Minimum="0" ShowValue="True" Value="30" Variant="Default" />
                                <via:XProgressBar Header="Primary" Maximum="100" Minimum="0" ShowValue="True" Value="42" Variant="Primary" />
                                <via:XProgressBar Header="Accent" Maximum="100" Minimum="0" ShowValue="True" Value="58" Variant="Accent" />
                                <via:XProgressBar Header="Info" Maximum="100" Minimum="0" ShowValue="True" Value="66" Variant="Info" />
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="18"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XTextBlock Text="Operational states" TextRole="SectionTitle" />
                                <via:XProgressBar Header="Build complete" Maximum="100" Minimum="0" ShowValue="True" Value="100" Variant="Success" />
                                <via:XProgressBar Header="Waiting for server" IsEnabled="False" Maximum="100" Minimum="0" ShowValue="True" Value="40" Variant="Warning" />
                                <via:XProgressBar Header="Validation" Maximum="100" Minimum="0" ShowValue="True" Value="68" Variant="Info" />
                                <via:XProgressBar Header="Deployment failed" Maximum="100" Minimum="0" ShowValue="True" Value="12" Variant="Danger" />
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>

                    <via:XBorder
                        Padding="18"
                        Appearance="VerySubtle"
                        BorderThickness="1"
                        CornerRadius="8"
                        Elevation="Low"
                        Variant="Accent">
                        <via:XStackPanel Spacing="14">
                            <via:XTextBlock Text="Custom brush override" TextRole="SectionTitle" />
                            <via:XTextBlock
                                IsMultiline="True"
                                Text="Use ProgressBrush and TrackBrush only when semantic variants are not enough."
                                TextRole="Description"
                                TextWrapping="Wrap" />
                            <via:XProgressBar
                                Header="Custom branded process"
                                Maximum="100"
                                Minimum="0"
                                ProgressBrush="{DynamicResource {x:Static via:XBrushKeys.Accent}}"
                                ShowValue="True"
                                TrackBrush="{DynamicResource {x:Static via:XBrushKeys.SurfaceLight}}"
                                Value="72" />
                        </via:XStackPanel>
                    </via:XBorder>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
