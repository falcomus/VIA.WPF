<UserControl
    x:Class="VIA.WPF.Demo.Views.XUniformGridDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:VIA.WPF.Demo.ViewModels"
    xmlns:views="clr-namespace:VIA.WPF.Demo.Views"
    xmlns:via="http://schemas.via.dev/wpf"
    d:DataContext="{d:DesignInstance Type=viewmodels:XUniformGridDemoViewModel}"
    mc:Ignorable="d">

    <views:DemoPageViewBase>
        <views:DemoPageViewBase.PreviewContent>
            <ScrollViewer
                Padding="4,0,4,20"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <via:XStackPanel Margin="0,0,12,0" Spacing="22">

                    <via:XStackPanel Spacing="8">
                        <via:XTextBlock Text="XUniformGrid" TextRole="Title" />
                        <via:XTextBlock
                            MaxWidth="880"
                            HorizontalAlignment="Left"
                            IsMultiline="True"
                            Text="Arranges visible children in equally sized cells with automatic or explicit row and column counts plus consistent spacing."
                            TextRole="Description" />
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XStackPanel Spacing="12">
                        <via:XTextBlock Text="Automatic dimensions" TextRole="SectionTitle" />
                        <via:XTextBlock
                            IsMultiline="True"
                            Text="When Rows and Columns are both 0, XUniformGrid calculates a balanced layout from the visible children."
                            TextRole="Description" />

                        <via:XBorder
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XUniformGrid MinHeight="190" Spacing="12">
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Primary">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Materials" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Master data" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Accent">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Warehouses" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Locations" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Success">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Bookings" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Movements" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Info">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Checks" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Due dates" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Warning">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Reports" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Overview" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                                <via:XBorder Padding="16" Appearance="Subtle" CornerRadius="6" Variant="Default">
                                    <via:XStackPanel Spacing="5">
                                        <via:XTextBlock Text="Settings" TextRole="Subtitle" />
                                        <via:XTextBlock Text="Configuration" TextRole="Caption" />
                                    </via:XStackPanel>
                                </via:XBorder>
                            </via:XUniformGrid>
                        </via:XBorder>
                    </via:XStackPanel>

                    <via:XSeparator Orientation="Horizontal" />

                    <via:XGrid ColumnSpacing="18" Columns="*,*">
                        <via:XBorder
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Explicit columns" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Set Columns or Rows when the surface should keep a specific rhythm."
                                        TextRole="Description" />
                                </via:XStackPanel>

                                <via:XUniformGrid Columns="3" MinHeight="150" Spacing="10">
                                    <via:XButton Content="Small" Size="Small" HorizontalAlignment="Stretch" />
                                    <via:XButton Content="Medium" Size="Medium" HorizontalAlignment="Stretch" Variant="Primary" />
                                    <via:XButton Content="Large" Size="Large" HorizontalAlignment="Stretch" Variant="Accent" />
                                    <via:XButton Content="Outline" Appearance="Outline" HorizontalAlignment="Stretch" />
                                    <via:XButton Content="Subtle" Appearance="Subtle" HorizontalAlignment="Stretch" Variant="Info" />
                                    <via:XButton Content="Ghost" Appearance="Ghost" HorizontalAlignment="Stretch" />
                                </via:XUniformGrid>
                            </via:XStackPanel>
                        </via:XBorder>

                        <via:XBorder
                            Grid.Column="1"
                            Padding="20"
                            CornerRadius="8"
                            Elevation="Low">
                            <via:XStackPanel Spacing="14">
                                <via:XStackPanel Spacing="4">
                                    <via:XTextBlock Text="Separate row and column spacing" TextRole="SectionTitle" />
                                    <via:XTextBlock
                                        IsMultiline="True"
                                        Text="Use RowSpacing and ColumnSpacing separately when vertical and horizontal rhythm should differ."
                                        TextRole="Description" />
                                </via:XStackPanel>

                                <via:XUniformGrid
                                    Columns="2"
                                    MinHeight="190"
                                    RowSpacing="16"
                                    ColumnSpacing="8">
                                    <via:XBorder Padding="14" Appearance="VerySubtle" CornerRadius="6" Variant="Primary">
                                        <via:XTextBlock Text="A1" TextRole="Subtitle" />
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="VerySubtle" CornerRadius="6" Variant="Primary">
                                        <via:XTextBlock Text="A2" TextRole="Subtitle" />
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="VerySubtle" CornerRadius="6" Variant="Info">
                                        <via:XTextBlock Text="B1" TextRole="Subtitle" />
                                    </via:XBorder>
                                    <via:XBorder Padding="14" Appearance="VerySubtle" CornerRadius="6" Variant="Info">
                                        <via:XTextBlock Text="B2" TextRole="Subtitle" />
                                    </via:XBorder>
                                </via:XUniformGrid>
                            </via:XStackPanel>
                        </via:XBorder>
                    </via:XGrid>
                </via:XStackPanel>
            </ScrollViewer>
        </views:DemoPageViewBase.PreviewContent>
    </views:DemoPageViewBase>
</UserControl>
