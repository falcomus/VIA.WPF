<UserControl
    x:Class="VIA.WPF.Controls.XColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    x:Name="Root"
    MinWidth="400"
    Background="Transparent"
    SnapsToDevicePixels="True">

    <Grid Margin="0">
        <Grid.Resources>
            <Style x:Key="ColorChannelLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Width" Value="22" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="ColorChannelSliderStyle" TargetType="{x:Type controls:XSlider}">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="255" />
                <Setter Property="SmallChange" Value="1" />
                <Setter Property="LargeChange" Value="16" />
                <Setter Property="ShowValue" Value="False" />
                <Setter Property="TickFrequency" Value="1" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ColorChannelNumberBoxStyle" TargetType="{x:Type controls:XNumberBox}">
                <Setter Property="Width" Value="92" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="255" />
                <Setter Property="Step" Value="1" />
                <Setter Property="FormatString" Value="0" />
                <Setter Property="ShowSpinnerButtons" Value="True" />
                <Setter Property="Size" Value="Medium" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:XCheckerBoard
            Grid.Column="0"
            Height="210"
            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Border}}"
            BorderThickness="1"
            CheckerSize="8"
            CornerRadius="8">
            <Rectangle RadiusX="8" RadiusY="8">
                <Rectangle.Fill>
                    <SolidColorBrush Color="{Binding SelectedColor, ElementName=Root}" />
                </Rectangle.Fill>
            </Rectangle>
        </controls:XCheckerBoard>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColorChannelLabelStyle}" Text="R" />
                <controls:XSlider
                    x:Name="PART_RedSlider"
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Style="{StaticResource ColorChannelSliderStyle}"
                    Value="{Binding Red, ElementName=Root, Mode=TwoWay}" />
                <controls:XNumberBox
                    x:Name="PART_RedNumberBox"
                    Grid.Column="2"
                    MinWidth="0"
                    Style="{StaticResource ColorChannelNumberBoxStyle}"
                    Text="{Binding Red, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColorChannelLabelStyle}" Text="G" />
                <controls:XSlider
                    x:Name="PART_GreenSlider"
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Style="{StaticResource ColorChannelSliderStyle}"
                    Value="{Binding Green, ElementName=Root, Mode=TwoWay}" />
                <controls:XNumberBox
                    x:Name="PART_GreenNumberBox"
                    Grid.Column="2"
                    Style="{StaticResource ColorChannelNumberBoxStyle}"
                    Text="{Binding Green, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColorChannelLabelStyle}" Text="B" />
                <controls:XSlider
                    x:Name="PART_BlueSlider"
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Style="{StaticResource ColorChannelSliderStyle}"
                    Value="{Binding Blue, ElementName=Root, Mode=TwoWay}" />
                <controls:XNumberBox
                    x:Name="PART_BlueNumberBox"
                    Grid.Column="2"
                    Style="{StaticResource ColorChannelNumberBoxStyle}"
                    Text="{Binding Blue, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource ColorChannelLabelStyle}" Text="A" />
                <controls:XSlider
                    x:Name="PART_AlphaSlider"
                    Grid.Column="1"
                    Margin="0,0,15,0"
                    Style="{StaticResource ColorChannelSliderStyle}"
                    Value="{Binding Alpha, ElementName=Root, Mode=TwoWay}" />
                <controls:XNumberBox
                    x:Name="PART_AlphaNumberBox"
                    Grid.Column="2"
                    Style="{StaticResource ColorChannelNumberBoxStyle}"
                    Text="{Binding Alpha, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                    Text="Hex" />
                <controls:XTextBox
                    x:Name="PART_HexTextBox"
                    Grid.Column="1"
                    VerticalContentAlignment="Center"
                    Size="Medium"
                    Text="{Binding Hex, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
