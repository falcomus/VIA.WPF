<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style
        x:Key="XListBoxItemBaseStyle"
        BasedOn="{StaticResource {x:Type ListBoxItem}}"
        TargetType="{x:Type controls:XListBoxItem}">
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{Binding BorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XListBoxItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" />

                        <Border
                            x:Name="SelectionIndicator"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="2"
                            Background="{Binding SelectionIndicatorBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}"
                            CornerRadius="{Binding SelectionIndicatorCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            Width="{Binding SelectionIndicatorWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" />

                        <Border
                            x:Name="FocusBorder"
                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                        <Grid
                            x:Name="StandardContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <controls:XBadge
                                    x:Name="Badge"
                                    Grid.Column="1"
                                    Height="21"
                                    MinWidth="21"
                                    MinHeight="21"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Appearance="Solid"
                                    BorderThickness="0"
                                    Content="{TemplateBinding BadgeContent}"
                                    CornerRadius="11"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Size="Small"
                                    Variant="{Binding BadgeVariant, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="Collapsed" />

                                <controls:XStackPanel
                                    x:Name="ActionPanel"
                                    Grid.Column="2"
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    Visibility="Hidden">
                                    <controls:XIconButton
                                        x:Name="EditButton"
                                        Width="22"
                                        Height="22"
                                        MinWidth="22"
                                        MinHeight="22"
                                        Padding="0"
                                        Appearance="Ghost"
                                        Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        CommandParameter="{Binding EditCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                        Cursor="Hand"
                                        Focusable="True"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBoxItem}}}"
                                        IconSize="13"
                                        IsTabStop="True"
                                        Size="Small"
                                        ToolTip="{TemplateBinding EditToolTip}"
                                        Visibility="Collapsed">
                                        <controls:XIconButton.Icon>
                                            <pack:PackIconMaterialDesign Kind="Launch" />
                                        </controls:XIconButton.Icon>
                                    </controls:XIconButton>

                                    <controls:XIconButton
                                        x:Name="DeleteButton"
                                        Width="22"
                                        Height="22"
                                        MinWidth="22"
                                        MinHeight="22"
                                        Padding="0"
                                        Appearance="Ghost"
                                        Command="{Binding DeleteCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        CommandParameter="{Binding DeleteCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                        Cursor="Hand"
                                        Focusable="True"
                                        Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                        IconSize="10"
                                        IsTabStop="True"
                                        Size="Small"
                                        ToolTip="{TemplateBinding DeleteToolTip}"
                                        Variant="Danger"
                                        Visibility="Collapsed">
                                        <controls:XIconButton.Icon>
                                            <pack:PackIconMaterialDesign Kind="Close" />
                                        </controls:XIconButton.Icon>
                                    </controls:XIconButton>
                                </controls:XStackPanel>
                            </Grid>

                            <TextBlock
                                x:Name="SubTitleText"
                                Grid.Row="1"
                                Margin="0,2,0,0"
                                FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                                FontWeight="Normal"
                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                Text="{TemplateBinding SubTitle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                        </Grid>

                        <Border
                            x:Name="Separator"
                            Height="1"
                            Margin="10,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                            IsHitTestVisible="False"
                            Opacity="0.70"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ShowSeparators, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="True">
                            <Setter TargetName="Separator" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <Trigger Property="ContentTemplate" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StandardContentPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StandardContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Title" Value="">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StandardContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasSubTitle" Value="True">
                            <Setter TargetName="SubTitleText" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBadge" Value="True" />
                                <Condition Property="HasBadgeContent" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <Trigger Property="ShowEdit" Value="True">
                            <Setter TargetName="ActionPanel" Property="Margin" Value="6,0,0,0" />
                            <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowDelete" Value="True">
                            <Setter TargetName="ActionPanel" Property="Margin" Value="6,0,0,0" />
                            <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
                            <Setter TargetName="ActionPanel" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActionPanel" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding ShowSelectionIndicator, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusBorder" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>

                        <DataTrigger Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="{x:Static controls:XListBoxMode.CompactNavigation}">
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="4" />
                            <Setter TargetName="FocusBorder" Property="CornerRadius" Value="4" />
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="{x:Static controls:XListBoxMode.CompactNavigation}" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Mode, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="{x:Static controls:XListBoxMode.CompactNavigation}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </MultiDataTrigger>

                        <DataTrigger Binding="{Binding Size, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Size, RelativeSource={RelativeSource AncestorType={x:Type controls:XListBox}}}" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Padding" Value="12,7" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource XListBoxItemBaseStyle}" TargetType="{x:Type controls:XListBoxItem}" />

    <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type controls:XListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ShowSelectionIndicator" Value="False" />
        <Setter Property="SelectionIndicatorBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
        <Setter Property="SelectionIndicatorWidth" Value="3" />
        <Setter Property="SelectionIndicatorCornerRadius" Value="0,2,2,0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource XListBoxItemBaseStyle}" TargetType="{x:Type controls:XListBoxItem}" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
