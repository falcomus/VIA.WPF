                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Success}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusSuccessSubtle}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusSuccess}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusSuccess}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Success}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SuccessLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SuccessDark}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Success}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <!--  Warning  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarning}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarningForeground}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarning}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarningSubtle}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarning}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarning}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.WarningLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.WarningDark}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <!--  Danger  -->
