                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentDark}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
            </MultiTrigger>

            <MultiTrigger>
