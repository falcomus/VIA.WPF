                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Danger}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusDanger}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusDangerForeground}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusDanger}}" />
