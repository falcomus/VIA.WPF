<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XRadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XRadioButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="IndicatorHost"
                            Width="20"
                            Height="20"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <Ellipse
                                x:Name="KeyboardFocusRing"
                                Fill="Transparent"
                                Stroke="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}"
                                StrokeThickness="2"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="IndicatorBorder"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="{TemplateBinding BorderThickness}" />

                            <Ellipse
                                x:Name="SelectionDot"
                                Width="9"
                                Height="9"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource {x:Static themes:XBrushKeys.Primary}}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Visibility="Collapsed" />
                        </Grid>

                        <ContentPresenter
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter TargetName="IndicatorBorder" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceVeryLight}}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="IndicatorBorder" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.StatePressed}}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IndicatorBorder" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Success}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Warning}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Danger}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Info}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorBorder" Property="Stroke" Value="{DynamicResource {x:Static themes:XBrushKeys.Info}}" />
                            <Setter TargetName="SelectionDot" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.Info}}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="IndicatorBorder" Property="Opacity" Value="0.50" />
                            <Setter TargetName="SelectionDot" Property="Opacity" Value="0.65" />
                            <Setter Property="Opacity" Value="0.65" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter TargetName="IndicatorHost" Property="Width" Value="18" />
                            <Setter TargetName="IndicatorHost" Property="Height" Value="18" />
                            <Setter TargetName="IndicatorBorder" Property="Width" Value="14" />
                            <Setter TargetName="IndicatorBorder" Property="Height" Value="14" />
                            <Setter TargetName="SelectionDot" Property="Width" Value="6" />
                            <Setter TargetName="SelectionDot" Property="Height" Value="6" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter TargetName="IndicatorHost" Property="Width" Value="22" />
                            <Setter TargetName="IndicatorHost" Property="Height" Value="22" />
                            <Setter TargetName="IndicatorBorder" Property="Width" Value="18" />
                            <Setter TargetName="IndicatorBorder" Property="Height" Value="18" />
                            <Setter TargetName="SelectionDot" Property="Width" Value="8.5" />
                            <Setter TargetName="SelectionDot" Property="Height" Value="8.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
