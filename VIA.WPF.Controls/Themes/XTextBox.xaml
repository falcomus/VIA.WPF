<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/XInputShared.xaml" />
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="XTextBoxResetButtonStyle"
        BasedOn="{StaticResource XInputResetButtonStyle}"
        TargetType="{x:Type Button}" />

    <Style TargetType="{x:Type controls:XTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="controls:XInputAssist.HoverBackground" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
        <Setter Property="controls:XInputAssist.FocusedBackground" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="controls:XInputAssist.HoverBorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
        <Setter Property="controls:XInputAssist.FocusedBorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="1,0,1,1" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="LeadingIconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="TrailingIconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="ShowResetButton" Value="False" />
        <Setter Property="ResetIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
        <Setter Property="ResetButtonForeground" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderText}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XTextBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- The input row must consume the explicit control height.
                                 Auto kept multiline XTextBox instances visually single-line. -->
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="HeaderPresenter"
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            FontSize="{TemplateBinding HeaderFontSize}"
                            FontWeight="{TemplateBinding HeaderFontWeight}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                            Text="{TemplateBinding Header}" />

                        <Border
                            x:Name="RootBorder"
                            Grid.Row="1"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="LeadingIconColumn" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="TrailingIconColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="ResetButtonColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="PART_LeadingIconPresenter"
                                    Grid.Column="0"
                                    Margin="6,0,4,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding LeadingIcon}"
                                    ContentTemplate="{TemplateBinding LeadingIconTemplate}"
                                    Opacity="0.82">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type icons:XIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFluentIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XMaterialIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XModernIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFileIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Width" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Height" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Grid x:Name="TextAreaGrid" Grid.Column="1">
                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Background="Transparent"
                                        Focusable="False" />

                                    <TextBlock
                                        x:Name="PlaceholderPresenter"
                                        Margin="3,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Background="Transparent"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontStretch="{TemplateBinding FontStretch}"
                                        FontStyle="{TemplateBinding FontStyle}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextTertiary}}"
                                        IsHitTestVisible="False"
                                        Opacity="0.56"
                                        Text="{TemplateBinding Placeholder}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter
                                    x:Name="PART_TrailingIconPresenter"
                                    Grid.Column="2"
                                    Margin="4,0,6,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding TrailingIcon}"
                                    ContentTemplate="{TemplateBinding TrailingIconTemplate}"
                                    Opacity="0.82">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type icons:XIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFluentIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XMaterialIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XModernIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type icons:XFileIcon}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="controls:XIconAssist.Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Width" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Height" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>

                                        <Style TargetType="{x:Type pack:PackIconFontAwesome6}">
                                            <Setter Property="controls:XIconAssist.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Width" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                            <Setter Property="Height" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XTextBox}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Button
                                    x:Name="PART_ResetButton"
                                    Grid.Column="3"
                                    Margin="2,0,2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearTextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Content="{Binding ResetIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding ResetIconTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{Binding ResetButtonForeground, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource XTextBoxResetButtonStyle}"
                                    controls:XInputAssist.IconSize="{Binding ResetIconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="Clear"
                                    Visibility="{Binding ResetButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ValidationErrorPresenter"
                            Grid.Row="3"
                            MinHeight="16"
                            Margin="0,4,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="LeadingIcon" Value="{x:Null}">
                            <Setter TargetName="PART_LeadingIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeadingIconColumn" Property="Width" Value="0" />
                            <Setter TargetName="TextAreaGrid" Property="Margin" Value="3,0,0,0" />
                        </Trigger>

                        <Trigger Property="TrailingIcon" Value="{x:Null}">
                            <Setter TargetName="PART_TrailingIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TrailingIconColumn" Property="Width" Value="0" />
                        </Trigger>

                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PlaceholderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{Binding Path=(controls:XInputAssist.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding Path=(controls:XInputAssist.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{Binding Path=(controls:XInputAssist.FocusedBorderBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{Binding Path=(controls:XInputAssist.FocusedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PlaceholderPresenter" Property="Opacity" Value="0.46" />
                        </Trigger>

                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputReadOnlyBackground}}" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ValidationErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="MultiLineValidationHints" Value="True">
                            <Setter TargetName="ValidationErrorPresenter" Property="MaxHeight" Value="34" />
                            <Setter TargetName="ValidationErrorPresenter" Property="TextWrapping" Value="Wrap" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                        </Trigger>




                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
