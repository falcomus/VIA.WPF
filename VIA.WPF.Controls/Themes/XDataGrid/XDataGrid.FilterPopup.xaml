<!--
    ===========================================================================================================
    file="XDataGrid.FilterPopup.xaml" company="VIA.WPF">
    Contains the XDataGrid column filter popup content template.
    ===========================================================================================================
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:via="http://schemas.via.dev/wpf">

    <ItemsPanelTemplate x:Key="XDataGridFilterItemsPanelTemplate">
        <VirtualizingStackPanel />
    </ItemsPanelTemplate>

    <Style x:Key="XDataGridFilterListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="3,2"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateHover}}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static via:XBrushKeys.StateSelected}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="XDataGridFilterPopupContentTemplate" TargetType="{x:Type Control}">
        <controls:XBorder
            MinWidth="260"
            MaxWidth="380"
            Margin="14"
            Padding="12"
            Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceOverlay}}"
            BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
            BorderThickness="1"
            CornerRadius="6"
            Elevation="Medium">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:XStackPanel Grid.Row="0" Spacing="2">
                    <controls:XTextBlock Text="Filter values" TextRole="Label" />

                    <controls:XTextBlock
                        Opacity="0.68"
                        Size="Small"
                        Text="Select values. Esc closes, Alt+A selects all, Alt+N selects none."
                        TextRole="Caption" />
                </controls:XStackPanel>

                <Border
                    Grid.Row="1"
                    MinHeight="72"
                    MaxHeight="300"
                    Margin="0,10,0,10"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceSunken}}"
                    BorderBrush="{DynamicResource {x:Static via:XBrushKeys.BorderDefault}}"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                            ItemContainerStyle="{StaticResource XDataGridFilterListBoxItemStyle}"
                            ItemsPanel="{StaticResource XDataGridFilterItemsPanelTemplate}"
                            ItemsSource="{Binding DataContext.CurrentFilterItems, RelativeSource={RelativeSource TemplatedParent}}"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.IsDeferredScrollingEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Multiple"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsCurrentFilterLoading, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <controls:XCheckBox
                                        HorizontalAlignment="Stretch"
                                        Content="{Binding DisplayValue}"
                                        Foreground="{DynamicResource {x:Static via:XBrushKeys.TextPrimary}}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Size="Small" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:XStackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <controls:XStackPanel.Style>
                                <Style TargetType="{x:Type controls:XStackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsCurrentFilterLoading, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:XStackPanel.Style>

                            <ProgressBar
                                Width="120"
                                Height="4"
                                IsIndeterminate="True" />

                            <controls:XTextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.72"
                                Size="Small"
                                Text="Loading values..."
                                TextRole="Caption" />
                        </controls:XStackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:XButton
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Appearance="Ghost"
                        Command="{Binding DataContext.SelectAllCurrentColumnCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Content="All"
                        Size="Small" />

                    <controls:XButton
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        Appearance="Ghost"
                        Command="{Binding DataContext.ClearCurrentColumnCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Content="None"
                        Size="Small" />

                    <controls:XButton
                        Grid.Column="3"
                        Margin="0,0,6,0"
                        Command="{Binding DataContext.ClearAllFiltersCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Content="Reset all"
                        Size="Small"
                        Variant="Danger" />

                    <controls:XButton
                        Grid.Column="4"
                        Command="{Binding DataContext.CloseCurrentPopupCommand, RelativeSource={RelativeSource TemplatedParent}}"
                        Content="Close"
                        Size="Small"
                        Variant="Primary" />
                </Grid>
            </Grid>
        </controls:XBorder>
    </ControlTemplate>

</ResourceDictionary>
