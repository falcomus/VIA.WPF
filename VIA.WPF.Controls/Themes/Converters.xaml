<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:VIA.WPF.Converters">

    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

    <conv:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
    <conv:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
    <conv:BooleanToThicknessConverter x:Key="BooleanToThicknessConverter" />
    <conv:NullToBooleanConverter x:Key="NullToBooleanConverter" />
    <conv:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
    <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringNullOrWhiteSpaceToVisibilityConverter" />
    <conv:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
    <conv:CollectionNotEmptyToVisibilityConverter x:Key="CollectionNotEmptyToVisibilityConverter" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
    <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
    <conv:BooleanAndConverter x:Key="BooleanAndConverter" />
    <conv:BooleanOrConverter x:Key="BooleanOrConverter" />
    <conv:AnyTrueToVisibilityConverter x:Key="AnyTrueToVisibilityConverter" />
    <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibilityConverter" />
    <conv:ObjectReferenceEqualsConverter x:Key="ObjectReferenceEqualsConverter" />
    <conv:NumberGreaterThanToVisibilityConverter x:Key="NumberGreaterThanToVisibilityConverter" />
    <conv:MultiplyConverter x:Key="MultiplyConverter" />
    <conv:TreeLevelToThicknessConverter x:Key="TreeLevelToThicknessConverter" />
    <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
    <conv:BrushToContrastingBrushConverter x:Key="BrushToContrastingBrushConverter" />
    <conv:BrushOpacityConverter x:Key="BrushOpacityConverter" />
    <conv:ObjectMemberPathValueConverter x:Key="ObjectMemberPathValueConverter" />
    <!--  Safely extracts the first validation error message without throwing when Validation.Errors is empty.  -->
    <conv:FirstValidationErrorConverter x:Key="FirstValidationErrorConverter" />
    <conv:BooleanToXDataGridColumnDisplayModeConverter x:Key="BooleanToXDataGridColumnDisplayModeConverter" />

</ResourceDictionary>
