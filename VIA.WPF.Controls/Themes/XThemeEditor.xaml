<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VIA.WPF.Controls" xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">
    <Style TargetType="{x:Type controls:XThemeEditor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XThemeEditor}">
                    <Border Padding="14" Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Theme-Name" />
                                <TextBox Grid.Column="1" Margin="0,0,12,0" Text="{Binding Palette.Name, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Column="2" DisplayMemberPath="Name" ItemsSource="{Binding AvailableThemes, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding SelectedTheme, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,14,12,0" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" BorderThickness="1" ItemsSource="{Binding Palette.Colors, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding SelectedColorSeed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><Border Width="16" Height="16" VerticalAlignment="Center" Background="{Binding LightBrush}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" BorderThickness="1" CornerRadius="2" /><TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" /><Border Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center" Background="{Binding DarkBrush}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" BorderThickness="1" CornerRadius="2" /></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Heller Modus" /><controls:XColorPicker SelectedColor="{Binding SelectedColorSeed.Light, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Dunkler Modus" /><controls:XColorPicker SelectedColor="{Binding SelectedColorSeed.Dark, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" /></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                <controls:XButton Margin="0,0,8,0" Command="{x:Static controls:XThemeEditor.CreateThemeCommand}" Content="Neues Theme" Size="Small" Variant="Default" />
                                <controls:XButton Command="{x:Static controls:XThemeEditor.ApplyThemeCommand}" Content="Übernehmen" Size="Small" Variant="Primary" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
