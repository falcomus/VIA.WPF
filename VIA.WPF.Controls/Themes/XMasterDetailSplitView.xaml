<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:conv="clr-namespace:VIA.WPF.Converters"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:via="http://schemas.via.dev/wpf">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/XSplitView.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:XMasterDetailSplitView}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Canvas}}" />
        <Setter Property="MinFirstLength" Value="320" />
        <Setter Property="MinSecondLength" Value="360" />
        <Setter Property="FirstLength" Value="520" />
        <Setter Property="SecondLength" Value="*" />
        <Setter Property="SplitterThickness" Value="8" />
        <Setter Property="SplitterSpacing" Value="2" />
        <Setter Property="IsSplitterVisible" Value="True" />
        <Setter Property="ShowNewButton" Value="True" />
        <Setter Property="ShowDetailButton" Value="True" />
        <Setter Property="ShowEditButton" Value="True" />
        <Setter Property="ShowCloseButton" Value="True" />
        <Setter Property="ShowMasterHeader" Value="True" />
        <Setter Property="ShowDetailHeader" Value="True" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="MasterContentPadding" Value="0" />
        <Setter Property="DetailContentPadding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XMasterDetailSplitView}">
                    <Border
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <AdornerDecorator
                            MinHeight="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <Grid
                                MinHeight="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="PART_HorizontalFirstColumnDefinition" Width="{TemplateBinding FirstLength}" />
                                    <ColumnDefinition x:Name="PART_HorizontalSplitterColumnDefinition" Width="{TemplateBinding SplitterThickness}" />
                                    <ColumnDefinition x:Name="PART_HorizontalSecondColumnDefinition" Width="{TemplateBinding SecondLength}" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="PART_VerticalFirstRowDefinition" Height="*" />
                                    <RowDefinition x:Name="PART_VerticalSplitterRowDefinition" Height="0" />
                                    <RowDefinition x:Name="PART_VerticalSecondRowDefinition" Height="0" />
                                </Grid.RowDefinitions>

                                <Border
                                    x:Name="PART_FirstContentPresenter"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                    BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    SnapsToDevicePixels="True">
                                    <Grid
                                        MinHeight="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            x:Name="PART_MasterHeader"
                                            MinHeight="44"
                                            Padding="12,6"
                                            Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="8,8,0,0"
                                            Visibility="{Binding ShowMasterHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <controls:XTextBlock
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding MasterTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                                    TextRole="SectionTitle" />

                                                <ContentPresenter
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding MasterHeaderContent}"
                                                    ContentTemplate="{TemplateBinding MasterHeaderContentTemplate}" />

                                                <controls:XButton
                                                    Grid.Column="2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding NewCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    CommandParameter="{Binding NewCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding NewButtonText, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Icon="{via:MaterialIcon Kind=Plus}"
                                                    IconSize="11"
                                                    Variant="Primary"
                                                    Visibility="{Binding ShowNewButton, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}" />

                                                <controls:XButton
                                                    Grid.Column="3"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Appearance="Outline"
                                                    Command="{Binding DetailCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    CommandParameter="{Binding DetailCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding DetailButtonText, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Icon="{via:MaterialDesignIcon Kind=OpenInNew}"
                                                    IconSize="12"
                                                    Visibility="{Binding ShowDetailButton, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            MinHeight="0"
                                            Padding="{TemplateBinding MasterContentPadding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                            <ContentControl
                                                Grid.Row="1"
                                                MinHeight="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Content="{TemplateBinding FirstContent}"
                                                ContentTemplate="{TemplateBinding FirstContentTemplate}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <GridSplitter
                                    x:Name="PART_Splitter"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    ResizeBehavior="PreviousAndNext"
                                    ShowsPreview="{TemplateBinding ShowsPreview}"
                                    Style="{StaticResource XSplitViewSplitterStyle}"
                                    Tag="Horizontal" />

                                <Border
                                    x:Name="PART_SecondContentPresenter"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                    BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    SnapsToDevicePixels="True">
                                    <Grid
                                        MinHeight="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            x:Name="PART_DetailHeader"
                                            MinHeight="44"
                                            Padding="12,6"
                                            Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="8,8,0,0"
                                            Visibility="{Binding ShowDetailHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <controls:XTextBlock
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DetailTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                                    TextRole="SectionTitle" />

                                                <ContentPresenter
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding DetailHeaderContent}"
                                                    ContentTemplate="{TemplateBinding DetailHeaderContentTemplate}" />

                                                <controls:XButton
                                                    Grid.Column="2"
                                                    Margin="8,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    CommandParameter="{Binding EditCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Content="{Binding EditButtonText, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Icon="{via:MaterialIcon Kind=OpenInNew}"
                                                    IconSize="13"
                                                    Variant="Primary"
                                                    Visibility="{Binding ShowEditButton, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}" />

                                                <controls:XSeparator Grid.Column="3" />

                                                <controls:XIconButton
                                                    x:Name="PART_CloseButton"
                                                    Grid.Column="4"
                                                    Width="32"
                                                    Height="30"
                                                    MinWidth="30"
                                                    MinHeight="30"
                                                    Margin="6,0,-2,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Icon="{via:MaterialIcon Kind=Close}"
                                                    IconSize="11"
                                                    ToolTip="Close details"
                                                    Visibility="{Binding ShowCloseButton, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}" />
                                            </Grid>
                                        </Border>

                                        <Border
                                            Grid.Row="1"
                                            MinHeight="0"
                                            Padding="{TemplateBinding DetailContentPadding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                            <ContentControl
                                                MinHeight="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Content="{TemplateBinding SecondContent}"
                                                ContentTemplate="{TemplateBinding SecondContentTemplate}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </AdornerDecorator>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.ColumnSpan" Value="1" />

                            <Setter TargetName="PART_Splitter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_Splitter" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Splitter" Property="Grid.RowSpan" Value="1" />
                            <Setter TargetName="PART_Splitter" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="PART_Splitter" Property="ResizeDirection" Value="Columns" />
                            <Setter TargetName="PART_Splitter" Property="Cursor" Value="SizeWE" />
                            <Setter TargetName="PART_Splitter" Property="Tag" Value="Horizontal" />

                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.Column" Value="2" />
                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.ColumnSpan" Value="1" />

                            <Setter TargetName="PART_VerticalFirstRowDefinition" Property="Height" Value="*" />
                            <Setter TargetName="PART_VerticalSplitterRowDefinition" Property="Height" Value="0" />
                            <Setter TargetName="PART_VerticalSecondRowDefinition" Property="Height" Value="0" />
                        </Trigger>

                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_FirstContentPresenter" Property="Grid.ColumnSpan" Value="3" />

                            <Setter TargetName="PART_Splitter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_Splitter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_Splitter" Property="Grid.RowSpan" Value="1" />
                            <Setter TargetName="PART_Splitter" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="PART_Splitter" Property="ResizeDirection" Value="Rows" />
                            <Setter TargetName="PART_Splitter" Property="Cursor" Value="SizeNS" />
                            <Setter TargetName="PART_Splitter" Property="Tag" Value="Vertical" />

                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.Row" Value="2" />
                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_SecondContentPresenter" Property="Grid.ColumnSpan" Value="3" />

                            <Setter TargetName="PART_HorizontalFirstColumnDefinition" Property="Width" Value="*" />
                            <Setter TargetName="PART_HorizontalSplitterColumnDefinition" Property="Width" Value="0" />
                            <Setter TargetName="PART_HorizontalSecondColumnDefinition" Property="Width" Value="*" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
