<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:mvvm="clr-namespace:VIA.WPF.MVVM;assembly=VIA.WPF.MVVM"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ControlTemplate x:Key="XValidationHintPopupErrorTemplate" />

    <Style TargetType="{x:Type controls:XValidationHintPopup}">
        <Setter Property="Header" Value="Validation" />
        <Setter Property="IncludeWarnings" Value="True" />
        <Setter Property="IncludeInformation" Value="False" />
        <Setter Property="ShowWhenValid" Value="False" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource XValidationHintPopupErrorTemplate}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type mvvm:XValidationError}">
                    <controls:XGrid
                        Margin="0"
                        ColumnSpacing="8"
                        Columns="Auto,*">
                        <controls:XBorder
                            x:Name="SeverityMarker"
                            Width="7"
                            Height="7"
                            Margin="0,6.5,0,0"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.StatusDanger}}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            Elevation="None" />

                        <controls:XTextBlock
                            Grid.Column="1"
                            IsMultiline="True"
                            Text="{Binding Message}"
                            TextRole="Body" />
                    </controls:XGrid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static mvvm:XValidationSeverity.Warning}">
                            <Setter TargetName="SeverityMarker" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarning}}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static mvvm:XValidationSeverity.Information}">
                            <Setter TargetName="SeverityMarker" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfo}}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XValidationHintPopup}">
                    <controls:XGrid
                        x:Name="Root"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}"
                        Visibility="Collapsed">
                        <controls:XBadge
                            x:Name="IndicatorBadge"
                            Height="24"
                            MinWidth="38"
                            MinHeight="24"
                            Margin="0,4,0,0"
                            Padding="6,0.5,6,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Appearance="VerySubtle"
                            BorderThickness="1"
                            CornerRadius="3"
                            Cursor="Arrow"
                            Size="Medium"
                            Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}"
                            Variant="Default">
                            <controls:XStackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Arrow"
                                Orientation="Horizontal"
                                Spacing="3"
                                Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}">

                                <controls:XTextBlock
                                    x:Name="CountText"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Text="{Binding MessageCount, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextRole="Body" />

                                <controls:XTextBlock
                                    x:Name="IndicatorGlyph"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Text=" Error(s)"
                                    TextRole="Body" />
                                <!--  Text="✓"  -->

                            </controls:XStackPanel>
                        </controls:XBadge>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            HorizontalOffset="-4"
                            IsOpen="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                            Placement="Custom"
                            PlacementTarget="{Binding ElementName=IndicatorBadge}"
                            PopupAnimation="Fade"
                            StaysOpen="False"
                            Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}">
                            <controls:XBorder
                                MinWidth="280"
                                MaxWidth="430"
                                Margin="5,0,5,5"
                                Padding="12"
                                Appearance="Solid"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceOverlay}}"
                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Elevation="Medium"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}">
                                <controls:XGrid Rows="Auto,Auto,Auto" Validation.ErrorTemplate="{StaticResource XValidationHintPopupErrorTemplate}">
                                    <controls:XTextBlock
                                        Grid.Row="0"
                                        Margin="0,-3,0,6"
                                        FontWeight="Medium"
                                        Text="{TemplateBinding Header}"
                                        TextRole="Subtitle" />

                                    <controls:XTextBlock
                                        x:Name="EmptyTextBlock"
                                        Grid.Row="1"
                                        Text="No validation messages."
                                        TextRole="Description"
                                        Visibility="Collapsed" />

                                    <ItemsPresenter
                                        x:Name="ItemsPresenter"
                                        Grid.Row="2"
                                        Margin="2,0,0,0" />

                                </controls:XGrid>
                            </controls:XBorder>
                        </Popup>
                    </controls:XGrid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasMessages" Value="True">
                            <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IndicatorGlyph" Property="Text" Value="Error(s)" />
                            <Setter TargetName="IndicatorBadge" Property="Variant" Value="Info" />
                        </Trigger>

                        <Trigger Property="ShowWhenValid" Value="True">
                            <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="HasMessages" Value="False">
                            <Setter TargetName="ItemsPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EmptyTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="HasInformation" Value="True">
                            <Setter TargetName="IndicatorBadge" Property="Variant" Value="Info" />
                        </Trigger>

                        <Trigger Property="HasWarnings" Value="True">
                            <Setter TargetName="IndicatorBadge" Property="Variant" Value="Warning" />
                        </Trigger>

                        <Trigger Property="HasErrors" Value="True">
                            <Setter TargetName="IndicatorBadge" Property="Variant" Value="Danger" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IndicatorBadge" Property="Appearance" Value="Subtle" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
