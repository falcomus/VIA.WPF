<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XExpander}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="HeaderPadding" Value="10,0,10,0" />
        <Setter Property="ContentPadding" Value="12,10,12,12" />
        <Setter Property="HeaderIconSize" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XExpander}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TopContentRow" Height="0" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="BottomContentRow" Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LeftContentColumn" Width="0" />
                                <ColumnDefinition x:Name="HeaderColumn" Width="*" />
                                <ColumnDefinition x:Name="RightContentColumn" Width="0" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="TopContentBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0"
                                Visibility="Collapsed">
                                <ContentPresenter
                                    Margin="{TemplateBinding ContentPadding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>

                            <Border
                                x:Name="LeftContentBorder"
                                Grid.Row="1"
                                Grid.Column="0"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="4,0,0,4"
                                Visibility="Collapsed">
                                <ContentPresenter
                                    Margin="{TemplateBinding ContentPadding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>

                            <Border
                                x:Name="HeaderBorder"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <Button
                                    x:Name="PART_HeaderButton"
                                    MinHeight="32"
                                    Padding="{TemplateBinding HeaderPadding}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Cursor="Arrow"
                                    FocusVisualStyle="{x:Null}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}">
                                    <Button.Tag>
                                        <CornerRadius>4</CornerRadius>
                                    </Button.Tag>

                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border
                                                x:Name="ButtonBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                                                </Trigger>

                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatePressed}}" />
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                                                </Trigger>

                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                                                    <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                                </Trigger>


                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter
                                            x:Name="HeaderIconPresenter"
                                            Grid.Column="0"
                                            Margin="0,1,10,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{Binding HeaderIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                            ContentTemplate="{Binding HeaderIconTemplate, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Size" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Width" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <Setter Property="Height" Value="{Binding HeaderIconSize, RelativeSource={RelativeSource TemplatedParent}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True" />

                                        <Path
                                            x:Name="IndicatorPath"
                                            Grid.Column="2"
                                            Width="10"
                                            Height="10"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Data="M 0 2 L 5 7 L 10 2"
                                            Fill="Transparent"
                                            Stroke="{TemplateBinding Foreground}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.75" />
                                    </Grid>
                                </Button>
                            </Border>

                            <Border
                                x:Name="RightContentBorder"
                                Grid.Row="1"
                                Grid.Column="2"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,0,0"
                                CornerRadius="0,4,4,0"
                                Visibility="Collapsed">
                                <ContentPresenter
                                    Margin="{TemplateBinding ContentPadding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>

                            <Border
                                x:Name="BottomContentBorder"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,4,4"
                                Visibility="Collapsed">
                                <ContentPresenter
                                    Margin="{TemplateBinding ContentPadding}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HeaderIcon" Value="{x:Null}">
                            <Setter TargetName="HeaderIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowIndicator" Value="False">
                            <Setter TargetName="IndicatorPath" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="TopContentBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BottomContentBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeftContentBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightContentBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TopContentRow" Property="Height" Value="0" />
                            <Setter TargetName="BottomContentRow" Property="Height" Value="0" />
                            <Setter TargetName="LeftContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="*" />
                            <Setter TargetName="RightContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderBorder" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="4" />
                            <Setter TargetName="PART_HeaderButton" Property="Tag">
                                <Setter.Value>
                                    <CornerRadius>4</CornerRadius>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Up}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="True" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Down}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BottomContentRow" Property="Height" Value="Auto" />
                            <Setter TargetName="BottomContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="4,4,0,0" />
                            <Setter TargetName="PART_HeaderButton" Property="Tag">
                                <Setter.Value>
                                    <CornerRadius>4,4,0,0</CornerRadius>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="True" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Up}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TopContentRow" Property="Height" Value="Auto" />
                            <Setter TargetName="TopContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="0,0,4,4" />
                            <Setter TargetName="PART_HeaderButton" Property="Tag">
                                <Setter.Value>
                                    <CornerRadius>0,0,4,4</CornerRadius>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="True" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftContentColumn" Property="Width" Value="*" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="RightContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="LeftContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HeaderBorder" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="0,4,4,0" />
                            <Setter TargetName="PART_HeaderButton" Property="Tag">
                                <Setter.Value>
                                    <CornerRadius>0,4,4,0</CornerRadius>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="True" />
                                <Condition Property="ExpandDirection" Value="{x:Static controls:XExpandDirection.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="LeftContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="RightContentColumn" Property="Width" Value="*" />
                            <Setter TargetName="RightContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HeaderBorder" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="4,0,0,4" />
                            <Setter TargetName="PART_HeaderButton" Property="Tag">
                                <Setter.Value>
                                    <CornerRadius>4,0,0,4</CornerRadius>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="HeaderIconSize" Value="14" />
                            <Setter Property="HeaderPadding" Value="6,0,8,0" />
                            <Setter Property="ContentPadding" Value="10,5,10,6" />
                            <Setter TargetName="PART_HeaderButton" Property="MinHeight" Value="26" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="HeaderIconSize" Value="18" />
                            <Setter Property="HeaderPadding" Value="10,0,12,0" />
                            <Setter Property="ContentPadding" Value="14,12,14,14" />
                            <Setter TargetName="PART_HeaderButton" Property="MinHeight" Value="38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
