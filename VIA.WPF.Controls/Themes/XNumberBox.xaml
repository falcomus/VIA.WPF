<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="XNumberBoxSpinButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatePressed}}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XNumberBox}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="LeadingIconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="TrailingIconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XNumberBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="HeaderPresenter"
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            FontSize="{TemplateBinding HeaderFontSize}"
                            FontWeight="{TemplateBinding HeaderFontWeight}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                            Opacity="0.90"
                            Text="{TemplateBinding Header}" />

                        <Border
                            x:Name="RootBorder"
                            Grid.Row="1"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="LeadingIconColumn" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="TrailingIconColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="PART_SpinnerColumn" Width="0" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="LeadingIconPresenter"
                                    Grid.Column="0"
                                    Margin="1,0,8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding LeadingIcon}"
                                    ContentTemplate="{TemplateBinding LeadingIconTemplate}"
                                    Opacity="0.82">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type icons:XIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFileIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFluentIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XMaterialIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XModernIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Width" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Height" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type pack:PackIconFontAwesome6}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Width" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Height" Value="{Binding LeadingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Grid Grid.Column="1">
                                    <TextBox
                                        x:Name="PART_TextBox"
                                        Margin="0"
                                        Padding="0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{TemplateBinding CaretBrush}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontStretch="{TemplateBinding FontStretch}"
                                        FontStyle="{TemplateBinding FontStyle}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{TemplateBinding Foreground}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"
                                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        x:Name="PlaceholderPresenter"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource {x:Static themes:XBrushKeys.InputPlaceholder}}"
                                        IsHitTestVisible="False"
                                        Opacity="0.56"
                                        Text="{TemplateBinding Placeholder}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter
                                    x:Name="TrailingIconPresenter"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding TrailingIcon}"
                                    ContentTemplate="{TemplateBinding TrailingIconTemplate}"
                                    Opacity="0.82">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type icons:XIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFileIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFluentIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XMaterialIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XModernIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Size" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Width" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Height" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                        <Style TargetType="{x:Type pack:PackIconFontAwesome6}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Width" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                            <Setter Property="Height" Value="{Binding TrailingIconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XNumberBox}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Grid
                                    x:Name="PART_SpinnerPanel"
                                    Grid.Column="3"
                                    Width="17"
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        x:Name="PART_SpinUpButton"
                                        Grid.Row="0"
                                        Style="{StaticResource XNumberBoxSpinButtonStyle}"
                                        ToolTip="Increase">
                                        <Path
                                            Width="8"
                                            Height="5"
                                            Data="M 0 4 L 4 0 L 8 4"
                                            Opacity="0.62"
                                            Stroke="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.2" />
                                    </Button>

                                    <Button
                                        x:Name="PART_SpinDownButton"
                                        Grid.Row="1"
                                        Style="{StaticResource XNumberBoxSpinButtonStyle}"
                                        ToolTip="Decrease">
                                        <Path
                                            Width="8"
                                            Height="5"
                                            Data="M 0 1 L 4 5 L 8 1"
                                            Opacity="0.62"
                                            Stroke="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.2" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Opacity="0.68"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ValidationErrorPresenter"
                            Grid.Row="3"
                            MinHeight="16"
                            Margin="0,4,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="LeadingIcon" Value="{x:Null}">
                            <Setter TargetName="LeadingIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LeadingIconColumn" Property="Width" Value="0" />
                        </Trigger>

                        <Trigger Property="TrailingIcon" Value="{x:Null}">
                            <Setter TargetName="TrailingIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TrailingIconColumn" Property="Width" Value="0" />
                        </Trigger>

                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
                            <Setter TargetName="PlaceholderPresenter" Property="Opacity" Value="0.46" />
                        </Trigger>

                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputReadOnlyBackground}}" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ValidationErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="MultiLineValidationHints" Value="True">
                            <Setter TargetName="ValidationErrorPresenter" Property="MaxHeight" Value="34" />
                            <Setter TargetName="ValidationErrorPresenter" Property="TextWrapping" Value="Wrap" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="LeadingIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
                            <Setter Property="TrailingIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                            <Setter TargetName="PART_SpinnerPanel" Property="Width" Value="15" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="LeadingIconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
                            <Setter Property="TrailingIconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                            <Setter TargetName="PART_SpinnerPanel" Property="Width" Value="19" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowSpinnerButtons, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_SpinnerPanel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_SpinnerColumn" Property="Width" Value="Auto" />
                        </MultiDataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
