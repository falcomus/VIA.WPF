<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/Converters.xaml" />
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/XInputShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style
        x:Key="XLookupTreeComboBoxResetButtonStyle"
        BasedOn="{StaticResource XInputResetButtonStyle}"
        TargetType="{x:Type Button}" />

    <HierarchicalDataTemplate x:Key="XLookupTreeComboBoxItemTemplate" ItemsSource="{Binding Children}">
        <TextBlock
            FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type controls:XLookupTreeComboBox}}}"
            FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XLookupTreeComboBox}}}"
            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
            Text="{Binding Name}" />
    </HierarchicalDataTemplate>

    <Style TargetType="{x:Type controls:XLookupTreeComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="ShowResetButton" Value="False" />
        <Setter Property="ResetIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
        <Setter Property="ResetButtonForeground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XLookupTreeComboBox}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="HeaderPresenter"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Stretch"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FontSize="{TemplateBinding HeaderFontSize}"
                            FontWeight="{TemplateBinding HeaderFontWeight}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />

                        <ToggleButton
                            x:Name="FieldButton"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <Border
                                x:Name="FieldBorder"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="6,0,6,1"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl
                                        x:Name="PlaceholderIconPresenter"
                                        Width="{TemplateBinding IconSize}"
                                        Height="{TemplateBinding IconSize}"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"
                                        Opacity="0.62" />

                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                        <TextBlock
                                            x:Name="SelectedTextBlock"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                                            Text="{TemplateBinding SelectedText}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            x:Name="PlaceholderTextBlock"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextTertiary}}"
                                            Opacity="0.55"
                                            Text="{TemplateBinding Placeholder}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <Path
                                        Grid.Column="3"
                                        Width="10"
                                        Height="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 5 5 L 10 0"
                                        Stroke="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                        StrokeThickness="1.5" />
                                </Grid>
                            </Border>
                        </ToggleButton>

                        <Grid
                            x:Name="ResetButtonHost"
                            Grid.Row="1"
                            Height="{Binding ActualHeight, ElementName=FieldButton}"
                            Margin="0,0,32,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1">
                            <Button
                                x:Name="PART_ResetButton"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding ClearSelectionCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Content="{Binding ResetIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding ResetIconTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                Foreground="{Binding ResetButtonForeground, RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource XLookupTreeComboBoxResetButtonStyle}"
                                controls:XInputAssist.IconSize="{Binding ResetIconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                ToolTip="Clear"
                                Visibility="{Binding ResetButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>

                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=FieldButton}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,4,0,0"
                                Padding="6"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}"
                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="14"
                                        Direction="270"
                                        Opacity="0.16"
                                        ShadowDepth="3" />
                                </Border.Effect>
                                <DockPanel LastChildFill="True">
                                    <controls:XButton
                                        x:Name="PART_ClearSelectionButton"
                                        Margin="0,0,0,6"
                                        Padding="8,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Appearance="Outline"
                                        Content="{TemplateBinding EmptyOptionText}"
                                        DockPanel.Dock="Top"
                                        Size="Small"
                                        Visibility="{Binding IncludeEmptyOption, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <controls:XTreeView
                                        x:Name="PART_Tree"
                                        MinWidth="{Binding ActualWidth, ElementName=FieldButton}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ChildrenMemberPath="{Binding ChildrenMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                                        ExpandedMemberPath="{Binding ExpandedMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                                        ItemSpacing="1"
                                        ItemTemplate="{StaticResource XLookupTreeComboBoxItemTemplate}"
                                        ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                        NodePadding="6,3,8,3"
                                        ScrollViewer.CanContentScroll="True"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedDataItem="{Binding TreeSelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        ShowCollapseAllButton="False"
                                        ShowDeleteButton="False"
                                        ShowEditButton="False"
                                        ShowExpandAllButton="False"
                                        ShowNewButton="False"
                                        Size="{Binding Size, RelativeSource={RelativeSource TemplatedParent}}" />
                                </DockPanel>
                            </Border>
                        </Popup>

                        <ContentControl
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            Content="{TemplateBinding Description}"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Opacity="0.78" />

                        <TextBlock
                            x:Name="ValidationErrorPresenter"
                            Grid.Row="3"
                            MinHeight="16"
                            Margin="0,4,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                            <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ValidationErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="MultiLineValidationHints" Value="True">
                            <Setter TargetName="ValidationErrorPresenter" Property="MaxHeight" Value="34" />
                            <Setter TargetName="ValidationErrorPresenter" Property="TextWrapping" Value="Wrap" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Opacity" Value="0.75" />
                        </Trigger>

                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PlaceholderIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="SelectedText" Value="">
                            <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="SelectedText" Value="{x:Null}">
                            <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                            <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                            <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
