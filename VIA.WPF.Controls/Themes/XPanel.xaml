<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style x:Key="XPanelActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type controls:XPanel}}, Path=HeaderForegroundBrush}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceLight}}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceDark}}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XPanel}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="HeaderPadding" Value="16,2,4,2" />
        <Setter Property="FooterPadding" Value="16,10,16,12" />
        <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceLight}}" />
        <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
        <!--
            Container appearances intentionally use a small effective subset:
            Solid, Outline, Subtle and Ghost. VerySubtle maps to Subtle; Link maps to Ghost.
            The panel body stays on the Surface brush for all non-Ghost appearances.
        -->
        <Setter Property="TitleFontSize" Value="14" />
        <Setter Property="TitleFontWeight" Value="SemiBold" />
        <Setter Property="HeaderContentFontSize" Value="13" />
        <Setter Property="HeaderContentFontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XPanel}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="FooterRow" Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="HeaderBorder"
                                Grid.Row="0"
                                MinHeight="32"
                                Padding="{TemplateBinding HeaderPadding}"
                                Background="{TemplateBinding HeaderBackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,0.5"
                                CornerRadius="{TemplateBinding TopCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        x:Name="TitlePresenter"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Title}"
                                        ContentTemplate="{TemplateBinding TitleTemplate}"
                                        TextElement.FontSize="{TemplateBinding TitleFontSize}"
                                        TextElement.FontWeight="{TemplateBinding TitleFontWeight}"
                                        TextElement.Foreground="{TemplateBinding HeaderForegroundBrush}" />

                                    <ContentPresenter
                                        x:Name="HeaderContentPresenter"
                                        Grid.Column="1"
                                        Margin="25,1,0,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding HeaderContent}"
                                        ContentTemplate="{TemplateBinding HeaderContentTemplate}"
                                        TextElement.FontSize="{TemplateBinding HeaderContentFontSize}"
                                        TextElement.FontWeight="{TemplateBinding HeaderContentFontWeight}"
                                        TextElement.Foreground="{TemplateBinding HeaderForegroundBrush}" />

                                    <StackPanel
                                        x:Name="ActionsPanel"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <Button
                                            x:Name="PART_NewButton"
                                            Command="{TemplateBinding NewCommand}"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="New"
                                            Visibility="Collapsed">
                                            <ico:PackIconMaterial
                                                Width="13"
                                                Height="13"
                                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Primary}}"
                                                Kind="Plus" />
                                        </Button>

                                        <Button
                                            x:Name="PART_EditButton"
                                            Command="{TemplateBinding EditCommand}"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Edit"
                                            Visibility="Collapsed">
                                            <ico:PackIconMaterial
                                                Width="13"
                                                Height="13"
                                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Primary}}"
                                                Kind="Pencil" />
                                        </Button>

                                        <Button
                                            x:Name="PART_DeleteButton"
                                            Command="{TemplateBinding DeleteCommand}"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Delete"
                                            Visibility="Collapsed">
                                            <ico:PackIconMaterial
                                                Width="13"
                                                Height="13"
                                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                                Kind="Close" />
                                        </Button>

                                        <Button
                                            x:Name="PART_RefreshButton"
                                            Command="{TemplateBinding RefreshCommand}"
                                            Content="&#xE72C;"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Refresh"
                                            Visibility="Collapsed" />

                                        <Button
                                            x:Name="PART_SettingsButton"
                                            Command="{TemplateBinding SettingsCommand}"
                                            Content="&#xE713;"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Settings"
                                            Visibility="Collapsed" />

                                        <Button
                                            x:Name="PART_SearchButton"
                                            Command="{TemplateBinding SearchCommand}"
                                            Content="&#xE721;"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Search"
                                            Visibility="Collapsed" />

                                        <Button
                                            x:Name="PART_FilterButton"
                                            Command="{TemplateBinding FilterCommand}"
                                            Content="&#xE71C;"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Filter"
                                            Visibility="Collapsed" />

                                        <Button
                                            x:Name="PART_MenuButton"
                                            Width="20"
                                            Command="{TemplateBinding MenuCommand}"
                                            Style="{StaticResource XPanelActionButtonStyle}"
                                            ToolTip="Menu"
                                            Visibility="Collapsed">
                                            <ico:PackIconMaterial
                                                Width="13"
                                                Height="13"
                                                Kind="DotsVertical" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </Border>

                            <Border
                                x:Name="FooterBorder"
                                Grid.Row="2"
                                Padding="{TemplateBinding FooterPadding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{TemplateBinding BottomCornerRadius}">
                                <ContentPresenter
                                    x:Name="FooterPresenter"
                                    Content="{TemplateBinding Footer}"
                                    ContentTemplate="{TemplateBinding FooterTemplate}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="HeaderBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="0" />
                        </Trigger>

                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HeaderContent" Value="{x:Null}">
                            <Setter TargetName="HeaderContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasFooter" Value="False">
                            <Setter TargetName="FooterBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FooterRow" Property="Height" Value="0" />
                        </Trigger>

                        <Trigger Property="ShowNewButton" Value="True">
                            <Setter TargetName="PART_NewButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowEditButton" Value="True">
                            <Setter TargetName="PART_EditButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowDeleteButton" Value="True">
                            <Setter TargetName="PART_DeleteButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowRefreshButton" Value="True">
                            <Setter TargetName="PART_RefreshButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowSettingsButton" Value="True">
                            <Setter TargetName="PART_SettingsButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowSearchButton" Value="True">
                            <Setter TargetName="PART_SearchButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowFilterButton" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowMenuButton" Value="True">
                            <Setter TargetName="PART_MenuButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.None}">
                            <Setter TargetName="RootBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Low}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="14"
                                        Color="#FF0F172A"
                                        Direction="270"
                                        Opacity="0.10"
                                        ShadowDepth="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Medium}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="22"
                                        Color="#FF0F172A"
                                        Direction="270"
                                        Opacity="0.13"
                                        ShadowDepth="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.High}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="32"
                                        Color="#FF0F172A"
                                        Direction="270"
                                        Opacity="0.16"
                                        ShadowDepth="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Ghost}">
                            <Setter Property="HeaderBackgroundBrush" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Link}">
                            <Setter Property="HeaderBackgroundBrush" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Outline}">
                            <Setter Property="HeaderBackgroundBrush" Value="Transparent" />
                        </Trigger>

                        <!--  Default  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorderStrong}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Default header  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceLight}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceLight}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceDark}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                        </MultiTrigger>

                        <!--  Primary  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryLight}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryLight}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="HeaderBackgroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="HeaderForegroundBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryText}}" />
                        </MultiTrigger>

                        <!--  Accent  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentText}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentDark}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentDark}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentDark}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
