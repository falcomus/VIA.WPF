<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VIA.WPF.Controls" xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">
    <Style TargetType="{x:Type controls:XColorSchemeEditor}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XColorSchemeEditor}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ListBox Margin="0,0,12,0" MinHeight="220" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" BorderThickness="1" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="16" Height="16" VerticalAlignment="Center" Background="{Binding Brush}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" BorderThickness="1" CornerRadius="2" /><TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" Text="{Binding Hex}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="1" Padding="12" Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" BorderThickness="1" CornerRadius="4">
                            <controls:XColorPicker SelectedColor="{Binding SelectedItem.Color, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
