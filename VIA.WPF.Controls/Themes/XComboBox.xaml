<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/Converters.xaml" />
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/XInputShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="XComboBoxToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Header" Value="" />
        <Setter Property="Description" Value="" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!-- CanClearSelection is the preferred CLR alias; styles address the registered DP name. -->
        <Setter Property="ShowResetButton" Value="False" />
        <Setter Property="MaxVisibleItems" Value="10" />
        <Setter Property="ResetIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
        <Setter Property="ResetButtonForeground" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderText}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="HeaderPresenter"
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            FontSize="{TemplateBinding HeaderFontSize}"
                            FontWeight="{TemplateBinding HeaderFontWeight}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                            Text="{TemplateBinding Header}" />

                        <Grid Grid.Row="1">
                            <Border
                                x:Name="RootBorder"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <ToggleButton
                                        x:Name="DropDownToggle"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource XComboBoxToggleButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="Transparent" />

                                            <Path
                                                x:Name="DropDownGlyph"
                                                Grid.Column="1"
                                                Width="9"
                                                Height="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 L 4.5 4.5 L 9 0"
                                                IsHitTestVisible="False"
                                                Opacity="0.78"
                                                Stroke="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.5" />
                                        </Grid>
                                    </ToggleButton>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl
                                            x:Name="SelectionBoxPresenter"
                                            Grid.Column="0"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Foreground="{TemplateBinding Foreground}"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                            <ContentControl.Resources>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XComboBox}}}" />
                                                </Style>
                                            </ContentControl.Resources>
                                        </ContentControl>

                                        <TextBox
                                            x:Name="PART_EditableTextBox"
                                            Grid.Column="0"
                                            Margin="{TemplateBinding Padding}"
                                            Padding="0"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Focusable="True"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            IsReadOnly="{TemplateBinding IsReadOnly}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Button
                                x:Name="PART_ResetButton"
                                Margin="0,0,24,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                controls:XInputAssist.IconSize="{Binding ResetIconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                Command="{Binding ClearSelectionCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Content="{Binding ResetIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding ResetIconTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                Foreground="{Binding ResetButtonForeground, RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Style="{StaticResource XInputResetButtonStyle}"
                                ToolTip="Clear"
                                Visibility="{Binding ResetButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="PopupBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}"
                                    BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}"
                                    BorderThickness="1"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="14"
                                            Direction="270"
                                            Opacity="0.16"
                                            ShadowDepth="3" />
                                    </Border.Effect>

                                    <Grid>
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                        <TextBlock
                                            x:Name="EmptyPresenter"
                                            MinHeight="44"
                                            Margin="12,8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                            Text="{TemplateBinding EmptyText}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="ValidationErrorPresenter"
                            Grid.Row="3"
                            MinHeight="16"
                            Margin="0,4,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectionBoxPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PopupBorder" Property="MinHeight" Value="44" />
                            <Setter TargetName="EmptyPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter TargetName="PART_ResetButton" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_ResetButton" Property="IsHitTestVisible" Value="True" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
                            <Setter TargetName="PART_ResetButton" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_ResetButton" Property="IsHitTestVisible" Value="True" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ValidationErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="MultiLineValidationHints" Value="True">
                            <Setter TargetName="ValidationErrorPresenter" Property="MaxHeight" Value="34" />
                            <Setter TargetName="ValidationErrorPresenter" Property="TextWrapping" Value="Wrap" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                        </Trigger>

                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

