<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:navigation="clr-namespace:VIA.WPF.Controls.Navigation"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:via="http://schemas.via.dev/wpf">

    <Style TargetType="{x:Type controls:XViewContainer}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="DetailBackground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}" />
        <Setter Property="DetailBorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="DetailPresentation" Value="Dialog" />
        <Setter Property="DetailAnimation" Value="SlideZoom" />
        <Setter Property="DetailAnimationOffset" Value="18" />
        <Setter Property="DetailAnimationScale" Value="0.96" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="DetailAnimationDuration" Value="0:0:0.22" />
        <Setter Property="DetailPlacement" Value="Center" />
        <!--<Setter Property="DetailWidth" Value="500" />-->
        <Setter Property="DetailMinWidth" Value="300" />
        <Setter Property="DetailMaxHeight" Value="560" />
        <Setter Property="DetailMargin" Value="24" />
        <Setter Property="DetailCornerRadius" Value="6" />
        <Setter Property="DetailBorderThickness" Value="1" />
        <Setter Property="DetailHorizontalAlignment" Value="Center" />
        <Setter Property="IsModal" Value="True" />
        <Setter Property="OverlayBackground" Value="{DynamicResource {x:Static themes:XBrushKeys.Scrim}}" />
        <Setter Property="OverlayCornerRadius" Value="4" />
        <Setter Property="ShowDefaultDetailFooter" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XViewContainer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        Validation.ErrorTemplate="{x:Null}">

                        <Grid
                            MinHeight="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClipToBounds="{TemplateBinding ClipToBounds}"
                            Validation.ErrorTemplate="{x:Null}">
                            <ContentPresenter
                                x:Name="PART_ListHostPresenter"
                                MinHeight="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding ListHost}"
                                ContentTemplate="{TemplateBinding ListHostTemplate}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Visibility="Visible" />

                            <ContentPresenter
                                x:Name="PART_TreeHostPresenter"
                                MinHeight="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Content="{TemplateBinding TreeHost}"
                                ContentTemplate="{TemplateBinding TreeHostTemplate}"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                Visibility="Collapsed" />

                            <Grid
                                x:Name="PART_DetailLayer"
                                Panel.ZIndex="100"
                                Validation.ErrorTemplate="{x:Null}"
                                Visibility="Collapsed">

                                <Border
                                    x:Name="PART_Overlay"
                                    Background="{TemplateBinding OverlayBackground}"
                                    CornerRadius="{TemplateBinding OverlayCornerRadius}"
                                    Opacity="0"
                                    Validation.ErrorTemplate="{x:Null}" />

                                <Border
                                    x:Name="PART_DetailBorder"
                                    Width="{TemplateBinding DetailWidth}"
                                    MinWidth="{TemplateBinding DetailMinWidth}"
                                    MinHeight="{TemplateBinding DetailMinHeight}"
                                    MaxWidth="{TemplateBinding DetailMaxWidth}"
                                    MaxHeight="{TemplateBinding DetailMaxHeight}"
                                    Margin="{TemplateBinding DetailMargin}"
                                    HorizontalAlignment="{TemplateBinding DetailHorizontalAlignment}"
                                    VerticalAlignment="Top"
                                    navigation:XNavigationLock.DisableWhenNavigationLocked="False"
                                    Background="{TemplateBinding DetailBackground}"
                                    BorderBrush="{TemplateBinding DetailBorderBrush}"
                                    BorderThickness="{TemplateBinding DetailBorderThickness}"
                                    CornerRadius="{TemplateBinding DetailCornerRadius}"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    Validation.ErrorTemplate="{x:Null}">

                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                            <TranslateTransform Y="-18" />
                                        </TransformGroup>
                                    </Border.RenderTransform>

                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="18"
                                            Direction="270"
                                            Opacity="0.18"
                                            ShadowDepth="4" />
                                    </Border.Effect>

                                    <Grid Validation.ErrorTemplate="{x:Null}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            x:Name="PART_DetailHeaderRoot"
                                            Grid.Row="0"
                                            MinHeight="46"
                                            BorderBrush="{TemplateBinding DetailBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Validation.ErrorTemplate="{x:Null}">

                                            <Grid Validation.ErrorTemplate="{x:Null}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter
                                                    x:Name="PART_DetailHeaderPresenter"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding DetailHeaderPadding}"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding DetailHeader}"
                                                    ContentTemplate="{TemplateBinding DetailHeaderTemplate}"
                                                    RecognizesAccessKey="True"
                                                    TextElement.FontSize="15"
                                                    TextElement.FontWeight="SemiBold"
                                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                                                <controls:XValidationHintPopup
                                                    x:Name="PART_ValidationHint"
                                                    Grid.Column="1"
                                                    Margin="0,8,8,8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Header="Validation"
                                                    Source="{Binding EffectiveValidationSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Validation.ErrorTemplate="{x:Null}"
                                                    Visibility="Collapsed" />

                                                <controls:XButton
                                                    x:Name="PART_CloseButton"
                                                    Grid.Column="2"
                                                    Width="30"
                                                    Height="30"
                                                    MinWidth="30"
                                                    Margin="0,8,18,8"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Appearance="Ghost"
                                                    CornerRadius="3"
                                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                                    Icon="{via:MaterialIcon Kind=Close}"
                                                    IconSize="14"
                                                    ToolTip="Close"
                                                    Variant="Default"
                                                    Visibility="Collapsed" />
                                            </Grid>
                                        </Border>

                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">

                                            <ContentPresenter
                                                x:Name="PART_DetailContentPresenter"
                                                Margin="{TemplateBinding DetailPadding}"
                                                Content="{TemplateBinding DetailHost}"
                                                ContentTemplate="{TemplateBinding DetailHostTemplate}"
                                                RecognizesAccessKey="True"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </ScrollViewer>

                                        <Grid Grid.Row="2">
                                            <Border
                                                x:Name="PART_DetailFooterRoot"
                                                Padding="{TemplateBinding DetailFooterPadding}"
                                                BorderBrush="{TemplateBinding DetailBorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Visibility="Collapsed">

                                                <ContentPresenter
                                                    x:Name="PART_DetailFooterPresenter"
                                                    Content="{TemplateBinding DetailFooter}"
                                                    ContentTemplate="{TemplateBinding DetailFooterTemplate}"
                                                    RecognizesAccessKey="True"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                            </Border>

                                            <Border
                                                x:Name="PART_DefaultDetailFooterRoot"
                                                Padding="{TemplateBinding DetailFooterPadding}"
                                                BorderBrush="{TemplateBinding DetailBorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Visibility="Collapsed">

                                                <controls:XStackPanel
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <controls:XButton
                                                        x:Name="PART_CancelDetailButton"
                                                        MinWidth="96"
                                                        Content="{TemplateBinding CancelDetailText}" />
                                                    <controls:XButton
                                                        x:Name="PART_PrimaryDetailButton"
                                                        MinWidth="96"
                                                        Command="{Binding PrimaryDetailCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                        CommandParameter="{Binding PrimaryDetailCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Content="{TemplateBinding PrimaryDetailText}"
                                                        Variant="Primary" />
                                                </controls:XStackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ViewMode" Value="{x:Static navigation:XContentViewMode.Tree}" />
                                <Condition Property="HasTreeHost" Value="True" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="PART_ListHostPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TreeHostPresenter" Property="Visibility" Value="Visible" />
                        </MultiTrigger>


                        <Trigger Property="DetailPlacement" Value="{x:Static controls:XViewFlyoutPlacement.Top}">
                            <Setter TargetName="PART_DetailBorder" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <Trigger Property="DetailPlacement" Value="{x:Static controls:XViewFlyoutPlacement.Center}">
                            <Setter TargetName="PART_DetailBorder" Property="VerticalAlignment" Value="Center" />
                        </Trigger>

                        <Trigger Property="DetailPlacement" Value="{x:Static controls:XViewFlyoutPlacement.Bottom}">
                            <Setter TargetName="PART_DetailBorder" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>

                        <Trigger Property="DetailPresentation" Value="{x:Static controls:XViewDetailPresentation.Dialog}">
                            <Setter TargetName="PART_DetailBorder" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_DetailBorder" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_DetailBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>

                        <Trigger Property="DetailPresentation" Value="{x:Static controls:XViewDetailPresentation.Flyout}">
                            <Setter TargetName="PART_DetailBorder" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_DetailBorder" Property="MinWidth" Value="0" />
                            <Setter TargetName="PART_DetailBorder" Property="RenderTransformOrigin" Value="0.5,0" />
                        </Trigger>

                        <Trigger Property="IsDetailHostedByWindow" Value="True">
                            <Setter TargetName="PART_DetailHeaderPresenter" Property="Content" Value="{x:Null}" />
                            <Setter TargetName="PART_DetailContentPresenter" Property="Content" Value="{x:Null}" />
                            <Setter TargetName="PART_DetailFooterPresenter" Property="Content" Value="{x:Null}" />
                        </Trigger>

                        <Trigger Property="ShowDetailCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowValidationHint" Value="True">
                            <Setter TargetName="PART_ValidationHint" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="HasDetailFooter" Value="True">
                            <Setter TargetName="PART_DetailFooterRoot" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowDefaultDetailFooter" Value="True" />
                                <Condition Property="HasDetailFooter" Value="False" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="PART_DefaultDetailFooterRoot" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <Trigger Property="PrimaryDetailCommand" Value="{x:Null}">
                            <Setter TargetName="PART_PrimaryDetailButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasDetailHeader" Value="False" />
                                <Condition Property="ShowDetailCloseButton" Value="False" />
                                <Condition Property="ShowValidationHint" Value="False" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="PART_DetailHeaderRoot" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
