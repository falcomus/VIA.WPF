<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XHeaderBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TitleWidth" Value="Auto" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.CommandBarBackground}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XHeaderBar}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="BreadcrumbRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentPresenter
                                x:Name="BreadcrumbPresenter"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Breadcrumb}"
                                ContentTemplate="{TemplateBinding BreadcrumbTemplate}"
                                TextElement.FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TitleColumn" Width="{TemplateBinding TitleWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ActionsColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="TitleArea" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        x:Name="TitleIconPresenter"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding TitleIcon}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TitlePresenter"
                                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeHeading}}"
                                            FontWeight="SemiBold"
                                            Foreground="{TemplateBinding Foreground}"
                                            Text="{TemplateBinding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="SubtitlePresenter"
                                            Margin="0,2,0,0"
                                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                            Text="{TemplateBinding Subtitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <ContentPresenter
                                    x:Name="ContextPresenter"
                                    Grid.Column="1"
                                    Margin="0"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                                <controls:XStackPanel
                                    x:Name="ActionsArea"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="5">
                                    <ContentPresenter
                                        x:Name="ActionsPresenter"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Actions}"
                                        ContentTemplate="{TemplateBinding ActionsTemplate}" />
                                    <controls:XMoreButton
                                        x:Name="MoreButton"
                                        Menu="{Binding MoreMenu, RelativeSource={RelativeSource TemplatedParent}}" />
                                </controls:XStackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Breadcrumb" Value="{x:Null}">
                            <Setter TargetName="BreadcrumbPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BreadcrumbRow" Property="Height" Value="0" />
                        </Trigger>
                        <Trigger Property="TitleIcon" Value="{x:Null}">
                            <Setter TargetName="TitleIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitlePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SubtitlePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="ActionsPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="MoreMenu" Value="{x:Null}">
                            <Setter TargetName="MoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Actions" Value="{x:Null}" />
                                <Condition Property="MoreMenu" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ActionsArea" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActionsColumn" Property="Width" Value="0" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="" />
                                <Condition Property="Subtitle" Value="" />
                                <Condition Property="TitleIcon" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TitleArea" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleColumn" Property="Width" Value="0" />
                            <Setter TargetName="ContextPresenter" Property="Margin" Value="0" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XHeaderGroup}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.CommandBarForeground}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceVeryLight}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XHeaderGroup}">
                    <Border
                        x:Name="GroupBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="HeaderBand"
                                Height="{Binding HeaderHeight, RelativeSource={RelativeSource AncestorType={x:Type controls:XHeaderBar}}}"
                                Padding="8,0"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.CommandBarGroupHeaderBackground}}">
                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                    TextElement.FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                    TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.PrimaryText}}" />
                            </Border>

                            <Border
                                x:Name="ContentBand"
                                Grid.Row="1"
                                MinHeight="{Binding ContentHeight, RelativeSource={RelativeSource AncestorType={x:Type controls:XHeaderBar}}}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderBand" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderBand" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsSeparatorVisible" Value="False">
                            <Setter TargetName="GroupBorder" Property="BorderThickness" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compatibility style: visually follows XHeaderGroup while legacy properties remain available. -->
    <Style TargetType="{x:Type controls:XHeaderBarGroup}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="{DynamicResource {x:Static themes:XLayoutKeys.CommandBarItemHeight}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.CommandBarForeground}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="ContentPadding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XHeaderBarGroup}">
                    <Border
                        Padding="{TemplateBinding ContentPadding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LegacyHeaderColumn" Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="LegacyHeaderPresenter"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Header}"
                                TextElement.FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                            <ContentPresenter
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="LegacyHeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LegacyHeaderColumn" Property="Width" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
