<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/Converters.xaml" />
        <ResourceDictionary Source="/VIA.WPF.Controls;component/Themes/XInputShared.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <Style TargetType="{x:Type controls:XLookupComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InputBackground}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="ShowResetButton" Value="False" />
        <Setter Property="ResetIconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
        <Setter Property="ResetButtonForeground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XLookupComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="HeaderPresenter"
                            Margin="0,0,0,6"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            FontSize="{TemplateBinding HeaderFontSize}"
                            FontWeight="{TemplateBinding HeaderFontWeight}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />

                        <Grid Grid.Row="1">
                            <controls:XComboBox
                                x:Name="PART_ComboBox"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsDropDownOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                IsEditable="{TemplateBinding IsEditable}"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding LookupEntriesView, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxDropDownHeight="{TemplateBinding MaxDropDownHeight}"
                                Size="{TemplateBinding Size}"
                                Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                <controls:XComboBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                                                    <Border
                                                        x:Name="ItemBorder"
                                                        Margin="4,1"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent"
                                                        CornerRadius="3"
                                                        SnapsToDevicePixels="True">
                                                        <ContentPresenter
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            RecognizesAccessKey="True"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                                                        </Trigger>

                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                                                        </Trigger>

                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </Trigger>

                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                                                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.62" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:XComboBox.ItemContainerStyle>

                                <controls:XComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </controls:XComboBox.ItemTemplate>
                            </controls:XComboBox>

                            <Grid
                                x:Name="PlaceholderHost"
                                Height="{TemplateBinding MinHeight}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                ClipToBounds="True"
                                IsHitTestVisible="False"
                                UseLayoutRounding="True"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <ContentControl
                                    x:Name="PlaceholderIconPresenter"
                                    Width="{TemplateBinding IconSize}"
                                    Height="{TemplateBinding IconSize}"
                                    Margin="6,0,4,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="True"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{TemplateBinding IconTemplate}"
                                    Opacity="0.62" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="3,0,0,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStretch="{TemplateBinding FontStretch}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Opacity="0.56"
                                    Text="{TemplateBinding Placeholder}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid
                                x:Name="ResetButtonHost"
                                Height="{TemplateBinding MinHeight}"
                                Margin="0,0,24,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="1">
                                <Button
                                    x:Name="PART_ResetButton"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearSelectionCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Content="{Binding ResetIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                    ContentTemplate="{Binding ResetIconTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{Binding ResetButtonForeground, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource XInputResetButtonStyle}"
                                    controls:XInputAssist.IconSize="{Binding ResetIconSize, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="Clear"
                                    Visibility="{Binding ResetButtonVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Grid>

                        <ContentControl
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            Content="{TemplateBinding Description}"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Opacity="0.68" />

                        <TextBlock
                            x:Name="ValidationErrorPresenter"
                            Grid.Row="3"
                            MinHeight="16"
                            Margin="0,4,0,0"
                            FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            Text="{Binding (Validation.Errors), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstValidationErrorConverter}}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DescriptionPresenter" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="PlaceholderIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                                <Condition Binding="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlaceholderHost" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding SelectedText, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}" />
                                <Condition Binding="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PlaceholderHost" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                            <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                            <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                            <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                            <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
                        </Trigger>

                        <Trigger Property="Variant" Value="{x:Static controls:XLookupComboBoxVariant.Filled}">
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceSunken}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
                        </Trigger>

                        <Trigger Property="Variant" Value="{x:Static controls:XLookupComboBoxVariant.Outline}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="PART_ComboBox" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                            <Setter TargetName="PART_ComboBox" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ValidationErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="MultiLineValidationHints" Value="True">
                            <Setter TargetName="ValidationErrorPresenter" Property="MaxHeight" Value="34" />
                            <Setter TargetName="ValidationErrorPresenter" Property="TextWrapping" Value="Wrap" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="PART_ComboBox" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
