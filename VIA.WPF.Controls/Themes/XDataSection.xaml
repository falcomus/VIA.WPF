<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:conv="clr-namespace:VIA.WPF.Converters"
    xmlns:via="http://schemas.via.dev/wpf">

    <Style TargetType="{x:Type controls:XDataSection}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ShowTitle" Value="False" />
        <Setter Property="ShowNewButton" Value="True" />
        <Setter Property="NewButtonText" Value="New" />
        <Setter Property="HeaderOverlayMargin" Value="0,-35,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XDataSection}">
                    <Grid
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <ContentPresenter
                            MinHeight="0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <Grid
                            Margin="{TemplateBinding HeaderOverlayMargin}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:XStackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{Binding ShowTitle, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}">
                                <controls:XTextBlock
                                    Text="{TemplateBinding Title}"
                                    TextRole="SectionTitle" />

                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding HeaderContent}"
                                    ContentTemplate="{TemplateBinding HeaderContentTemplate}" />
                            </controls:XStackPanel>

                            <ContentPresenter
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding ToolbarContent}"
                                ContentTemplate="{TemplateBinding ToolbarContentTemplate}" />

                            <controls:XButton
                                Grid.Column="3"
                                Margin="0 -2 0 0"
                                VerticalAlignment="Center"
                                Command="{Binding NewCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                CommandParameter="{Binding NewCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                Content="{Binding NewButtonText, RelativeSource={RelativeSource TemplatedParent}}"
                                Icon="{via:MaterialIcon Kind=Plus}"
                                IconSize="12"
                                Variant="Primary"
                                Visibility="{Binding ShowNewButton, RelativeSource={RelativeSource TemplatedParent}, Converter={conv:BooleanToVisibility}}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
