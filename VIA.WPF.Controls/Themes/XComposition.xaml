<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XPage}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Canvas}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Padding" Value="{DynamicResource {x:Static themes:XLayoutKeys.PagePadding}}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XPage}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition x:Name="FooterRow" Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentPresenter
                                x:Name="HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" />

                            <ContentPresenter
                                Grid.Row="1"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                            <Border
                                x:Name="FooterBorder"
                                Grid.Row="2"
                                Padding="20,10"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                                BorderThickness="0,1,0,0">
                                <ContentPresenter
                                    Content="{TemplateBinding Footer}"
                                    ContentTemplate="{TemplateBinding FooterTemplate}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="0" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterBorder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FooterRow" Property="Height" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XContentStatePresenter}">
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XContentStatePresenter}">
                    <Grid>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <Grid x:Name="StateHost" Visibility="Collapsed">
                            <StackPanel
                                x:Name="LoadingPresenter"
                                MaxWidth="520"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ProgressBar
                                    Width="180"
                                    Height="3"
                                    Margin="0,0,0,12"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="Medium"
                                    Text="Loading…" />
                                <ContentPresenter
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding LoadingContent}"
                                    TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EmptyPresenter"
                                MaxWidth="520"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No content" />
                                <ContentPresenter
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding EmptyContent}"
                                    TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="ErrorPresenter"
                                MaxWidth="520"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                    Text="Content could not be loaded" />
                                <ContentPresenter
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding ErrorContent}"
                                    TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                                <controls:XButton
                                    x:Name="ErrorRetryButton"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Appearance="Outline"
                                    Command="{TemplateBinding RetryCommand}"
                                    CommandParameter="{TemplateBinding RetryCommandParameter}"
                                    Content="{TemplateBinding RetryText}"
                                    Size="Small"
                                    Variant="Primary" />
                            </StackPanel>

                            <StackPanel
                                x:Name="OfflinePresenter"
                                MaxWidth="520"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="Offline" />
                                <ContentPresenter
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding OfflineContent}"
                                    TextElement.Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
                                <controls:XButton
                                    x:Name="OfflineRetryButton"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Appearance="Outline"
                                    Command="{TemplateBinding RetryCommand}"
                                    CommandParameter="{TemplateBinding RetryCommandParameter}"
                                    Content="{TemplateBinding RetryText}"
                                    Size="Small"
                                    Variant="Primary" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="RetryCommand" Value="{x:Null}">
                            <Setter TargetName="ErrorRetryButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OfflineRetryButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:XContentState.Loading}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LoadingPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:XContentState.Empty}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EmptyPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:XContentState.Error}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ErrorPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="{x:Static controls:XContentState.Offline}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OfflinePresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XPropertyRow}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XPropertyRow}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LabelColumn" Width="{TemplateBinding LabelWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ActionsColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="LabelArea" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="Medium" Text="{TemplateBinding Label}" />
                                <TextBlock
                                    x:Name="DescriptionPresenter"
                                    Margin="0,2,0,0"
                                    FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                    Text="{TemplateBinding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ContentPresenter
                                x:Name="ValuePresenter"
                                Grid.Column="1"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <ContentPresenter
                                x:Name="ActionsPresenter"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Actions}"
                                ContentTemplate="{TemplateBinding ActionsTemplate}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="LabelArea" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LabelColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="ActionsPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActionsColumn" Property="Width" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XMetric}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XMetric}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MetricIconColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="MetricIconPresenter"
                                Width="18"
                                Height="18"
                                Margin="0,2,10,0"
                                VerticalAlignment="Top"
                                Content="{TemplateBinding Icon}" />

                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                    Text="{TemplateBinding Label}" />
                                <ContentPresenter
                                    x:Name="MetricValuePresenter"
                                    Margin="0,1,0,0"
                                    Content="{TemplateBinding Value}"
                                    ContentTemplate="{TemplateBinding ValueTemplate}"
                                    TextElement.FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeLargeHeading}}"
                                    TextElement.FontWeight="SemiBold"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock
                                    x:Name="MetricSupportingText"
                                    Margin="0,2,0,0"
                                    FontSize="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}"
                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                    Text="{TemplateBinding SupportingText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="MetricIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MetricIconColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="SupportingText" Value="">
                            <Setter TargetName="MetricSupportingText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Primary}">
                            <Setter TargetName="MetricValuePresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Success}">
                            <Setter TargetName="MetricValuePresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SuccessDark}}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Warning}">
                            <Setter TargetName="MetricValuePresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.WarningDark}}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Danger}">
                            <Setter TargetName="MetricValuePresenter" Property="TextElement.Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XInfoBar}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.InfoVeryLight}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.InfoLight}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XInfoBar}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="InfoIconColumn" Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="InfoContentColumn" Width="Auto" />
                                <ColumnDefinition x:Name="CloseColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="InfoIconPresenter"
                                Width="18"
                                Height="18"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Content="{TemplateBinding Icon}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="InfoTitlePresenter" FontWeight="SemiBold" Text="{TemplateBinding Title}" />
                                <TextBlock
                                    x:Name="InfoMessagePresenter"
                                    Margin="0,2,0,0"
                                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                                    Text="{TemplateBinding Message}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ContentPresenter
                                x:Name="InfoContentPresenter"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <controls:XButton
                                x:Name="CloseButton"
                                Grid.Column="3"
                                Width="26"
                                Margin="8,0,0,0"
                                Appearance="Ghost"
                                Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Content="×"
                                Size="Small"
                                ToolTip="Close" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="InfoIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InfoIconColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="InfoTitlePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="InfoMessagePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="InfoContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="InfoContentColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CloseColumn" Property="Width" Value="0" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Success}">
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SuccessVeryLight}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SuccessLight}}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Warning}">
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.WarningVeryLight}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.WarningLight}}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Danger}">
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DangerVeryLight}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DangerLight}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XBreadcrumb}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeCaption}}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XBreadcrumb}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XBreadcrumbItem}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XBreadcrumb}}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XBreadcrumbItem}">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ContentPresenter
                            x:Name="SeparatorPresenter"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Content="{Binding Separator, RelativeSource={RelativeSource AncestorType={x:Type controls:XBreadcrumb}}}"
                            Opacity="0.7" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter TargetName="SeparatorPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
