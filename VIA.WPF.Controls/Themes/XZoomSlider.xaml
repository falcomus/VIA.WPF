<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VIA.WPF.Controls" xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">
    <Style TargetType="{x:Type controls:XZoomSlider}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XZoomSlider}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <controls:XSlider Margin="0,0,8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" IsSnapToTickEnabled="{Binding IsSnapToTickEnabled, RelativeSource={RelativeSource TemplatedParent}}" LargeChange="10" Maximum="{Binding MaxZoomPercent, RelativeSource={RelativeSource TemplatedParent}}" Minimum="{Binding MinZoomPercent, RelativeSource={RelativeSource TemplatedParent}}" ShowValueHint="{Binding ShowValueHint, RelativeSource={RelativeSource TemplatedParent}}" SmallChange="1" TickFrequency="{Binding TickFrequency, RelativeSource={RelativeSource TemplatedParent}}" Value="{Binding ZoomPercent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Variant="Primary" />
                        <controls:XButton x:Name="PART_ResetButton" Grid.Column="1" MinWidth="52" Padding="8,2" Command="{x:Static controls:XZoomSlider.ResetZoomCommand}" Content="{Binding ZoomPercent, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}%}" Size="Small" ToolTip="Reset zoom" Variant="Default" />
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="ShowResetButton" Value="False"><Setter TargetName="PART_ResetButton" Property="Visibility" Value="Collapsed" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
