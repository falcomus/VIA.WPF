<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <controls:XProgressBarWidthConverter x:Key="XProgressBarWidthConverter" />

    <Style TargetType="{x:Type controls:XProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="TrackThickness" Value="8" />
        <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceSunken}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XProgressBar}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="HeaderRow"
                            Grid.Row="0"
                            Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="HeaderPresenter"
                                Grid.Column="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                                Opacity="0.90"
                                Text="{TemplateBinding Header}" />

                            <TextBlock
                                x:Name="ValuePresenter"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}"
                                Text="{TemplateBinding FormattedValue}" />
                        </Grid>

                        <Border
                            x:Name="TrackBorder"
                            Grid.Row="1"
                            Height="{TemplateBinding TrackThickness}"
                            Background="{TemplateBinding TrackBrush}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <Grid HorizontalAlignment="Left">
                                <Border
                                    x:Name="IndicatorBorder"
                                    Height="{TemplateBinding TrackThickness}"
                                    Background="{TemplateBinding ProgressBrush}"
                                    CornerRadius="4">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource XProgressBarWidthConverter}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding ElementName="TrackBorder" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="IndeterminateOverlay"
                            Grid.Row="1"
                            Height="{TemplateBinding TrackThickness}"
                            Background="Transparent"
                            ClipToBounds="True"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <Border
                                x:Name="IndeterminateIndicator"
                                Width="72"
                                Height="{TemplateBinding TrackThickness}"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding ProgressBrush}"
                                CornerRadius="4"
                                Opacity="0.90">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTranslateTransform" X="-72" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <TextBlock
                            x:Name="DescriptionPresenter"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Opacity="0.68"
                            Text="{TemplateBinding Description}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowValue" Value="False">
                            <Setter TargetName="ValuePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="" />
                                <Condition Property="ShowValue" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="TrackBorder" Property="Width" Value="8" />
                            <Setter TargetName="TrackBorder" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TrackBorder" Property="Opacity" Value="0.55" />
                            <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.55" />
                            <Setter TargetName="ValuePresenter" Property="Opacity" Value="0.55" />
                            <Setter TargetName="DescriptionPresenter" Property="Opacity" Value="0.55" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="TrackThickness" Value="6" />
                        </Trigger>

                        <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="TrackThickness" Value="12" />
                        </Trigger>

                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="IndeterminateOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IndicatorBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="IndeterminateOverlay">
                            <BeginStoryboard x:Name="IndeterminateStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="IndeterminateTranslateTransform"
                                        Storyboard.TargetProperty="X"
                                        From="-72"
                                        To="320"
                                        Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Default}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.ControlBorderStrong}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Primary}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Accent}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Success}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Warning}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Danger}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Info}">
                <Setter Property="ProgressBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Info}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
