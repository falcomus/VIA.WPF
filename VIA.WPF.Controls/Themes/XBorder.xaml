                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Info}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfoSubtleHover}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfoStrong}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfo}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Info}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfo}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Info}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusInfo}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
