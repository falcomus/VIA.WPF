                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusWarningStrong}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Danger  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Danger}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
