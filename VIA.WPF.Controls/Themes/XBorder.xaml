                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusDangerStrong}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StatusDanger}}" />
                        </MultiTrigger>

                        <MultiTrigger>
