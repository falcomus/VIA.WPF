                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentStrong}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.AccentSubtleHover}}" />
                        </MultiTrigger>

