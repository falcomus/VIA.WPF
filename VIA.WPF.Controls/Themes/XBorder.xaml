                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Accent  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
