<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <!--  xmlns:via="http://schemas.via.dev/wpf"  -->


    <Style TargetType="{x:Type controls:XBorder}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--
            Container appearances intentionally use a small effective subset:
            Solid, Outline, Subtle and Ghost. Link maps to Ghost.
            XBorder is the flexible primitive surface: colored variants tint the full body for
            Solid, Subtle and VerySubtle. Default keeps the normal Surface body.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XBorder}">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}">

                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type icons:XIcon}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XBorder}}}" />
                                    <Setter Property="Size" Value="16" />
                                </Style>
                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XBorder}}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.None}">
                            <Setter TargetName="RootBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Low}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Direction="270"
                                        Opacity="0.08"
                                        ShadowDepth="1"
                                        Color="#FF0F172A" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Medium}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="24"
                                        Direction="270"
                                        Opacity="0.11"
                                        ShadowDepth="2"
                                        Color="#FF0F172A" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.High}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="34"
                                        Direction="270"
                                        Opacity="0.14"
                                        ShadowDepth="4"
                                        Color="#FF0F172A" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--  Default  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Link is not a distinct container appearance; it maps to Ghost.  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </MultiTrigger>

                        <!--  Primary  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryForeground}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryStrong}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimarySubtle}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryStrong}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimarySubtleHover}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimarySubtleHover}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryStrong}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                                <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
