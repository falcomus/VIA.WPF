<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:localization="clr-namespace:VIA.WPF.Localization"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <DataTemplate x:Key="XLanguageSelectorItemTemplate" DataType="{x:Type localization:XLanguage}">
        <Grid MinHeight="15" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="18"
                Height="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
                BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}"
                BorderThickness="0.5"
                ClipToBounds="True"
                CornerRadius="1"
                SnapsToDevicePixels="True">

                <Grid>
                    <!--  Fallback for application-defined languages without a built-in vector flag.  -->
                    <Border x:Name="FallbackFlag" Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceSunken}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="6.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}"
                            Text="{Binding ShortName}" />
                    </Border>

                    <!--  Germany  -->
                    <Grid x:Name="GermanFlag" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FF000000" />
                        <Border Grid.Row="1" Background="#FFDD0000" />
                        <Border Grid.Row="2" Background="#FFFFCE00" />
                    </Grid>

                    <!--  United Kingdom  -->
                    <Viewbox
                        x:Name="UnitedKingdomFlag"
                        Stretch="Fill"
                        Visibility="Collapsed">
                        <Canvas
                            Width="60"
                            Height="36"
                            Background="#FF012169"
                            ClipToBounds="True">
                            <Line
                                Stroke="White"
                                StrokeThickness="9"
                                X1="0"
                                X2="60"
                                Y1="0"
                                Y2="36" />
                            <Line
                                Stroke="White"
                                StrokeThickness="9"
                                X1="60"
                                X2="0"
                                Y1="0"
                                Y2="36" />
                            <Line
                                Stroke="#FFC8102E"
                                StrokeThickness="4"
                                X1="0"
                                X2="60"
                                Y1="0"
                                Y2="36" />
                            <Line
                                Stroke="#FFC8102E"
                                StrokeThickness="4"
                                X1="60"
                                X2="0"
                                Y1="0"
                                Y2="36" />
                            <Rectangle
                                Canvas.Left="0"
                                Canvas.Top="13"
                                Width="60"
                                Height="10"
                                Fill="White" />
                            <Rectangle
                                Canvas.Left="25"
                                Canvas.Top="0"
                                Width="10"
                                Height="36"
                                Fill="White" />
                            <Rectangle
                                Canvas.Left="0"
                                Canvas.Top="15.5"
                                Width="60"
                                Height="5"
                                Fill="#FFC8102E" />
                            <Rectangle
                                Canvas.Left="27.5"
                                Canvas.Top="0"
                                Width="5"
                                Height="36"
                                Fill="#FFC8102E" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <TextBlock
                Grid.Column="1"
                Margin="3,-1.5,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XComboBox}}}"
                Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CultureName}" Value="de-DE">
                <Setter TargetName="FallbackFlag" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="GermanFlag" Property="Visibility" Value="Visible" />
            </DataTrigger>

            <DataTrigger Binding="{Binding CultureName}" Value="en-GB">
                <Setter TargetName="FallbackFlag" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="UnitedKingdomFlag" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


</ResourceDictionary>
