<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style x:Key="XTabHeaderActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextSecondary}}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StatePressed}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:XTabControl}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HeaderPadding" Value="10,5,10,5" />
        <Setter Property="HeaderHostPadding" Value="4,2,0,2" />
        <Setter Property="HeaderContentMargin" Value="4,0,0,-2" />
        <Setter Property="HeaderUnderlineMargin" Value="4,3,0,0" />
        <Setter Property="HeaderSpacing" Value="6" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ShowBorder" Value="True" />
        <Setter Property="ShowTabContent" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XTabControl}">
                    <Grid
                        MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        KeyboardNavigation.TabNavigation="Local"
                        SnapsToDevicePixels="True">

                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRowDefinition" Height="Auto" />
                            <RowDefinition x:Name="ContentRowDefinition" Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeaderColumnDefinition" Width="Auto" />
                            <ColumnDefinition x:Name="ContentColumnDefinition" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="HeaderHost"
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="{TemplateBinding HeaderHostPadding}"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceSunken}}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="0">
                            <Grid x:Name="HeaderLayoutGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TabPanel
                                    x:Name="HeaderPanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0"
                                    Background="Transparent"
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1" />

                                <Button
                                    x:Name="AddButton"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="5,3,5,0"
                                    Padding="0"
                                    Command="{TemplateBinding AddButtonCommand}"
                                    Style="{StaticResource XTabHeaderActionButtonStyle}"
                                    Visibility="Collapsed">
                                    <!--  Content="{TemplateBinding AddButtonContent}"  -->
                                    <ico:PackIconMaterial
                                        Width="11"
                                        Height="11"
                                        Kind="Plus" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="ContentBorder"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            MinHeight="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter
                                x:Name="PART_SelectedContentHost"
                                MinHeight="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowAddButton" Value="True">
                            <Setter TargetName="AddButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowBorder" Value="False">
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0" />
                        </Trigger>

                        <Trigger Property="ShowTabContent" Value="False">
                            <Setter TargetName="ContentBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderHost" Property="Grid.Row" Value="1" />
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.RowSpan" Value="1" />
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="HeaderHost" Property="Padding" Value="10,4,0,0" />
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1,0,1,1" />

                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.RowSpan" Value="1" />
                            <Setter TargetName="ContentBorder" Property="Grid.ColumnSpan" Value="2" />
                        </Trigger>

                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="HeaderRowDefinition" Property="Height" Value="*" />
                            <Setter TargetName="ContentRowDefinition" Property="Height" Value="0" />
                            <Setter TargetName="HeaderColumnDefinition" Property="Width" Value="Auto" />
                            <Setter TargetName="ContentColumnDefinition" Property="Width" Value="*" />

                            <Setter TargetName="HeaderHost" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="HeaderHost" Property="Padding" Value="0,10,4,0" />
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1,1,0,1" />

                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddButton" Property="Grid.Row" Value="1" />
                            <Setter TargetName="AddButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="AddButton" Property="Margin" Value="0,8,0,5" />

                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ContentBorder" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="ContentBorder" Property="Grid.ColumnSpan" Value="1" />
                        </Trigger>

                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="HeaderRowDefinition" Property="Height" Value="*" />
                            <Setter TargetName="ContentRowDefinition" Property="Height" Value="0" />
                            <Setter TargetName="HeaderColumnDefinition" Property="Width" Value="*" />
                            <Setter TargetName="ContentColumnDefinition" Property="Width" Value="Auto" />

                            <Setter TargetName="HeaderHost" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderHost" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HeaderHost" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="HeaderHost" Property="Grid.ColumnSpan" Value="1" />
                            <Setter TargetName="HeaderHost" Property="Padding" Value="4,10,0,0" />
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0,1,1,1" />

                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddButton" Property="Grid.Row" Value="1" />
                            <Setter TargetName="AddButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="AddButton" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="AddButton" Property="Margin" Value="0,8,0,5" />

                            <Setter TargetName="ContentBorder" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="ContentBorder" Property="Grid.ColumnSpan" Value="1" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="True" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="HeaderHost" Property="CornerRadius" Value="4,4,0,0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="1,0.5,1,1" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="False" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0,0,0,0.5" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="True" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Bottom" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1,0,1,1" />
                            <Setter TargetName="HeaderHost" Property="CornerRadius" Value="0,0,4,4" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="1,1,1,0.5" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="False" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Bottom" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0.5,0,0.5,0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="True" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="1,1,0,1" />
                            <Setter TargetName="HeaderHost" Property="CornerRadius" Value="4,0,0,4" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0.5,1,1,1" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="False" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0,0,0.5,0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="True" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0,1,1,1" />
                            <Setter TargetName="HeaderHost" Property="CornerRadius" Value="0,4,4,0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="1,1,0.5,1" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowBorder" Value="False" />
                                <Condition Property="HeaderAppearance" Value="{x:Static controls:XTabHeaderAppearance.Underlined}" />
                                <Condition Property="TabStripPlacement" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderHost" Property="BorderThickness" Value="0.5,0,0,0" />
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="0" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
