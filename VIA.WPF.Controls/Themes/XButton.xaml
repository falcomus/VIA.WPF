<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style x:Key="XButtonBaseStyle" TargetType="{x:Type controls:XButton}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontFamilyBody}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="LoadingContent" Value="Loading..." />
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XButton}">
                    <Grid
                        x:Name="TemplateRoot"
                        ClipToBounds="False"
                        SnapsToDevicePixels="True">

                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">

                            <Grid>
                                <Border
                                    x:Name="InteractionOverlay"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />


                                <Grid x:Name="PaddingHost" Margin="{TemplateBinding Padding}">
                                    <Grid
                                        x:Name="ContentGrid"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="LeftIconColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="ContentColumn" Width="Auto" />
                                            <ColumnDefinition x:Name="RightIconColumn" Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter
                                            x:Name="LeftIconPresenter"
                                            Grid.Column="0"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Icon}"
                                            ContentTemplate="{TemplateBinding IconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">

                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            x:Name="MainContentPresenter"
                                            Grid.Column="1"
                                            Margin="0"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            RecognizesAccessKey="True" />

                                        <ContentPresenter
                                            x:Name="RightIconPresenter"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Icon}"
                                            ContentTemplate="{TemplateBinding IconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">

                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Grid>

                                    <Grid x:Name="LoadingPresenter" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{TemplateBinding Foreground}"
                                            BorderThickness="2"
                                            CornerRadius="6"
                                            Opacity="0.55" />

                                        <ContentPresenter
                                            Grid.Column="1"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding LoadingContent}"
                                            ContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                            RecognizesAccessKey="True" />
                                    </Grid>
                                </Grid>

                            </Grid>
                        </Border>

                        <Border
                            x:Name="KeyboardFocusRing"
                            Margin="-2"
                            Background="Transparent"
                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}"
                            BorderThickness="2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}">
                            <Setter TargetName="LeftIconPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}">
                            <Setter TargetName="LeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightIconPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="StretchContent" Value="True">
                            <Setter TargetName="ContentGrid" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="MainContentPresenter" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="*" />
                        </Trigger>

                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="ContentGrid" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LoadingPresenter" Property="Visibility" Value="Visible" />
                            <Setter Property="IsEnabled" Value="False" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.14" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.55" />
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.None}">
                            <Setter TargetName="RootBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Low}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Direction="270"
                                        Opacity="0.16"
                                        ShadowDepth="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.Medium}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="14"
                                        Direction="270"
                                        Opacity="0.18"
                                        ShadowDepth="4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Elevation" Value="{x:Static controls:XElevation.High}">
                            <Setter TargetName="RootBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Direction="270"
                                        Opacity="0.20"
                                        ShadowDepth="7" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--
                            Icon-only mode:
                            Wenn kein Content gesetzt ist, wird das Icon ohne Abstand und ohne asymmetrisches Padding
                            exakt in der Buttonmitte angezeigt.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PaddingHost" Property="Margin" Value="0" />
                            <Setter TargetName="LeftIconPresenter" Property="Margin" Value="0" />
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PaddingHost" Property="Margin" Value="0" />
                            <Setter TargetName="RightIconPresenter" Property="Margin" Value="0" />
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PaddingHost" Property="Margin" Value="0" />
                            <Setter TargetName="LeftIconPresenter" Property="Margin" Value="0" />
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PaddingHost" Property="Margin" Value="0" />
                            <Setter TargetName="RightIconPresenter" Property="Margin" Value="0" />
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                        </MultiTrigger>

                        <!--
                            Wichtig: dieser Trigger muss ganz am Ende stehen,
                            damit bei Icon = null beide Presenter sicher collapsed bleiben.
                        -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="LeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource XButtonBaseStyle}" TargetType="{x:Type controls:XButton}">
        <Style.Triggers>
            <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                <Setter Property="Height" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                <Setter Property="Padding" Value="8,3,8,3" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
                <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
            </Trigger>

            <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                <Setter Property="Height" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                <Setter Property="Padding" Value="12,6,12,6" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
                <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
            </Trigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.ControlBorder}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.ControlBorderStrong}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceVeryLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.ControlBorder}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Default}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Solid}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryText}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Outline}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.VerySubtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryVeryLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryLight}}" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Subtle}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryLight}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.PrimaryDark}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Ghost}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Primary}" />
                    <Condition Property="Appearance" Value="{x:Static controls:XControlAppearance.Link}" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="{x:Static controls:XControlVariant.Accent}" />
