<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:converters="clr-namespace:VIA.WPF.Converters"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:via="http://schemas.via.dev/wpf">

    <Style x:Key="XTreeViewItemToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        Margin="0,2,0,0"
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                        <Path
                            x:Name="IndicatorPath"
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 2 1 L 8 5 L 2 9 Z"
                            Fill="{DynamicResource {x:Static themes:XBrushKeys.TextTertiary}}"
                            Stretch="Fill" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="IndicatorPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="5" CenterY="5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="IndicatorPath" Property="Fill" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type controls:XTreeView}" TargetType="{x:Type controls:XTreeView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="NodeCornerRadius" Value="3" />
        <Setter Property="NodePadding" Value="8,3,10,3" />
        <Setter Property="ItemSpacing" Value="2" />
        <Setter Property="Size" Value="{x:Static controls:XControlSize.Medium}" />
        <Setter Property="ShowNewButton" Value="False" />
        <Setter Property="ShowEditButton" Value="False" />
        <Setter Property="ShowDeleteButton" Value="False" />
        <Setter Property="ShowExpandAllButton" Value="True" />
        <Setter Property="ShowCollapseAllButton" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="DropTargetAdornerBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
        <Setter Property="DropTargetHighlightBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
        <Setter Property="DropTargetAdornerPen">
            <Setter.Value>
                <Pen
                    Brush="{DynamicResource {x:Static themes:XBrushKeys.Accent}}"
                    Thickness="0.75">
                    <Pen.DashStyle>
                        <DashStyle Dashes="3 2" Offset="0" />
                    </Pen.DashStyle>
                </Pen>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XTreeView}">

                    <Grid Background="{TemplateBinding Background}">

                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsPresenter />
                        </ScrollViewer>

                        <Canvas
                            x:Name="PART_DropTargetAdornerHost"
                            Panel.ZIndex="10"
                            ClipToBounds="False"
                            IsHitTestVisible="False" />

                        <controls:XStackPanel
                            x:Name="PART_ButtonsPanel"
                            Margin="0,0,5,5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="5">
                            <controls:XButton
                                Padding="10,4"
                                Command="{Binding NewItemCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                CommandParameter="{x:Null}"
                                Content="{TemplateBinding RootNewButtonText}"
                                Icon="{icons:MaterialIcon Kind=Plus}"
                                IconSize="11"
                                ToolTip="Add root item"
                                Visibility="{Binding ShowRootNewButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />
                            <controls:XButton
                                Padding="10,4"
                                Command="{Binding ExpandAllCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Icon="{icons:MaterialIcon Kind=ExpandAll}"
                                ToolTip="Expand all"
                                Visibility="{Binding ShowExpandAllButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />
                            <controls:XButton
                                Padding="10,4"
                                Command="{Binding CollapseAllCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Icon="{icons:MaterialIcon Kind=CollapseAll}"
                                ToolTip="Collapse all"
                                Visibility="{Binding ShowCollapseAllButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />
                        </controls:XStackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type controls:XTreeViewItem}" TargetType="{x:Type controls:XTreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XTreeViewItem}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="HeaderRowGrid"
                            Grid.Row="0"
                            HorizontalAlignment="Left">

                            <Border
                                x:Name="HeaderSelectionBorder"
                                MinHeight="28"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{Binding NodeCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type controls:XTreeView}}}"
                                SnapsToDevicePixels="True">

                                <Grid x:Name="HeaderContentGrid" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        x:Name="HeaderContentBorder"
                                        Grid.Column="0"
                                        Padding="{Binding NodePadding, RelativeSource={RelativeSource AncestorType={x:Type controls:XTreeView}}}"
                                        Background="Transparent"
                                        CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton
                                                x:Name="ExpanderToggleButton"
                                                Grid.Column="0"
                                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                Style="{StaticResource XTreeViewItemToggleButtonStyle}" />

                                            <ContentPresenter
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                ContentSource="Header"
                                                RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>

                                    <StackPanel
                                        x:Name="ActionButtonsPanel"
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">

                                        <controls:XIconButton
                                            x:Name="NewButton"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            MinHeight="20"
                                            Padding="0"
                                            Appearance="VerySubtle"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ResolvedNewCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="{Binding ResolvedNewCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                            Icon="{icons:FluentIcon Kind=AddSquare}"
                                            IconSize="17"
                                            Size="Small"
                                            ToolTip="New"
                                            Variant="Primary"
                                            Visibility="{Binding ResolvedShowNewButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />

                                        <controls:XIconButton
                                            x:Name="EditButton"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            MinHeight="20"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            Appearance="VerySubtle"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ResolvedEditCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="{Binding ResolvedEditCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                            Icon="{via:FluentIcon Kind=Open}"
                                            IconSize="17"
                                            Size="Small"
                                            ToolTip="Edit"
                                            Variant="Primary"
                                            Visibility="{Binding ResolvedShowEditButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />

                                        <controls:XIconButton
                                            x:Name="DeleteButton"
                                            Width="20"
                                            Height="20"
                                            MinWidth="20"
                                            MinHeight="20"
                                            Margin="0,0,0,0"
                                            Padding="0"
                                            Appearance="VerySubtle"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ResolvedDeleteCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="{Binding ResolvedDeleteCommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                            FontWeight="Bold"
                                            Icon="{icons:FluentIcon Kind=Delete}"
                                            IconSize="16"
                                            Size="Small"
                                            ToolTip="Delete"
                                            Variant="Danger"
                                            Visibility="{Binding ResolvedShowDeleteButton, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:BooleanToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  Hier kann das Padding des TreeItem Selection Border eingestellt werden  -->
                        <Grid
                            x:Name="ChildrenArea"
                            Grid.Row="1"
                            Margin="18,4,0,0"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Background="{DynamicResource {x:Static themes:XBrushKeys.GridLine}}"
                                Opacity="0.35" />

                            <ItemsPresenter Grid.Column="1" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="ExpanderToggleButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildrenArea" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger SourceName="HeaderSelectionBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSelectionBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
                            <Setter TargetName="HeaderContentBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="ActionButtonsPanel" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="HeaderSelectionBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="HeaderContentBorder" Property="Background" Value="Transparent" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderSelectionBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
                            <Setter TargetName="HeaderContentBorder" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ActionButtonsPanel" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <DataTrigger Binding="{Binding IsNodeDragInProgress, RelativeSource={RelativeSource AncestorType={x:Type controls:XTreeView}}}" Value="True">
                            <Setter TargetName="ActionButtonsPanel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ActionButtonsPanel" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="ExpanderToggleButton" Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledForeground}}" />
                            <Setter TargetName="HeaderContentBorder" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="HeaderSelectionBorder" Property="Opacity" Value="0.55" />
                            <Setter TargetName="ChildrenArea" Property="Opacity" Value="0.55" />
                        </Trigger>

                        <DataTrigger Binding="{Binding Size, RelativeSource={RelativeSource AncestorType={x:Type controls:XTreeView}}}" Value="{x:Static controls:XControlSize.Small}">
                            <Setter TargetName="HeaderSelectionBorder" Property="MinHeight" Value="24" />
                            <Setter TargetName="HeaderContentBorder" Property="Padding" Value="6,1,8,1" />
                            <Setter TargetName="ExpanderToggleButton" Property="Width" Value="14" />
                            <Setter TargetName="ExpanderToggleButton" Property="Height" Value="14" />
                            <Setter TargetName="NewButton" Property="Width" Value="18" />
                            <Setter TargetName="NewButton" Property="Height" Value="18" />
                            <Setter TargetName="NewButton" Property="MinWidth" Value="18" />
                            <Setter TargetName="NewButton" Property="MinHeight" Value="18" />
                            <Setter TargetName="EditButton" Property="Width" Value="18" />
                            <Setter TargetName="EditButton" Property="Height" Value="18" />
                            <Setter TargetName="EditButton" Property="MinWidth" Value="18" />
                            <Setter TargetName="EditButton" Property="MinHeight" Value="18" />
                            <Setter TargetName="DeleteButton" Property="Width" Value="18" />
                            <Setter TargetName="DeleteButton" Property="Height" Value="18" />
                            <Setter TargetName="DeleteButton" Property="MinWidth" Value="18" />
                            <Setter TargetName="DeleteButton" Property="MinHeight" Value="18" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Size, RelativeSource={RelativeSource AncestorType={x:Type controls:XTreeView}}}" Value="{x:Static controls:XControlSize.Large}">
                            <Setter TargetName="HeaderSelectionBorder" Property="MinHeight" Value="34" />
                            <Setter TargetName="HeaderContentBorder" Property="Padding" Value="12,5,14,5" />
                            <Setter TargetName="ExpanderToggleButton" Property="Width" Value="18" />
                            <Setter TargetName="ExpanderToggleButton" Property="Height" Value="18" />
                            <Setter TargetName="NewButton" Property="Width" Value="22" />
                            <Setter TargetName="NewButton" Property="Height" Value="22" />
                            <Setter TargetName="NewButton" Property="MinWidth" Value="22" />
                            <Setter TargetName="NewButton" Property="MinHeight" Value="22" />
                            <Setter TargetName="EditButton" Property="Width" Value="22" />
                            <Setter TargetName="EditButton" Property="Height" Value="22" />
                            <Setter TargetName="EditButton" Property="MinWidth" Value="22" />
                            <Setter TargetName="EditButton" Property="MinHeight" Value="22" />
                            <Setter TargetName="DeleteButton" Property="Width" Value="22" />
                            <Setter TargetName="DeleteButton" Property="Height" Value="22" />
                            <Setter TargetName="DeleteButton" Property="MinWidth" Value="22" />
                            <Setter TargetName="DeleteButton" Property="MinHeight" Value="22" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
