<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:VIA.WPF.Controls" xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">
<Style TargetType="{x:Type controls:XColorSchemeView}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type controls:XColorSchemeView}"><Border Padding="12" Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" BorderThickness="1" CornerRadius="4"><UniformGrid Columns="2"><Border Margin="3" Padding="8" Background="{TemplateBinding PrimaryBrush}"><TextBlock Foreground="{Binding PrimaryBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BrushToContrastingBrushConverter}}" Text="Primary" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding AccentBrush}"><TextBlock Foreground="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BrushToContrastingBrushConverter}}" Text="Accent" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding InfoBrush}"><TextBlock Text="Info" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding SuccessBrush}"><TextBlock Text="Success" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding WarningBrush}"><TextBlock Text="Warning" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding DangerBrush}"><TextBlock Text="Danger" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding NeutralBrush}"><TextBlock Text="Neutral" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding TextBrush}"><TextBlock Text="Text" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding ControlBackgroundBrush}"><TextBlock Text="Control background" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding ControlBorderBrush}"><TextBlock Text="Control border" /></Border><Border Margin="3" Padding="8" Background="{TemplateBinding SchemeBorderBrush}"><TextBlock Text="Border" /></Border></UniformGrid></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
