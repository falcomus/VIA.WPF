<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:converters="clr-namespace:VIA.WPF.Converters"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XColorSchemeView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XColorSchemeView}">
                    <Border
                        Padding="12"
                        Background="{DynamicResource {x:Static themes:XBrushKeys.SurfaceRaised}}"
                        BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <UniformGrid Columns="2">
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding PrimaryBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding PrimaryBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Primary" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding AccentBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding AccentBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Accent" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding InfoBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding InfoBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Info" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding SuccessBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding SuccessBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Success" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding WarningBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding WarningBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Warning" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding DangerBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding DangerBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Danger" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding NeutralBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding NeutralBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Neutral" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding TextBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding TextBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Text" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding ControlBackgroundBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding ControlBackgroundBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Control background" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding ControlBorderBrush}" BorderBrush="{TemplateBinding SchemeBorderBrush}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding ControlBorderBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Control border" /></Border>
                            <Border Margin="3" Padding="10,7" Background="{TemplateBinding SchemeBorderBrush}" BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderStrong}}" BorderThickness="1" CornerRadius="3"><TextBlock FontWeight="SemiBold" Foreground="{Binding SchemeBorderBrush, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:BrushToContrastingBrushConverter.Instance}}" Text="Scheme border" /></Border>
                        </UniformGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
