<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style x:Key="XRadioGroupItemBaseStyle" TargetType="{x:Type controls:XRadioGroupItem}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XRadioGroupItem}">
                    <Border
                        x:Name="ItemChrome"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <controls:XRadioButton
                            x:Name="PART_RadioButton"
                            VerticalAlignment="Top"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Size="{Binding Size, RelativeSource={RelativeSource AncestorType={x:Type controls:XRadioGroup}}}"
                            Variant="{TemplateBinding Variant}">
                            <controls:XRadioButton.Content>
                                <StackPanel>
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                                    <controls:XTextBlock
                                        x:Name="DescriptionTextBlock"
                                        Margin="0,4,0,0"
                                        Text="{TemplateBinding Description}"
                                        TextRole="Caption"
                                        TextWrapping="Wrap"
                                        Visibility="Visible" />
                                </StackPanel>
                            </controls:XRadioButton.Content>
                        </controls:XRadioButton>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateHover}}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.StateSelected}}" />
                        </Trigger>

                        <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="DescriptionTextBlock" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="{x:Type controls:XRadioGroupItem}"
        BasedOn="{StaticResource XRadioGroupItemBaseStyle}"
        TargetType="{x:Type controls:XRadioGroupItem}" />

    <Style x:Key="{x:Type controls:XRadioGroup}" TargetType="{x:Type controls:XRadioGroup}">
        <Setter Property="ShowTitle" Value="True" />
        <Setter Property="ItemsPadding" Value="8" />
        <Setter Property="HeaderPadding" Value="14,7,7,7" />
        <Setter Property="ItemSpacing" Value="6" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Size" Value="Medium" />
        <Setter Property="Elevation" Value="None" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XRadioGroup}">
                    <controls:XGroup
                        x:Name="RootGroup"
                        Title="{TemplateBinding Title}"
                        ContentPadding="{TemplateBinding ItemsPadding}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        HeaderPadding="{TemplateBinding HeaderPadding}">
                        <controls:XStackPanel
                            x:Name="ItemsHostPanel"
                            IsItemsHost="True"
                            Orientation="Vertical"
                            Spacing="{TemplateBinding ItemSpacing}" />
                    </controls:XGroup>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowTitle" Value="False">
                            <Setter TargetName="RootGroup" Property="Title" Value="" />
                        </Trigger>

                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="RootGroup" Property="Title" Value="" />
                        </Trigger>

                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="ItemsHostPanel" Property="Orientation" Value="Horizontal" />
                        </Trigger>

                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="ItemsHostPanel" Property="Orientation" Value="Vertical" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
