<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XSeparator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XSeparator}">
                    <Grid Background="Transparent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border
                            x:Name="HorizontalLine"
                            Height="{TemplateBinding LineThickness}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="{TemplateBinding Background}" />

                        <Border
                            x:Name="VerticalLine"
                            Width="{TemplateBinding LineThickness}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="HorizontalLine" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VerticalLine" Property="Visibility" Value="Visible" />

                            <Setter Property="Width" Value="7" />
                            <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Trigger>

                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="HorizontalLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="VerticalLine" Property="Visibility" Value="Collapsed" />

                            <Setter Property="Width" Value="{x:Static sys:Double.NaN}" />
                            <Setter Property="Height" Value="7" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HorizontalLine" Property="Opacity" Value="0.45" />
                            <Setter TargetName="VerticalLine" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Default}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderSubtle}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Primary}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Primary}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Accent}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Accent}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Success}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Success}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Warning}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Danger}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Danger}}" />
            </Trigger>

            <Trigger Property="Variant" Value="{x:Static controls:XControlVariant.Info}">
                <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Info}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
