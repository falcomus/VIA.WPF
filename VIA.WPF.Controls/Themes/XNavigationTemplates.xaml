<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:navigation="clr-namespace:VIA.WPF.Controls.Navigation">

    <DataTemplate DataType="{x:Type navigation:XNavigationListSideContent}">
        <controls:XNavigationList
            BorderThickness="0"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
    </DataTemplate>

</ResourceDictionary>