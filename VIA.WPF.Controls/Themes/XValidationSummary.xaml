<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:mvvm="clr-namespace:VIA.WPF.MVVM;assembly=VIA.WPF.MVVM"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XValidationSummary}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Header" Value="Validation messages" />
        <Setter Property="IsCollapsible" Value="True" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="IncludeWarnings" Value="True" />
        <Setter Property="IncludeInformation" Value="False" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type mvvm:XValidationError}">
                    <controls:XGrid Margin="0,3" Columns="Auto,*" ColumnSpacing="8">
                        <controls:XBorder
                            x:Name="SeverityMarker"
                            Width="7"
                            Height="7"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            Elevation="None" />

                        <controls:XTextBlock
                            x:Name="MessageText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsMultiline="True"
                            Text="{Binding Message}"
                            TextRole="Body" />
                    </controls:XGrid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static mvvm:XValidationSeverity.Warning}">
                            <Setter TargetName="SeverityMarker" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Warning}}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static mvvm:XValidationSeverity.Information}">
                            <Setter TargetName="SeverityMarker" Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Info}}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XValidationSummary}">
                    <controls:XBorder
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource {x:Static themes:XBrushKeys.DangerVeryLight}}"
                        BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Elevation="Low"
                        Visibility="Collapsed">
                        <controls:XGrid Rows="Auto,Auto">
                            <ToggleButton
                                x:Name="HeaderToggleButton"
                                Grid.Row="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Content="{TemplateBinding Header}"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                            <controls:XTextBlock
                                x:Name="HeaderTextBlock"
                                Grid.Row="0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource {x:Static themes:XBrushKeys.Danger}}"
                                Text="{TemplateBinding Header}"
                                TextRole="SectionTitle"
                                Visibility="Collapsed" />

                            <ItemsPresenter
                                x:Name="ItemsPresenter"
                                Grid.Row="1"
                                Margin="0,7,0,0" />
                        </controls:XGrid>
                    </controls:XBorder>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasMessages" Value="True">
                            <Setter TargetName="RootBorder" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsCollapsible" Value="False">
                            <Setter TargetName="HeaderToggleButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderTextBlock" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ItemsPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
