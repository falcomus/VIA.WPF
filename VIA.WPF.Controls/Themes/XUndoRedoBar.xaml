<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style TargetType="{x:Type controls:XUndoRedoBar}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XUndoRedoBar}">
                    <StackPanel Orientation="Horizontal">
                        <controls:XButton
                            Height="32"
                            MinWidth="32"
                            Appearance="Solid"
                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}"
                            Command="{Binding UndoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand"
                            Icon="{icons:MaterialIcon Kind=Undo}"
                            IconSize="16"
                            Size="Medium"
                            ToolTip="{Binding UndoToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            Variant="Primary" />
                        <controls:XButton
                            Height="32"
                            MinWidth="32"
                            Margin="5,0,0,0"
                            Appearance="Solid"
                            BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}"
                            Command="{Binding RedoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand"
                            Icon="{icons:MaterialIcon Kind=Redo}"
                            IconSize="16"
                            Size="Medium"
                            ToolTip="{Binding RedoToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            Variant="Primary" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
