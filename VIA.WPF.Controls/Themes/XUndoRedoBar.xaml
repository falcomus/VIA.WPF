<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons">

    <Style TargetType="{x:Type controls:XUndoRedoBar}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XUndoRedoBar}">
                    <StackPanel Orientation="Horizontal">
                        <controls:XIconButton
                            Appearance="Ghost"
                            Command="{Binding UndoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand"
                            Icon="{icons:MaterialIcon Kind=Undo}"
                            IconSize="16"
                            Size="Medium"
                            ToolTip="{Binding UndoToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            Variant="Default" />
                        <controls:XIconButton
                            Margin="4,0,0,0"
                            Appearance="Ghost"
                            Command="{Binding RedoCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            Cursor="Hand"
                            Icon="{icons:MaterialIcon Kind=Redo}"
                            IconSize="16"
                            Size="Medium"
                            ToolTip="{Binding RedoToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                            Variant="Default" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
