<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VIA.WPF.Controls"
    xmlns:icons="clr-namespace:VIA.WPF.Icons;assembly=VIA.WPF.Icons"
    xmlns:pack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes">

    <Style x:Key="XToggleButtonBaseStyle" TargetType="{x:Type controls:XToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextPrimary}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.Surface}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.BorderDefault}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.MediumHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBody}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.MediumCornerRadius}" />
        <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.MediumIconSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UncheckedIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="CheckedIconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:XToggleButton}">
                    <Border
                        x:Name="RootBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True">

                        <Grid>
                            <Border
                                x:Name="InteractionOverlay"
                                Background="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True" />

                            <Grid
                                Margin="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <Grid
                                    x:Name="ContentGrid"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="LeftIconColumn" Width="Auto" />
                                        <ColumnDefinition x:Name="ContentColumn" Width="Auto" />
                                        <ColumnDefinition x:Name="RightIconColumn" Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        x:Name="LeftIconHost"
                                        Grid.Column="0"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter
                                            x:Name="UncheckedLeftIconPresenter"
                                            Content="{TemplateBinding UncheckedIcon}"
                                            ContentTemplate="{TemplateBinding UncheckedIconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            x:Name="CheckedLeftIconPresenter"
                                            Content="{TemplateBinding CheckedIcon}"
                                            ContentTemplate="{TemplateBinding CheckedIconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Grid>

                                    <ContentPresenter
                                        x:Name="MainContentPresenter"
                                        Grid.Column="1"
                                        Margin="5,0,5,1"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        RecognizesAccessKey="True" />

                                    <Grid
                                        x:Name="RightIconHost"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter
                                            x:Name="UncheckedRightIconPresenter"
                                            Content="{TemplateBinding UncheckedIcon}"
                                            ContentTemplate="{TemplateBinding UncheckedIconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <ContentPresenter
                                            x:Name="CheckedRightIconPresenter"
                                            Content="{TemplateBinding CheckedIcon}"
                                            ContentTemplate="{TemplateBinding CheckedIconTemplate}"
                                            RecognizesAccessKey="True"
                                            Visibility="Collapsed">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="{x:Type icons:XIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFluentIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialDesignIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XMaterialIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XBootstrapIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFontAwesomeIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XModernIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XPhosphorIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type icons:XFileIcon}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Size" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>

                                                <Style TargetType="{x:Type pack:PackIconMaterialDesign}">
                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Width" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                    <Setter Property="Height" Value="{Binding IconSize, RelativeSource={RelativeSource AncestorType={x:Type controls:XToggleButton}}}" />
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}">
                            <Setter TargetName="LeftIconColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="RightIconColumn" Property="Width" Value="0" />
                        </Trigger>

                        <Trigger Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}">
                            <Setter TargetName="LeftIconColumn" Property="Width" Value="0" />
                            <Setter TargetName="RightIconColumn" Property="Width" Value="Auto" />
                        </Trigger>

                        <Trigger Property="StretchContent" Value="True">
                            <Setter TargetName="ContentGrid" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="MainContentPresenter" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="*" />
                        </Trigger>

                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="LeftIconHost" Property="Margin" Value="0" />
                            <Setter TargetName="RightIconHost" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Content" Value="">
                            <Setter TargetName="MainContentPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="0" />
                            <Setter TargetName="LeftIconHost" Property="Margin" Value="0" />
                            <Setter TargetName="RightIconHost" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.08" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0.14" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.FocusRing}}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBackground}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:XBrushKeys.TextDisabled}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:XBrushKeys.DisabledBorder}}" />
                            <Setter TargetName="InteractionOverlay" Property="Opacity" Value="0" />
                        </Trigger>

                        <Trigger Property="UncheckedIcon" Value="{x:Null}">
                            <Setter TargetName="UncheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="UncheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="CheckedIcon" Value="{x:Null}">
                            <Setter TargetName="CheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="UncheckedLeftIconPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="UncheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="UncheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="UncheckedRightIconPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Left}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="UncheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedLeftIconPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="UncheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IconPlacement" Value="{x:Static controls:XIconPlacement.Right}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="UncheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedLeftIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="UncheckedRightIconPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckedRightIconPresenter" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource XToggleButtonBaseStyle}" TargetType="{x:Type controls:XToggleButton}">
        <Style.Triggers>
            <Trigger Property="Size" Value="{x:Static controls:XControlSize.Small}">
                <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.SmallHeight}" />
                <Setter Property="Padding" Value="8,2,8,2" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodySmall}}" />
                <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.SmallCornerRadius}" />
                <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.SmallIconSize}" />
            </Trigger>

            <Trigger Property="Size" Value="{x:Static controls:XControlSize.Large}">
                <Setter Property="MinHeight" Value="{x:Static controls:XControlSizeMetrics.LargeHeight}" />
                <Setter Property="Padding" Value="12,6,12,6" />
                <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:XTypographyKeys.FontSizeBodyLarge}}" />
                <Setter Property="CornerRadius" Value="{x:Static controls:XControlSizeMetrics.LargeCornerRadius}" />
                <Setter Property="IconSize" Value="{x:Static controls:XControlSizeMetrics.LargeIconSize}" />
            </Trigger>

            <MultiTrigger>
