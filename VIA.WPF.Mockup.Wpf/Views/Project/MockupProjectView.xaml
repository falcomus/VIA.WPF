<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:via="http://schemas.via.dev/wpf" xmlns:viewModels="clr-namespace:VIA.WPF.Mockup.Wpf.ViewModels" xmlns:controls="clr-namespace:VIA.WPF.Mockup.Wpf.Controls" x:Class="VIA.WPF.Mockup.Wpf.Views.Project.MockupProjectView" d:DataContext="{d:DesignInstance Type=viewModels:MockupProjectViewModel}" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VIA.WPF.Mockup.Wpf;component/Resources/MockupApplicationResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ScreenListItemTemplate" DataType="{x:Type viewModels:MockupScreenListItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="98" Height="64" Background="{StaticResource MockupPreview.Surface}" BorderBrush="{StaticResource MockupPreview.Border}" BorderThickness="1" CornerRadius="3">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{Binding AccentBrush}" CornerRadius="2,2,0,0"/>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource MockupPreview.SurfaceMuted}" CornerRadius="1"/>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <Border Height="7" Background="{StaticResource MockupPreview.Border}" CornerRadius="2"/>
                                    <Border Height="7" Margin="0,4,14,0" Background="{StaticResource MockupPreview.SurfaceMuted}" CornerRadius="2"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,0,2,0" Background="{StaticResource MockupPreview.Surface}" BorderBrush="{StaticResource MockupPreview.Border}" BorderThickness="1" CornerRadius="1"/>
                                        <Border Grid.Column="1" Margin="1,0" Background="{StaticResource MockupPreview.Surface}" BorderBrush="{StaticResource MockupPreview.Border}" BorderThickness="1" CornerRadius="1"/>
                                        <Border Grid.Column="2" Margin="2,0,0,0" Background="{StaticResource MockupPreview.Surface}" BorderBrush="{StaticResource MockupPreview.Border}" BorderThickness="1" CornerRadius="1"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,1,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="{Binding Name}"/>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Border Padding="6,2" Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryVeryLight}}" CornerRadius="3">
                                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}" Text="{Binding Target}"/>
                            </Border>
                            <Border Margin="4,0,0,0" Padding="6,2" Background="{DynamicResource {x:Static via:XBrushKeys.InfoVeryLight}}" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Info}}" Text="Main"/>
                            </Border>
                            <Border Margin="4,0,0,0" Padding="6,2" Background="{DynamicResource {x:Static via:XBrushKeys.WarningVeryLight}}" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Warning}}" Text="{Binding State}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="{Binding UpdatedText}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource {x:Static via:XBrushKeys.Background}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48*" MinWidth="680"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52*" MinWidth="650"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource {x:Static via:XBrushKeys.Background}}" SnapsToDevicePixels="True">
                    <Grid Height="52" Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MockupSectionHeaderTextStyle}" Text="Project Details"/>
                        <via:XStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <via:XButton Height="32" Appearance="Outline" Command="{Binding OpenProjectCommand}" Content="Open" Size="Large" VerticalAlignment="Center"/>
                            <via:XButton Height="32" Appearance="Solid" Command="{Binding SaveCommand}" Content="Save" Size="Large" Variant="Primary" VerticalAlignment="Center"/>
                            <via:XButton Height="32" Appearance="Outline" Command="{Binding SaveAsCommand}" Content="Save As…" Size="Large" VerticalAlignment="Center"/>
                            <via:XButton Height="32" Appearance="Outline" Command="{Binding RenameProjectCommand}" Content="Rename Project" Size="Large" VerticalAlignment="Center"/>
                            <via:XButton Height="32" Appearance="Subtle" Command="{Binding DeleteProjectCommand}" Content="Delete Project" Size="Large" Variant="Danger" VerticalAlignment="Center"/>
                        </via:XStackPanel>
                        <Border Grid.Column="2" Width="1" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
                        <via:XIconButton Grid.Column="3" Width="32" Height="32" Margin="8,0,0,0" Appearance="Ghost" Icon="{via:MaterialIcon Kind=DotsVertical}" IconSize="16" Size="Medium" ToolTip="Project details menu" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Height="1" Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
                <Grid Margin="14,10,14,0" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="122"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource MockupFieldLabelStyle}" Text="Project Name"/>
                    <via:XTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectName, Mode=TwoWay}" Size="Small"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Project Type / Target"/>
                    <via:XComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding ProjectTargets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" Size="Small"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource MockupFieldLabelStyle}" Text="Description"/>
                    <via:XTextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Height="42" AcceptsReturn="True" Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Size="Small"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource MockupFieldLabelStyle}" Text="Default Device"/>
                    <via:XComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding DevicePresets}" SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" Size="Small"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Author / Team"/>
                    <via:XTextBox Grid.Row="4" Grid.Column="4" Text="{Binding AuthorTeam, Mode=TwoWay}" Size="Small"/>
                    <TextBlock Grid.Row="6" Style="{StaticResource MockupFieldLabelStyle}" Text="Version"/>
                    <via:XTextBox Grid.Row="6" Grid.Column="1" Text="{Binding Version, Mode=TwoWay}" Size="Small"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Startup Screen"/>
                    <via:XComboBox Grid.Row="6" Grid.Column="4" DisplayMemberPath="Name" ItemsSource="{Binding Screens}" SelectedValue="{Binding StartupScreen, Mode=TwoWay}" SelectedValuePath="Name" Size="Small"/>
                    <TextBlock Grid.Row="8" Style="{StaticResource MockupFieldLabelStyle}" Text="Project File Path"/>
                    <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <via:XTextBox Text="{Binding ProjectPath, Mode=TwoWay}" Size="Small"/>
                        <via:XButton Grid.Column="1" Margin="8,0,0,0" Appearance="Outline" Content="Browse…" Size="Small"/>
                    </Grid>
                    <TextBlock Grid.Row="10" Style="{StaticResource MockupFieldLabelStyle}" Text="Notes / Remarks"/>
                    <via:XTextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="4" Height="42" AcceptsReturn="True" Text="{Binding Notes, Mode=TwoWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Size="Small"/>
                </Grid>
                <Border
                    Grid.Row="3"
                    Height="48"
                    Margin="14,8,14,8"
                    Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceLight}}"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="{DynamicResource {x:Static via:XBrushKeys.PrimaryVeryLight}}" CornerRadius="13">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Primary}}" Text="▣" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="6" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="Screens" />
                            </StackPanel>
                        </StackPanel>
                        <via:XSeparator Grid.Column="1" Margin="0,8" Orientation="Vertical" />
                        <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="{DynamicResource {x:Static via:XBrushKeys.AccentVeryLight}}" CornerRadius="13">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Accent}}" Text="T" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="3" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="Templates" />
                            </StackPanel>
                        </StackPanel>
                        <via:XSeparator Grid.Column="3" Margin="0,8" Orientation="Vertical" />
                        <StackPanel Grid.Column="4" Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="{DynamicResource {x:Static via:XBrushKeys.SuccessVeryLight}}" CornerRadius="13">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Success}}" Text="P" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="2" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="Popups" />
                            </StackPanel>
                        </StackPanel>
                        <via:XSeparator Grid.Column="5" Margin="0,8" Orientation="Vertical" />
                        <StackPanel Grid.Column="6" Margin="10,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="26" Height="26" Background="{DynamicResource {x:Static via:XBrushKeys.WarningVeryLight}}" CornerRadius="13">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource {x:Static via:XBrushKeys.Warning}}" Text="C" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="48" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="Controls" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <via:XSeparator Grid.Row="4" Orientation="Horizontal"/>
                <Grid Grid.Row="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Height="40" Margin="14,0" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MockupSectionHeaderTextStyle}" Text="Project Settings"/>
                        <via:XIconButton Grid.Column="1" Appearance="Ghost" Icon="{via:MaterialIcon Kind=DotsVertical}" IconSize="18" Size="Small" ToolTip="Project settings menu"/>
                    </Grid>
                    <Grid Margin="14,0,14,12" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource MockupFieldLabelStyle}" Text="Base Layout Mode"/>
                        <via:XComboBox Grid.Column="1" ItemsSource="{Binding LayoutModes}" SelectedItem="{Binding BaseLayoutMode, Mode=TwoWay}" Size="Small"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Save Behavior"/>
                        <via:XComboBox Grid.Column="4" ItemsSource="{Binding SaveBehaviors}" SelectedItem="{Binding SaveBehavior, Mode=TwoWay}" Size="Small"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource MockupFieldLabelStyle}" Text="Grid / Snap Spacing"/>
                        <via:XComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SnapSpacings}" SelectedItem="{Binding SnapSpacing, Mode=TwoWay}" Size="Small"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Export Target"/>
                        <via:XComboBox Grid.Row="2" Grid.Column="4" ItemsSource="{Binding ExportTargets}" SelectedItem="{Binding ExportTarget, Mode=TwoWay}" Size="Small"/>
                        <TextBlock Grid.Row="4" Style="{StaticResource MockupFieldLabelStyle}" Text="Autosave"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <via:XToggleSwitch Content="Enabled" IsChecked="{Binding IsAutosaveEnabled, Mode=TwoWay}" Variant="Primary"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource {x:Static via:XBrushKeys.ToolbarSecondaryForeground}}" Text="Every 5 minutes"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource MockupFieldLabelStyle}" Text="Naming Prefix"/>
                        <via:XTextBox Grid.Row="4" Grid.Column="4" Text="{Binding NamingPrefix, Mode=TwoWay}" Size="Small"/>
                        <TextBlock Grid.Row="6" Style="{StaticResource MockupFieldLabelStyle}" Text="Asset Folder"/>
                        <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <via:XTextBox Text="{Binding AssetFolder, Mode=TwoWay}" Size="Small"/>
                            <via:XButton Grid.Column="1" Margin="8,0,0,0" Appearance="Outline" Content="Browse…" Size="Small"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Column="1" Width="1" Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
            <Grid Grid.Column="2" Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <via:XHeaderBar
                    Grid.Row="0"
                    HeaderHeight="18"
                    ContentHeight="34"
                    Title="Screens"
                    TitleWidth="160">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <via:XHeaderBarGroup
                            Grid.Column="0"
                            Header="Zoom"
                            HeaderHeight="18"
                            ContentHeight="34"
                            ContentPadding="10,0">
                            <controls:XMockupZoomControl
                                Width="190"
                                Height="32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Zoom="{Binding Zoom, Mode=TwoWay}" />
                        </via:XHeaderBarGroup>

                        <via:XHeaderBarGroup
                            Grid.Column="1"
                            Header="Search"
                            HeaderHeight="18"
                            ContentHeight="34"
                            ContentPadding="10,0">
                            <via:XSearchBox
                                MinWidth="150"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                Placeholder="Search screens..."
                                Size="Large"
                                Text="{Binding ScreenSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center" />
                        </via:XHeaderBarGroup>

                        <via:XHeaderBarGroup
                            Grid.Column="2"
                            Header="Actions"
                            HeaderHeight="18"
                            ContentHeight="34"
                            ContentPadding="10,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <via:XButton
                                    Grid.Column="0"
                                    Width="92"
                                    Height="32"
                                    Appearance="Solid"
                                    Command="{Binding NewScreenCommand}"
                                    Content="New"
                                    Icon="{via:MaterialIcon Kind=Plus}"
                                    IconSize="16"
                                    Size="Large"
                                    Variant="Primary"
                                    VerticalAlignment="Center"/>
                                <via:XButton
                                    Grid.Column="2"
                                    Width="146"
                                    Height="32"
                                    Appearance="Outline"
                                    Command="{Binding OpenDesignerCommand}"
                                    Content="Open Designer"
                                    Icon="{via:MaterialIcon Kind=OpenInNew}"
                                    IconSize="16"
                                    Size="Large"
                                    Variant="Primary"
                                    VerticalAlignment="Center"/>
                                <Border
                                    Grid.Column="4"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
                                <via:XIconButton
                                    Grid.Column="6"
                                    Width="32"
                                    Height="32"
                                    Appearance="Ghost"
                                    Icon="{via:MaterialIcon Kind=DotsVertical}"
                                    IconSize="16"
                                    Size="Medium"
                                    ToolTip="Screens menu"
                                    VerticalAlignment="Center"/>
                            </Grid>
                        </via:XHeaderBarGroup>
                    </Grid>
                </via:XHeaderBar>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="1" Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Background="{DynamicResource {x:Static via:XBrushKeys.SurfaceVeryLight}}">
                            <ListBox Margin="10" ItemContainerStyle="{StaticResource MockupScreenListItemStyle}" ItemTemplate="{StaticResource ScreenListItemTemplate}" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" Style="{StaticResource MockupListBoxStyle}"/>
                        </Grid>
                        <Border Grid.Column="1" Width="1" Background="{DynamicResource {x:Static via:XBrushKeys.PanelBorder}}"/>
                        <Grid Grid.Column="2" Background="{DynamicResource {x:Static via:XBrushKeys.Surface}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Height="42" Margin="14,0" Grid.Row="0">
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static via:XBrushKeys.SurfaceText}}" Text="{Binding SelectedScreen.Name}"/>
                            </Grid>
                            <via:XSeparator Grid.Row="1" Orientation="Horizontal"/>
                            <Border
                                Grid.Row="2"
                                MinHeight="180"
                                Padding="24,18"
                                Background="{DynamicResource {x:Static via:XBrushKeys.Background}}">
                                <Viewbox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    StretchDirection="DownOnly">
                                    <Border
                                        Width="650"
                                        Height="380"
                                        Background="{StaticResource MockupPreview.Surface}"
                                        BorderBrush="{StaticResource MockupPreview.BorderStrong}"
                                        BorderThickness="1"
                                        Effect="{StaticResource MockupPreview.DeviceShadow}"
                                        TextElement.Foreground="{StaticResource MockupPreview.Text}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Background="{StaticResource MockupPreview.Primary}">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MockupPreview.PrimaryText}" Text="flink"/>
                                                    <Border Grid.Column="1" Width="230" Height="18" HorizontalAlignment="Center" Background="{StaticResource MockupPreview.Surface}" CornerRadius="3" Opacity="0.96">
                                                        <TextBlock Margin="8,0" VerticalAlignment="Center" FontSize="7" Foreground="{StaticResource MockupPreview.TextMuted}" Text="Search products..."/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MockupPreview.PrimaryText}" Text="♡   🛒   ●"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="118"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource MockupPreview.SurfaceSubtle}" BorderBrush="{StaticResource MockupPreview.Border}" BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="12,14">
                                                        <Border Padding="8,5" Background="{StaticResource MockupPreview.PrimarySubtle}" CornerRadius="3">
                                                            <TextBlock FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource MockupPreview.Primary}" Text="⌂  Home"/>
                                                        </Border>
                                                        <TextBlock Margin="8,11,0,0" FontSize="8" Foreground="{StaticResource MockupPreview.TextSecondary}" Text="▦  Categories"/>
                                                        <TextBlock Margin="8,11,0,0" FontSize="8" Foreground="{StaticResource MockupPreview.TextSecondary}" Text="%  Deals"/>
                                                        <TextBlock Margin="8,11,0,0" FontSize="8" Foreground="{StaticResource MockupPreview.TextSecondary}" Text="▣  Orders"/>
                                                        <TextBlock Margin="8,11,0,0" FontSize="8" Foreground="{StaticResource MockupPreview.TextSecondary}" Text="♡  Favorites"/>
