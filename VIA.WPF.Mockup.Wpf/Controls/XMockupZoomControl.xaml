<UserControl
    x:Class="VIA.WPF.Mockup.Wpf.Controls.XMockupZoomControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:VIA.WPF.Themes;assembly=VIA.WPF.Themes"
    xmlns:via="http://schemas.via.dev/wpf">

    <Border
        Height="32"
        VerticalAlignment="Center"
        Background="{DynamicResource {x:Static themes:XBrushKeys.Surface}}"
        BorderBrush="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}"
        BorderThickness="1"
        CornerRadius="3"
        SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>

            <Viewbox
                Grid.Column="0"
                Width="15"
                Height="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <via:XIcon Kind="Magnify" />
            </Viewbox>

            <Border Grid.Column="1" Background="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />

            <Button
                Grid.Column="2"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="OnDecreaseClick"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip="Zoom out">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}"
                    Text="−" />
            </Button>

            <Border Grid.Column="3" Background="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />

            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="6,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}"
                    Text="{Binding Zoom, ElementName=Root, StringFormat={}{0:0}%}" />
                <Viewbox
                    Grid.Column="1"
                    Width="11"
                    Height="11"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                    <via:XIcon Kind="ChevronDown" />
                </Viewbox>
            </Grid>

            <Border Grid.Column="5" Background="{DynamicResource {x:Static themes:XBrushKeys.PanelBorder}}" />

            <Button
                Grid.Column="6"
                Padding="0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="OnIncreaseClick"
                Cursor="Hand"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip="Zoom in">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static themes:XBrushKeys.SurfaceText}}"
                    Text="+" />
            </Button>
        </Grid>
    </Border>
</UserControl>
