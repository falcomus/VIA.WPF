<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fluent="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
    xmlns:icons="clr-namespace:VIA.WPF.Icons">

    <Style TargetType="{x:Type icons:XFluentIcon}">
        <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource Self}, Path=Size}" />
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=Size}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icons:XFluentIcon}">
                    <Viewbox
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Stretch="{TemplateBinding Stretch}">
                        <fluent:FluentIcon
                            Width="{TemplateBinding Size}"
                            Height="{TemplateBinding Size}"
                            FontSize="{TemplateBinding Size}"
                            Foreground="{TemplateBinding Foreground}"
                            Icon="{TemplateBinding Icon}"
                            IconSize="{TemplateBinding IconSize}"
                            IconVariant="{TemplateBinding IconVariant}" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>