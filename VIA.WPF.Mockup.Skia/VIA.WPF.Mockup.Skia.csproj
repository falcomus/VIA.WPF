<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>VIA.WPF.Mockup.Skia</PackageId>
    <Title>VIA.WPF Mockup Skia</Title>
    <Version>1.0.0</Version>
    <Authors>Claus Falkenstein</Authors>
    <Description>Skia-based rendering and interaction foundation for reusable VIA.WPF mockup designers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VIA.WPF.Mockup.Core\VIA.WPF.Mockup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Topten.RichTextKit" Version="0.4.167" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
